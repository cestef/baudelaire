site "{{site}}"
url "{{url}}"
author "{{author}}"
lang "en"

paths {
  content "content"
  dist "public"
  assets "assets"
  templates "templates"
}

content {
  collections {
    posts "posts/**/*.typ" sort="date" reverse=#true permalink="/posts/{slug}/" template="layout.typ"
  }

  taxonomies {
    tags listing=#true
  }
}

links {
  style "clean"
}

// Sweep orphaned files (deleted pages, renamed permalinks) from the output dir.
prune #true

// Generated files are opt-in, and these two need the `url` above.
generate {
  sitemap #true
  feed {
    formats "rss"
  }
}

html {
  pretty #true
  meta #true
}

serve {
  port 1821
  bind "127.0.0.1"
  open #true
  watch #true
}

profiles {
  dev {
    url "http://localhost:1821"
    content {
      future #true
    }
  }
  prod {
    html {
      pretty #false
    }
  }
}
