// Config defaults for the albatros theme. Every key here is a floor: state it
// in your own config.kdl and yours wins, nested blocks included.
//
// Lists are the exception, and the one thing to watch: declaring
// `content { collections { .. } }` yourself replaces this whole set rather than
// adding to it, so copy the block below if you only meant to add a collection.

content {
  collections {
    posts "posts/**/*.typ" {
      sort "date"
      reverse #true
      permalink "/posts/{slug}/"
      template "page.typ"
      paginate {
        template "list.typ"
        size 10
      }
    }
  }

  taxonomies {
    tags listing=#true template="list.typ"
  }
}

links {
  style "clean"
}

html {
  pretty #true
  meta #true
  // Slug every heading into an id, so a reader can deep-link a section.
  anchors #true

  // Each hex is a sentinel painted by `highlight/palette.tmTheme`, rewritten to
  // `class="sx-keyword"` and friends. Without this block the colours stay
  // inline and the sentinels reach the page as themselves, so the palette file
  // and this block belong together.
  highlight {
    comment "#e5d001"
    string  "#e5d002"
    number  "#e5d003"
    keyword "#e5d004"
    node    "#e5d005"
    prop    "#e5d006"
    type    "#e5d007"
    punct   "#e5d008"
  }
}

generate {
  sitemap #true
  feed {
    formats "rss" "atom"
    limit 20
  }
}
