// Config defaults for the spleen theme. Every key here is a floor: state it in
// your own config.kdl and yours wins, nested blocks included.
//
// Lists are the exception, and the one thing to watch: declaring
// `content { collections { .. } }` yourself replaces this whole set rather than
// adding to it, so copy the block below if you only meant to add a collection.

content {
  collections {
    // Pages directly under `content/` (the home page, an about page) land in
    // `_root`, and this is what gives them a layout without each naming one.
    // `home.typ` is the other choice here: bind it per page, in frontmatter.
    _root { template "page.typ" }

    posts "posts/**/*.typ" {
      sort "date"
      reverse #true
      permalink "/posts/{slug}/"
      template "page.typ"
      paginate {
        template "list.typ"
        size 20
      }
    }
  }

  taxonomies {
    tags listing=#true template="list.typ"
  }
}

links {
  style "clean"
}

html {
  pretty #true
  meta #true
  anchors #true

  // A code block's tokens reach the page as `class="sx-keyword"` and friends,
  // and `style.css` paints them. Without this the colours stay inline, where
  // the light/dark toggle cannot reach them.
  highlight
}

generate {
  sitemap #true
  robots { }
  feed {
    formats "rss" "atom"
    limit 20
  }
}
