// The site behind the documentation-theme preview (phares): a small manual, so
// the sidebar has a tree to draw and search has something to find.
//
// Built from the repository root by `just previews`, which appends the theme
// line this file deliberately lacks and overrides `dist` with `--out`. See
// `themes/demo/blog/config.kdl` for why the theme cannot live in a profile.
//
// Nothing below declares collections. The theme's `theme.kdl` supplies those,
// and a `content { collections }` here would replace that set wholesale.

site "baudelaire docs demo"
author "cstef"
lang "en"

paths {
  content "themes/demo/docs/content"
  dist "docs/public/themes/preview"
}

// Where this manual's pages live, for the theme's "Edit this page" link: it
// appends `page.source`, which is project-root-absolute, and this preview's
// project root is the repository. A `typst { inputs }` value rather than a
// config key of the theme's own invention: a site's constants belong to the
// site.
typst {
  inputs {
    edit "https://github.com/cestef/baudelaire/edit/main"
  }
}
