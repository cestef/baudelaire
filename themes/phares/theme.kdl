// Config defaults for the phares theme. Every key here is a floor: state it in
// your own config.kdl and yours wins, nested blocks included.
//
// Lists are the exception, and the one thing to watch: declaring
// `content { collections { .. } }` yourself replaces this whole set rather than
// adding to it, so copy the block below if you only meant to add a collection.

content {
  collections {
    // Pages directly under `content/` (the home page, an about page) keep
    // their own URLs and only need the layout.
    _root { template "page.typ" }

    // One collection over everything in a subdirectory, because a manual is one
    // document: prev/next then runs through every page in reading order rather
    // than stopping at a directory boundary. The default permalink is
    // `/{path}/{slug}/`, so `content/guide/install.typ` still publishes at
    // `/guide/install/` and the sidebar nests by directory as it always did.
    //
    // The glob starts at a directory on purpose. A root `index.typ` swept into
    // a named collection would be read as that directory's bundle index and
    // publish at `/content/`, so root pages are left where they are.
    //
    // Sorting is by `order`, and pages without one tie and fall back to source
    // path, which is already the order a directory reads in. Number the pages
    // that need to lead.
    docs "*/**/*.typ" {
      sort "order"
      template "page.typ"
    }
  }

  taxonomies {
    tags listing=#true template="list.typ"
  }
}

links {
  style "clean"
}

html {
  pretty #true
  meta #true
  // Slug every heading into an id: the on-page contents links them, and a
  // reader can deep-link a section.
  anchors #true

  // A code block's tokens reach the page as `class="sx-keyword"` and friends,
  // and `style.css` paints them. Without this the colours stay inline, where
  // the light/dark toggle cannot reach them.
  highlight
}

generate {
  sitemap #true
  robots { }

  // The palette this theme's header button opens. `ui` emits a self-mounting
  // client at `/search.js`; the theme only restyles its `.bd-*` classes.
  search {
    formats "json"
    fields "title" "body" "tags"
    ui #true
  }

  llms { }
}
