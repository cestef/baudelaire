// The core of a build: sources in, pages out, at the URLs the config asks for.

scenario "a page compiles to html under its permalink" {
  files {
    "config.kdl" #"""
      site "Test"
      paths {
        content "content"
        dist "public"
      }
      """#
    "content/posts/hello.typ" #"""
      #let frontmatter = (title: "Hello",)
      Hello, world!
      """#
  }
  expect {
    ok
    file "posts/hello/index.html" {
      contains "<!DOCTYPE html>"
      contains "Hello, world!"
    }
  }
}

scenario "every page in a collection is built" {
  files {
    "config.kdl" #"""
      site "Test"
      paths {
        content "content"
        dist "public"
      }
      """#
    "content/posts/p0.typ" #"""
      #let frontmatter = (title: "P0",)
      Page 0
      """#
    "content/posts/p1.typ" #"""
      #let frontmatter = (title: "P1",)
      Page 1
      """#
    "content/posts/p2.typ" #"""
      #let frontmatter = (title: "P2",)
      Page 2
      """#
    "content/posts/p3.typ" #"""
      #let frontmatter = (title: "P3",)
      Page 3
      """#
  }
  expect {
    ok
    file "posts/p0/index.html" { contains "Page 0" }
    file "posts/p1/index.html" { contains "Page 1" }
    file "posts/p2/index.html" { contains "Page 2" }
    file "posts/p3/index.html" { contains "Page 3" }
  }
}

scenario "flat urls produce html files rather than index directories" {
  files {
    "config.kdl" #"""
      site "Test"
      paths {
        content "content"
        dist "public"
      }
      links {
        style "flat"
      }
      """#
    "content/posts/hello.typ" #"""
      #let frontmatter = (title: "Hi",)
      body text
      """#
  }
  expect {
    ok
    file "posts/hello.html"
    absent "posts/hello/index.html"
  }
}

// A nested directory is part of the URL, because it is part of where the page
// is. These used to flatten onto `/posts/`, which lost the subdirectory and made
// two same-stem files in sibling directories an outright collision.
scenario "pages in a nested content directory keep that directory in their URL" {
  files {
    "config.kdl" #"""
      site "Test"
      paths {
        content "content"
        dist "public"
      }
      """#
    "content/posts/2024/jan.typ" #"""
      #let frontmatter = (title: "Jan",)
      January
      """#
    "content/posts/2025/jan.typ" #"""
      #let frontmatter = (title: "Jan again",)
      Next January
      """#
    "content/posts/flat.typ" #"""
      #let frontmatter = (title: "Flat",)
      Flat
      """#
  }
  expect {
    ok
    file "posts/2024/jan/index.html" { contains "January" }
    // The same stem one directory over is a different page, not a collision.
    file "posts/2025/jan/index.html" { contains "Next January" }
    // An unnested page is where it always was: `{path}` and `{collection}`
    // agree for the conventional layout.
    file "posts/flat/index.html" { contains "Flat" }
  }
}

// `{collection}` is still available for a site that wants the old flattening,
// and is what a glob-defined collection needs when its directory is named
// something else.
scenario "a collection can flatten its nesting back onto its own name" {
  files {
    "config.kdl" #"""
      site "Test"
      content {
        collections {
          posts { permalink "/{collection}/{slug}/" }
        }
      }
      """#
    "content/posts/2024/jan.typ" #"""
      #let frontmatter = (title: "Jan",)
      January
      """#
  }
  expect {
    ok
    file "posts/jan/index.html" { contains "January" }
    absent "posts/2024/jan/index.html"
  }
}

scenario "a collection permalink template moves the whole collection" {
  files {
    "config.kdl" #"""
      site "Test"
      paths {
        content "content"
        dist "public"
      }
      content {
        collections {
          posts { permalink "/blog/{slug}/" }
        }
      }
      """#
    "content/posts/hello.typ" #"""
      #let frontmatter = (title: "Hi",)
      body text
      """#
  }
  expect {
    ok
    file "blog/hello/index.html"
    absent "posts/hello/index.html"
  }
}

scenario "assets are copied into dist, nesting preserved" {
  files {
    "config.kdl" #"""
      site "Test"
      paths {
        content "content"
        dist "public"
        assets "assets"
      }
      """#
    "content/posts/p.typ" #"""
      #let frontmatter = (title: "P",)
      body text
      """#
    "assets/style.css" #"""
      body { color: red; }
      """#
    "assets/img/logo.png" #"""
      fake-png
      """#
  }
  expect {
    ok
    file "assets/style.css"
    file "assets/img/logo.png"
  }
}

scenario "a site with no content builds without error" {
  files {
    "config.kdl" #"""
      site "Test"
      paths {
        content "content"
        dist "public"
      }
      """#
  }
  expect {
    ok
  }
}

// A content path naming a directory that is not there used to build zero pages
// and report success. With `prune` on, the sweep then answered an empty
// keep-set the only way it could, by deleting the published site: `built 0
// pages`, exit 0, and an empty `dist`. A site that *named* a directory has made
// a claim about its own layout, so the walk is left to report the one it could
// not read.
scenario "a content path naming nothing is an error, not an empty site" {
  files {
    "config.kdl" #"""
      site "Test"
      paths { content "conten" }
      prune #true
      """#
    "content/a.typ" #"""
      = A
      """#
  }
  expect {
    fails { code "baudelaire::fs::read_directory" }
  }
}

// The other half of the same defence, for every way of finding no pages that is
// not a mistyped path: a build with an empty keep-set sweeps nothing, whatever
// `prune` says. "everything in `dist` is orphaned" is a conclusion no build that
// found nothing has earned.
scenario "a build that produces no pages sweeps nothing" {
  files {
    "config.kdl" #"""
      site "Test"
      prune #true
      """#
    "content/a.typ" #"""
      = A
      """#
  }
  build {
    expect {
      ok
      pages 1
      file "a/index.html"
    }
  }
  build {
    remove "content/a.typ"
    expect {
      ok
      pages 0
      // The previous build's page is still served rather than swept.
      file "a/index.html"
    }
  }
}

// `page.assets` is the files sitting beside a page bundle. A page is not one of
// them, whichever dialect it is written in: the extension test was spelled
// `typ`, so a bundle listed its own `index.md` and every sibling `.md` page as
// an asset, at URLs nothing publishes.
scenario "a bundle's assets list its files, never its sibling pages" {
  requires "markdown"
  files {
    "config.kdl" #"""
      site "Test"
      content {
        collections {
          posts { template "post.typ" }
        }
      }
      """#
    "templates/post.typ" #"""
      #let post(page, body) = html.elem("main", page.assets.keys().sorted().join(","))
      """#
    "content/posts/hello/index.md" #"""
      ;;;
      title "Hello"
      ;;;

      A bundle.
      """#
    "content/posts/hello/note.md" #"""
      ;;;
      title "Note"
      ;;;

      A neighbour, which is a page and not an asset.
      """#
    "content/posts/hello/notes.txt" #"""
      a real asset
      """#
  }
  expect {
    ok
    file "posts/hello/index.html" {
      contains "notes.txt"
      missing "note.md"
      missing "index.md"
    }
  }
}

// `page.reading` is measured on the markdown its author wrote, never on the
// typst that markdown lowers to: every line of that opens with `#`, which the
// estimate reads as code, so every markdown page shipped `0 min read`.
scenario "a markdown page's reading estimate counts its prose" {
  requires "markdown"
  files {
    "config.kdl" #"""
      site "Test"
      """#
    "templates/post.typ" #"""
      #let post(page, body) = html.elem("main", [words=#page.reading.words])
      """#
    "content/post.md" #"""
      ;;;
      title "Hello"
      template "post.typ"
      ;;;

      Three plain words, plus **one** more.

      ```rust
      let a = 1;
      let b = 2;
      ```
      """#
  }
  expect {
    ok
    // Six words of prose; the fence is machinery, and the frontmatter block is
    // not prose either.
    file "post/index.html" {
      contains "words=6"
    }
  }
}

// typst bakes highlight colours inline and offers no class option, so a themed
// site had to author sentinel hex values and win them back with
// `pre code [style*="e5d004"] { ... !important }`. The block moves the palette
// into the stylesheet, where a light/dark toggle can reach it.
scenario "highlight colours become classes a stylesheet can own" {
  files {
    "config.kdl" #"""
      site "T"
      html {
        highlight
      }
      """#
    "content/index.typ" #"""
      #let frontmatter = (title: "H",)

      ```rust
      fn main() { let x = 1; }
      ```

      """#
  }
  expect {
    ok
    file "index.html" {
      // A grammar's own scopes, in baudelaire's vocabulary...
      contains #"class="sx-keyword""#
      contains #"class="sx-function""#
      contains #"class="sx-number""#
      // ...no colour left inline...
      missing "style=\"color:"
      // ...and no mark left unnamed.
      missing "data-token"
      missing "data-scope"
    }
  }
}

// Every knob of the block, on one site: what a class is called, which tokens
// are worth markup at all, and whether the grammar's own scope rides along.
scenario "the highlight block names the classes and narrows the markup" {
  files {
    "config.kdl" #"""
      site "T"
      html {
        highlight {
          prefix "tok-"
          tokens "-punctuation" "-operator"
          classes {
            keyword "kw"
          }
          scopes #true
        }
      }
      """#
    "content/index.typ" #"""
      #let frontmatter = (title: "H",)

      ```rust
      fn main() { let x = 1; }
      ```

      """#
  }
  expect {
    ok
    file "index.html" {
      // The prefix and the rename, both...
      contains #"class="tok-kw""#
      contains #"class="tok-function""#
      // ...the scope stamp kept beside the class...
      contains #"data-scope="#
      // ...and a dropped token's text kept without its span.
      missing #"tok-punctuation"#
      missing #"tok-operator"#
      contains "{"
    }
  }
}

// Inline code carries no `<pre>`, so a pass keyed on the wrapper would leave
// every `#raw(.., lang: ..)` in a sentence marked and unnamed.
scenario "inline code is classed like a block" {
  files {
    "config.kdl" #"""
      site "T"
      html {
        highlight
      }
      """#
    "content/index.typ" #"""
      #let frontmatter = (title: "H",)

      A call to #raw("let", lang: "rust") in prose.

      """#
  }
  expect {
    ok
    file "index.html" {
      contains #"class="sx-keyword""#
      missing "data-token"
    }
  }
}

// A typst code block is highlighted by typst's own parser, which names its tags
// directly: same classes, no grammar and no scope round-trip in between.
scenario "typst code lands in the same classes a grammar does" {
  files {
    "config.kdl" #"""
      site "T"
      html {
        highlight
      }
      """#
    "content/index.typ" #"""
      #let frontmatter = (title: "H",)

      ````typ
      #let x = 1
      = Heading
      ````

      """#
  }
  expect {
    ok
    file "index.html" {
      contains #"class="sx-keyword""#
      contains #"class="sx-number""#
      contains #"class="sx-heading""#
    }
  }
}

scenario "without the block, highlighting is left exactly as typst emits it" {
  files {
    "config.kdl" #"""
      site "T"
      """#
    "content/index.typ" #"""
      #let frontmatter = (title: "H",)

      ```rust
      fn main() {}
      ```
      """#
  }
  expect {
    ok
    file "index.html" {
      contains #"<span style="color: #d73948">fn</span>"#
      missing "sx-"
    }
  }
}
