  }
}

scenario "a taxonomy naming a registry nobody declared fails the build" {
  files {
    "config.kdl" #"""
      site "T"
      paths { content "content"; dist "public" }
      content {
        taxonomies {
          authors { entities "people" }
        }
      }
      """#
    "content/posts/a.typ" #"""
      #let frontmatter = (title: "Alpha", slug: "a",)
      a
      """#
  }
  expect {
    fails { code "baudelaire::entity::no_registry" }
  }
}

scenario "a slot naming a field the registry does not declare fails at the config" {
  files {
    "config.kdl" #"""
      site "T"
      paths { content "content"; dist "public" }
      content {
        entities {
          people {
            fields { name "str" }
            slots image="protrait"
          }
        }
      }
      """#
    "content/posts/a.typ" #"""
      #let frontmatter = (title: "Alpha", slug: "a",)
      a
      """#
  }
  expect {
    fails { code "baudelaire::config::entity_slot" }
  }
}

scenario "profile pages are a registry's entities" {
  files {
    "config.kdl" #"""
      site "T"
      paths { content "content"; dist "public" }
      content {
        entities {
          people {
            shape "person"
            sources { pages "content/people" }
          }
        }
        taxonomies {
          authors { entities "people" }
        }
      }
      """#
    "content/people/zoe.typ" #"""
      #let frontmatter = (title: "Zoe", url: "https://zoe.example",)
      Writes things.
      """#
    "content/posts/a.typ" #"""
      #let frontmatter = (title: "Alpha", slug: "a", authors: ("zoe",),)
      a
      """#
  }
  expect {
    ok
    file "people/zoe/index.html" { contains "Writes things." }
  }
}

