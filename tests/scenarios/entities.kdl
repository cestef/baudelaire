}

scenario "a roster file declares entities the way the config block does" {
  files {
    "config.kdl" #"""
      site "T"
      paths { content "content"; dist "public" }
      content {
        entities {
          people {
            shape "person"
            sources { data "data/people.kdl" }
          }
        }
        taxonomies {
          authors { entities "people" }
        }
      }
      """#
    "data/people.kdl" #"""
      zoe {
        name "Zoe"
        url "https://zoe.example"
      }
      ada {
        name "Ada"
      }
      """#
    "content/posts/a.typ" #"""
      #let frontmatter = (title: "Alpha", slug: "a", authors: ("ada",),)
      a
      """#
  }
  expect {
    ok
  }
}

scenario "a later source fills what an earlier one left out" {
  files {
    "config.kdl" #"""
      site "T"
      paths { content "content"; dist "public" }
      content {
        entities {
          people {
            fields {
              name "str"
              email "str"
            }
            sources {
              pages "content/people"
              data "data/people.kdl"
            }
          }
        }
        taxonomies {
          authors { entities "people" }
        }
      }
      """#
    "data/people.kdl" #"""
      zoe {
        name "Not this one"
        email "zoe@example.com"
      }
      """#
    "content/people/zoe.typ" #"""
      #let frontmatter = (title: "Zoe",)
      Writes things.
      """#
    "content/posts/a.typ" #"""
      #let frontmatter = (title: "Alpha", slug: "a", authors: ("zoe",),)
      a
      """#
  }
  expect {
    ok
  }
}

scenario "the head names every credited author, and links the one with a page" {
  files {
    "config.kdl" #"""
      site "T"
      url "https://example.com"
      paths { content "content"; dist "public" }
      html { jsonld #true }
      content {
        entities {
          people {
            shape "person"
            sources {
              inline {
                zoe {
                  name "Zoe"
                  url "https://zoe.example"
                  socials "https://social.example/@zoe"
                }
                ada { name "Ada Lovelace" }
              }
            }
          }
        }
        taxonomies {
          authors { entities "people"; credit "author" }
          translators { entities "people"; credit "translator" }
        }
      }
      """#
    "content/posts/a.typ" #"""
      #let frontmatter = (
        title: "Alpha",
        slug: "a",
        date: "2026-01-01",
        authors: ("zoe", "ada"),
        translators: ("ada",),
      )
      a
      """#
  }
  expect {
    ok
    file "posts/a/index.html" {
      contains #"<meta name="author" content="Zoe">"#
      contains #"<meta name="author" content="Ada Lovelace">"#
      contains #"<link rel="author" href="https://zoe.example">"#
      // OpenGraph takes a profile URL where there is one, the name where
      // there is not.
      contains #"content="https://zoe.example""#
      contains #"property="article:author""#
      // Only the JSON island can say who translated it.
      contains "\"translator\":[{\"@type\":\"Person\",\"name\":\"Ada Lovelace\"}]"
      contains "\"sameAs\":[\"https://social.example/@zoe\"]"
    }
  }
}

scenario "a feed entry names the people its page credits" {
  files {
    "config.kdl" #"""
      site "T"
      url "https://example.com"
      author "The Site"
      paths { content "content"; dist "public" }
      generate { feed { formats "atom" } }
      content {
        entities {
          people {
            shape "person"
            sources {
              inline {
                zoe { name "Zoe"; url "https://zoe.example"; email "zoe@example.com" }
              }
            }
          }
        }
        taxonomies {
          authors { entities "people"; credit "author" }
        }
      }
      """#
    "content/posts/a.typ" #"""
      #let frontmatter = (title: "Alpha", slug: "a", date: "2026-01-01", authors: ("zoe",),)
      a
      """#
  }
  expect {
    ok
    file "atom.xml" {
      contains "<name>Zoe</name>"
      contains "<uri>https://zoe.example</uri>"
      contains "<email>zoe@example.com</email>"
      // ..and the feed still carries the site's own author, which is what
      // makes it valid Atom.
      contains "<name>The Site</name>"
    }
  }
}

scenario "a template reads the byline off the page" {
  files {
    "config.kdl" #"""
      site "T"
      paths { content "content"; dist "public" }
      content {
        collections { posts { template "post.typ" } }
        entities {
          people {
            shape "person"
            sources {
              inline {
                zoe { name "Zoe"; url "https://zoe.example"; pronouns "they/them" }
              }
            }
          }
        }
        taxonomies {
          authors { entities "people"; credit "author" }
        }
      }
      """#
    "templates/post.typ" #"""
      #let post(page, body) = html.elem("main", {
        for one in page.credits.at("author", default: ()) {
          html.elem("a", attrs: (href: one.url, class: "byline"), one.name)
          html.elem("span", one.fields.pronouns)
        }
        body
      })
      """#
    "content/posts/a.typ" #"""
      #let frontmatter = (title: "Alpha", slug: "a", authors: ("zoe",),)
      a
      """#
  }
  expect {
    ok
    file "posts/a/index.html" {
      contains #"class="byline""#
      contains "Zoe"
      contains "they/them"
    }
  }
}

scenario "a site with no registry keeps the byline it always had" {
  files {
    "config.kdl" #"""
      site "T"
      author "Camille"
      paths { content "content"; dist "public" }
      """#
    "content/posts/a.typ" #"""
      #let frontmatter = (title: "Alpha", slug: "a",)
      a
      """#
    "content/posts/b.typ" #"""
      #let frontmatter = (title: "Beta", slug: "b", author: "Zoe",)
      b
      """#
  }
  expect {
    ok
    file "posts/a/index.html" { contains #"<meta name="author" content="Camille">"# }
    // The page's own always wins over the site's floor.
    file "posts/b/index.html" {
      contains #"<meta name="author" content="Zoe">"#
      missing "Camille"
    }
  }
}

scenario "a described term is the profile page, which lists what credits it" {
  files {
    "config.kdl" #"""
      site "T"
      paths { content "content"; dist "public" }
      content {
        collections { people { template "profile.typ" } }
        entities {
          people {
            shape "person"
            sources { pages "content/people" }
          }
        }
        taxonomies {
          authors { entities "people"; credit "author"; describe #true; listing }
        }
      }
      """#
    "templates/profile.typ" #"""
      #let profile(page, body) = html.elem("main", {
        body
        for one in page.members {
          html.elem("a", attrs: (href: one.url, class: "wrote"), one.label)
        }
      })
      """#
    "content/people/zoe.typ" #"""
      #let frontmatter = (title: "Zoe",)
      Writes things.
      """#
    "content/posts/a.typ" #"""
      #let frontmatter = (title: "Alpha", slug: "a", authors: ("zoe",),)
      a
      """#
    "content/posts/b.typ" #"""
      #let frontmatter = (title: "Beta", slug: "b",)
      b
      """#
  }
  expect {
    ok
    // One page for one person: the profile keeps its own URL, and no listing
    // is generated beside it.
    file "people/zoe/index.html" {
      contains "Writes things."
      contains #"class="wrote""#
      contains "Alpha"
      missing "Beta"
    }
    // ..and the term index points at it rather than at a page that is not there.
    file "authors/index.html" { contains #"href="/people/zoe/""# }
  }
}

scenario "an undescribed term still gets its generated listing" {
  files {
    "config.kdl" #"""
      site "T"
      paths { content "content"; dist "public" }
      content {
        entities {
          people {
            shape "person"
            unknown "synthesize"
            sources { pages "content/people" }
          }
        }
        taxonomies {
          authors { entities "people"; credit "author"; describe #true; listing }
        }
      }
      """#
    "content/people/zoe.typ" #"""
      #let frontmatter = (title: "Zoe",)
      Writes things.
      """#
    "content/posts/a.typ" #"""
      #let frontmatter = (title: "Alpha", slug: "a", authors: ("zoe", "ada"),)
      a
      """#
  }
  expect {
    ok
    // `ada` is nobody's page, so the term is generated as any other term is.
    file "authors/ada/index.html" { contains "Alpha" }
    file "people/zoe/index.html"
  }
}

scenario "an alias groups onto the entity it names, not beside it" {
  files {
    "config.kdl" #"""
      site "T"
      paths { content "content"; dist "public" }
      content {
        entities {
          people {
            shape "person"
            sources {
              inline {
                zoe { name "Zoe"; alias "zq" }
              }
            }
          }
        }
        taxonomies {
          authors { entities "people"; credit "author"; listing }
        }
      }
      """#
    "content/posts/a.typ" #"""
      #let frontmatter = (title: "Alpha", slug: "a", authors: ("zoe",),)
      a
      """#
    "content/posts/b.typ" #"""
      #let frontmatter = (title: "Beta", slug: "b", authors: ("zq",),)
      b
      """#
  }
  expect {
    ok
    // One person, one term page, both posts on it.
    file "authors/zoe/index.html" {
      contains "Alpha"
      contains "Beta"
    }
    file "authors/index.html" { count #"href="/authors/zoe/"# 1 }
    absent "authors/zq/index.html"
  }
}

scenario "a profile has an edition per language, and each describes its own" {
  files {
    "config.kdl" #"""
      site "T"
      lang "en"
      languages { fr { name "Français" } }
      paths { content "content"; dist "public" }
      content {
        collections { people { template "profile.typ" } }
        entities {
          people {
            shape "person"
            sources { pages "content/people" }
          }
        }
        taxonomies {
          authors { entities "people"; credit "author"; describe #true; listing }
        }
      }
      """#
    "templates/profile.typ" #"""
      #let profile(page, body) = html.elem("main", {
        body
        for one in page.members { html.elem("a", attrs: (href: one.url), one.label) }
      })
      """#
    "content/people/zoe.typ" #"""
      #let frontmatter = (title: "Zoe",)
      Writes things.
      """#
    "content/people/zoe.fr.typ" #"""
      #let frontmatter = (title: "Zoé",)
      Écrit des choses.
      """#
    "content/posts/a.typ" #"""
      #let frontmatter = (title: "Alpha", slug: "a", authors: ("zoe",),)
      a
      """#
    "content/posts/a.fr.typ" #"""
      #let frontmatter = (title: "Alpha en français", slug: "a", authors: ("zoe",),)
      a
      """#
  }
  expect {
    ok
    // Each edition describes its own language's term and lists its own posts.
    file "people/zoe/index.html" {
      contains "Writes things."
      contains "Alpha"
      missing "Alpha en français"
    }
    file "fr/people/zoe/index.html" {
      contains "Écrit des choses."
      contains "Alpha en français"
    }
    // ..and the byline on each post is that language's name for one person.
    file "fr/posts/a/index.html" { contains #"<meta name="author" content="Zoé">"# }
    file "posts/a/index.html" { contains #"<meta name="author" content="Zoe">"# }
  }
}

scenario "a taxonomy key that only means something beside another is refused" {
  files {
    "config.kdl" #"""
      site "T"
      paths { content "content"; dist "public" }
      content {
        taxonomies {
          authors { credit "author" }
        }
      }
      """#
    "content/posts/a.typ" #"""
      #let frontmatter = (title: "Alpha", slug: "a",)
      a
      """#
  }
  expect {
    fails { code "baudelaire::config::taxonomy_requires" }
  }
}

scenario "a described profile lists its members in the taxonomy's own order" {
  files {
    "config.kdl" #"""
      site "T"
      paths { content "content"; dist "public" }
      content {
        collections { people { template "profile.typ" } }
        entities {
          people {
            shape "person"
            sources { pages "content/people" }
          }
        }
        taxonomies {
          authors { entities "people"; credit "author"; describe #true; sort "date"; reverse #true; listing }
        }
      }
      """#
    "templates/profile.typ" #"""
      #let profile(page, body) = html.elem("main", {
        for one in page.members { html.elem("p", one.label) }
      })
      """#
    "content/people/zoe.typ" #"""
      #let frontmatter = (title: "Zoe",)
      bio
      """#
    "content/posts/old.typ" #"""
      #let frontmatter = (title: "Older", slug: "old", date: "2020-01-01", authors: ("zoe",),)
      a
      """#
    "content/posts/new.typ" #"""
      #let frontmatter = (title: "Newer", slug: "new", date: "2026-01-01", authors: ("zoe",),)
      b
      """#
  }
  expect {
    ok
    file "people/zoe/index.html" { order "Newer" "Older" }
  }
}

scenario "editing the roster rebuilds the pages that credit whoever changed" {
  files {
    "config.kdl" #"""
      site "T"
      paths { content "content"; dist "public" }
      content {
        entities {
          people {
            shape "person"
            sources { data "data/people.kdl" }
          }
        }
        taxonomies {
          authors { entities "people"; credit "author" }
        }
      }
      """#
    "data/people.kdl" #"""
      zoe { name "Zoe" }
      ada { name "Ada" }
      """#
    "content/posts/a.typ" #"""
      #let frontmatter = (title: "Alpha", slug: "a", authors: ("zoe",),)
      a
      """#
    "content/posts/b.typ" #"""
      #let frontmatter = (title: "Beta", slug: "b", authors: ("ada",),)
      b
      """#
  }
  build { }
  build {
    files {
      "data/people.kdl" #"""
        zoe { name "Zoe Quill" }
        ada { name "Ada" }
        """#
    }
    expect {
      ok
      // Only zoe's page: a roster is not a file any page reads, so what keeps
      // this honest is the byline sitting in each page's own fingerprint.
      pages 2
      cached 1
      file "posts/a/index.html" { contains #"content="Zoe Quill""# }
    }
  }
}

scenario "a page with no template still rebuilds when its byline changes" {
  files {
    "config.kdl" #"""
      site "T"
      paths { content "content"; dist "public" }
      content {
        entities {
          people {
            shape "person"
            sources { data "data/people.kdl" }
          }
        }
        taxonomies {
          authors { entities "people"; credit "author" }
        }
      }
      """#
    "data/people.kdl" #"""
      zoe { name "Zoe" }
      """#
    "content/posts/a.typ" #"""
      #let frontmatter = (title: "Alpha", slug: "a", authors: ("zoe",),)
      a
      """#
  }
  build { }
  build {
    files {
      "data/people.kdl" #"""
        zoe { name "Zoe Quill" }
        """#
    }
    expect {
      ok
      cached 0
      // The head tags are written by the render pass, which a cache hit skips:
      // without the byline in the fingerprint this page kept the old name.
      file "posts/a/index.html" { contains #"content="Zoe Quill""# }
    }
  }
}
