// `check { }`: accessibility and structure rules over the typed DOM, and
// per-page weight budgets.
//
// Every rule is off until a `check { }` block asks for them, and a finding is a
// warning until `strict` says otherwise. A budget is the exception: an explicit
// limit always fails the build.

scenario "a page with no lint block is never linted" {
  files {
    "config.kdl" #"""
      site "T"
      paths {
        content "content"
        dist "public"
      }
      """#
    "content/a.typ" #"""
      #let frontmatter = (title: "A",)

      = One

      ==== Four

      #html.elem("img", attrs: (src: "/x.png"))
      """#
  }
  expect {
    ok
    file "a/index.html" {
      // typst-html reserves `h1` for the document title, so `=` is an `h2`.
      contains "<h5 "
    }
  }
}

scenario "a skipped heading level fails a strict build" {
  files {
    "config.kdl" #"""
      site "T"
      paths {
        content "content"
        dist "public"
      }
      check { strict }
      """#
    "content/a.typ" #"""
      #let frontmatter = (title: "A",)

      = One

      ==== Four
      """#
  }
  expect {
    fails { code "baudelaire::lint::found" }
  }
}

scenario "an outline that opens at `start` is not a skip" {
  files {
    "config.kdl" #"""
      site "T"
      paths {
        content "content"
        dist "public"
        templates "templates"
      }
      check {
        strict
        headings {
          start 3
        }
      }
      """#
    "templates/page.typ" #"""
      #let page(page, body) = html.elem("main", {
        html.elem("h1", page.frontmatter.title)
        body
      })
      """#
    "content/a.typ" #"""
      #let frontmatter = (title: "A", template: "page.typ",)

      == Opens at three

      === Four
      """#
  }
  expect {
    ok
  }
}

scenario "`start` excuses where a page opens and not a skip further down" {
  files {
    "config.kdl" #"""
      site "T"
      paths {
        content "content"
        dist "public"
        templates "templates"
      }
      check {
        strict
        headings {
          start 4
        }
      }
      """#
    "templates/page.typ" #"""
      #let page(page, body) = html.elem("main", {
        html.elem("h1", page.frontmatter.title)
        body
      })
      """#
    "content/a.typ" #"""
      #let frontmatter = (title: "A", template: "page.typ",)

      = Two

      === Four
      """#
  }
  expect {
    fails { code "baudelaire::lint::found" }
  }
}

scenario "`start` excuses the opening level and nothing deeper" {
  files {
    "config.kdl" #"""
      site "T"
      paths {
        content "content"
        dist "public"
        templates "templates"
      }
      check {
        strict
        headings {
          start 3
        }
      }
      """#
    "templates/page.typ" #"""
      #let page(page, body) = html.elem("main", {
        html.elem("h1", page.frontmatter.title)
        body
      })
      """#
    "content/a.typ" #"""
      #let frontmatter = (title: "A", template: "page.typ",)

      == Opens at three

      ==== Five
      """#
  }
  expect {
    fails { code "baudelaire::lint::found" }
  }
}

scenario "a heading that steps down one level at a time is fine" {
  files {
    "config.kdl" #"""
      site "T"
      paths {
        content "content"
        dist "public"
      }
      check { strict }
      """#
    "content/a.typ" #"""
      #let frontmatter = (title: "A",)

      = One

      == Two

      === Three

      = Back up
      """#
  }
  expect {
    ok
  }
}

scenario "an image with no alt fails a strict build" {
  files {
    "config.kdl" #"""
      site "T"
      paths {
        content "content"
        dist "public"
      }
      check { strict }
      """#
    "content/a.typ" #"""
      #let frontmatter = (title: "A",)

      #html.elem("img", attrs: (src: "/logo.png"))
      """#
  }
  expect {
    fails { code "baudelaire::lint::found" }
  }
}

scenario "an empty alt and a decorative image are both deliberate" {
  files {
    "config.kdl" #"""
      site "T"
      paths {
        content "content"
        dist "public"
      }
      check { strict }
      """#
    "content/a.typ" #"""
      #let frontmatter = (title: "A",)

      #html.elem("img", attrs: (src: "/a.png", alt: ""))
      #html.elem("img", attrs: (src: "/b.png", "aria-hidden": "true"))
      #html.elem("img", attrs: (src: "/c.png", role: "presentation"))
      """#
  }
  expect {
    ok
  }
}

scenario "a rule turned off by name stops reporting" {
  files {
    "config.kdl" #"""
      site "T"
      paths {
        content "content"
        dist "public"
      }
      check {
        strict
        alt #false
      }
      """#
    "content/a.typ" #"""
      #let frontmatter = (title: "A",)

      #html.elem("img", attrs: (src: "/logo.png"))
      """#
  }
  expect {
    ok
  }
}

scenario "a repeated id fails a strict build" {
  files {
    "config.kdl" #"""
      site "T"
      paths {
        content "content"
        dist "public"
      }
      check { strict }
      """#
    "content/a.typ" #"""
      #let frontmatter = (title: "A",)

      #html.elem("div", attrs: (id: "intro"))[first]
      #html.elem("div", attrs: (id: "intro"))[second]
      """#
  }
  expect {
    fails { code "baudelaire::lint::found" }
  }
}

scenario "an unknown role fails a strict build" {
  files {
    "config.kdl" #"""
      site "T"
      paths {
        content "content"
        dist "public"
      }
      check { strict }
      """#
    "content/a.typ" #"""
      #let frontmatter = (title: "A",)

      #html.elem("div", attrs: (role: "buton"))[oops]
      """#
  }
  expect {
    fails { code "baudelaire::lint::found" }
  }
}

scenario "an aria reference to nothing fails a strict build" {
  files {
    "config.kdl" #"""
      site "T"
      paths {
        content "content"
        dist "public"
      }
      check { strict }
      """#
    "content/a.typ" #"""
      #let frontmatter = (title: "A",)

      #html.elem("nav", attrs: ("aria-labelledby": "nowhere"))[menu]
      """#
  }
  expect {
    fails { code "baudelaire::lint::found" }
  }
}

scenario "aria that resolves and roles that exist are left alone" {
  files {
    "config.kdl" #"""
      site "T"
      paths {
        content "content"
        dist "public"
      }
      check { strict }
      """#
    "content/a.typ" #"""
      #let frontmatter = (title: "A",)

      #html.elem("h2", attrs: (id: "menu-label"))[Menu]
      #html.elem("nav", attrs: (role: "navigation", "aria-labelledby": "menu-label"))[menu]
      #html.elem("div", attrs: (role: "doc-chapter"))[a module role]
      """#
  }
  expect {
    ok
  }
}

scenario "a finding only warns until strictness is asked for" {
  files {
    "config.kdl" #"""
      site "T"
      paths {
        content "content"
        dist "public"
      }
      check { }
      """#
    "content/a.typ" #"""
      #let frontmatter = (title: "A",)

      #html.elem("img", attrs: (src: "/logo.png"))
      """#
  }
  expect {
    ok
    file "a/index.html"
  }
}

scenario "a page over its html budget fails the build" {
  files {
    "config.kdl" #"""
      site "T"
      paths {
        content "content"
        dist "public"
      }
      check {
        budget { html 200 }
      }
      """#
    "content/a.typ" #"""
      #let frontmatter = (title: "A",)

      #lorem(200)
      """#
  }
  expect {
    fails { code "baudelaire::lint::budget" }
  }
}

scenario "a stylesheet counts against the css budget, not the html one" {
  files {
    "config.kdl" #"""
      site "T"
      paths {
        content "content"
        dist "public"
        assets "assets"
      }
      assets { minify #false }
      check {
        budget { css 500 }
      }
      """#
    "assets/big.css" #"""
      /* padded well past a kilobyte so the budget has something to catch */
      .a { color: rebeccapurple; background: white; border: 1px solid black; }
      .b { color: rebeccapurple; background: white; border: 1px solid black; }
      .c { color: rebeccapurple; background: white; border: 1px solid black; }
      .d { color: rebeccapurple; background: white; border: 1px solid black; }
      .e { color: rebeccapurple; background: white; border: 1px solid black; }
      .f { color: rebeccapurple; background: white; border: 1px solid black; }
      .g { color: rebeccapurple; background: white; border: 1px solid black; }
      .h { color: rebeccapurple; background: white; border: 1px solid black; }
      .i { color: rebeccapurple; background: white; border: 1px solid black; }
      .j { color: rebeccapurple; background: white; border: 1px solid black; }
      .k { color: rebeccapurple; background: white; border: 1px solid black; }
      .l { color: rebeccapurple; background: white; border: 1px solid black; }
      """#
    "content/a.typ" #"""
      #let frontmatter = (title: "A",)

      #html.elem("link", attrs: (rel: "stylesheet", href: "/assets/big.css"))

      Short page.
      """#
  }
  expect {
    fails { code "baudelaire::lint::budget" }
  }
}

scenario "a page inside every budget builds" {
  files {
    "config.kdl" #"""
      site "T"
      paths {
        content "content"
        dist "public"
      }
      check {
        budget {
          html "1MB"
          js 0
          css "1MB"
          images "1MB"
          total "2MB"
        }
      }
      """#
    "content/a.typ" #"""
      #let frontmatter = (title: "A",)

      A page that loads nothing at all.
      """#
  }
  expect {
    ok
    file "a/index.html"
  }
}

scenario "a budget written in something that is not a size is a config error" {
  files {
    "config.kdl" #"""
      site "T"
      check {
        budget { html "quite small" }
      }
      """#
    "content/a.typ" #"""
      #let frontmatter = (title: "A",)
      body
      """#
  }
  expect {
    fails { code "baudelaire::config::bad_size" }
  }
}

// `strict` is a default, not an override: a site can hold every rule to it and
// still let one warn. Before this a rule was on or off, so exempting one meant
// losing it entirely.
scenario "a rule names its own severity over the site's strict" {
  files {
    "config.kdl" #"""
      site "T"
      paths {
        content "content"
        dist "public"
      }
      check {
        strict #true
        headings "warn"
      }
      """#
    "content/a.typ" #"""
      #let frontmatter = (title: "A",)
      = One
      === Three
      #html.elem("img", attrs: (src: "/x.png"))
      """#
  }
  expect {
    // The `alt` finding takes `strict` and fails the build; the heading skip
    // named `warn` and does not.
    fails { code "baudelaire::lint::found" }
  }
}

// And with the failing rule turned down, the build passes with both still
// reported.
scenario "every rule warning leaves the build green" {
  files {
    "config.kdl" #"""
      site "T"
      paths {
        content "content"
        dist "public"
      }
      check {
        strict #true
        headings "warn"
        alt "warn"
      }
      """#
    "content/a.typ" #"""
      #let frontmatter = (title: "A",)
      = One
      === Three
      #html.elem("img", attrs: (src: "/x.png"))
      """#
  }
  expect {
    ok
    file "a/index.html" { contains "Three" }
  }
}

// `off` is the third state, and the boolean spelling every site already wrote
// still means it.
scenario "a rule turned off by name or by flag finds nothing" {
  files {
    "config.kdl" #"""
      site "T"
      paths {
        content "content"
        dist "public"
      }
      check {
        strict #true
        headings "off"
        alt #false
        ids #false
        aria #false
      }
      """#
    "content/a.typ" #"""
      #let frontmatter = (title: "A",)
      = One
      === Three
      #html.elem("img", attrs: (src: "/x.png"))
      """#
  }
  expect {
    ok
  }
}

// A budget is an assertion the author wrote down, so it fails by default. A site
// adopting one on an existing set of pages needs it to be a number to aim at
// first, which it had no way to say.
scenario "a budget can report instead of failing" {
  files {
    "config.kdl" #"""
      site "T"
      paths {
        content "content"
        dist "public"
      }
      check {
        budget {
          strict #false
          html 1
        }
      }
      """#
    "content/a.typ" #"""
      #let frontmatter = (title: "A",)
      a page larger than one byte
      """#
  }
  expect {
    ok
    file "a/index.html" { contains "larger than one byte" }
  }
}

// `check { snippets { } }`: a code fence checked against the language it claims,
// by this build's parser for it or by a command the site names.

scenario "a malformed fence is reported where its checker stopped" {
  files {
    "config.kdl" #"""
      site "T"
      paths {
        content "content"
        dist "public"
      }
      check {
        snippets { kdl }
      }
      """#
    "content/a.typ" #"""
      #let frontmatter = (title: "A",)

      ```kdl
      site "unclosed
      ```
      """#
  }
  expect {
    ok
    warns "baudelaire::lint::found"
  }
}

scenario "a fence that parses is not reported" {
  files {
    "config.kdl" #"""
      site "T"
      paths {
        content "content"
        dist "public"
      }
      check {
        snippets {
          kdl
          json
        }
      }
      """#
    "content/a.typ" #"""
      #let frontmatter = (title: "A",)

      ```kdl
      site "T"
      paths { dist "public" }
      ```

      ```json
      {"a": [1, 2]}
      ```
      """#
  }
  expect {
    ok
    unwarned "baudelaire::lint::found"
  }
}

// A fence of a language no line names is shown, never checked: a site opts one
// language at a time into being held to its own syntax.
scenario "a language the config does not name is left alone" {
  files {
    "config.kdl" #"""
      site "T"
      paths {
        content "content"
        dist "public"
      }
      check {
        snippets { json }
      }
      """#
    "content/a.typ" #"""
      #let frontmatter = (title: "A",)

      ```kdl
      site "unclosed
      ```
      """#
  }
  expect {
    ok
    unwarned "baudelaire::lint::found"
  }
}

scenario "a fence language names its own severity" {
  files {
    "config.kdl" #"""
      site "T"
      paths {
        content "content"
        dist "public"
      }
      check {
        snippets { kdl "error" }
      }
      """#
    "content/a.typ" #"""
      #let frontmatter = (title: "A",)

      ```kdl
      site "unclosed
      ```
      """#
  }
  expect {
    fails { code "baudelaire::lint::found" }
  }
}

scenario "a language nothing here parses is refused rather than never run" {
  files {
    "config.kdl" #"""
      site "T"
      paths {
        content "content"
        dist "public"
      }
      check {
        snippets { sh }
      }
      """#
    "content/a.typ" #"""
      #let frontmatter = (title: "A",)
      """#
  }
  expect {
    fails { code "baudelaire::config::no_snippet_checker" }
  }
}

scenario "a language with a command of its own is checked by it" {
  files {
    "config.kdl" #"""
      site "T"
      paths {
        content "content"
        dist "public"
      }
      check {
        snippets {
          sh run="test -s {file}"
          text run="false"
        }
      }
      """#
    "content/a.typ" #"""
      #let frontmatter = (title: "A",)

      ```sh
      baudelaire build
      ```

      ```text
      whatever
      ```
      """#
  }
  expect {
    ok
    warns "baudelaire::lint::found"
  }
}

// A hidden line is checked and not shown: what a fragment needs to stand on its
// own without the page carrying the scaffolding around it.
scenario "a hidden line is checked but never rendered" {
  files {
    "config.kdl" #"""
      site "T"
      paths {
        content "content"
        dist "public"
      }
      check {
        snippets {
          kdl hidden="%% "
        }
      }
      """#
    "content/a.typ" #"""
      #let frontmatter = (title: "A",)

      ```kdl
      %% content {
      index "index"
      %% }
      ```
      """#
  }
  expect {
    ok
    unwarned "baudelaire::lint::found"
    file "a/index.html" {
      contains #"index "index""#
      missing "content {"
    }
  }
}

scenario "a fragment that only parses with its hidden lines is not reported" {
  files {
    "config.kdl" #"""
      site "T"
      paths {
        content "content"
        dist "public"
      }
      check {
        snippets {
          kdl hidden="%% "
        }
      }
      """#
    "content/a.typ" #"""
      #let frontmatter = (title: "A",)

      ```kdl
      %% a {
      b 1
      ```
      """#
  }
  expect {
    ok
    warns "baudelaire::lint::found"
  }
}

scenario "a fence that is wrong on purpose says so and is left alone" {
  files {
    "config.kdl" #"""
      site "T"
      paths {
        content "content"
        dist "public"
      }
      check {
        snippets {
          kdl "error" hidden="%% "
        }
      }
      """#
    "content/a.typ" #"""
      #let frontmatter = (title: "A",)

      ```kdl
      %% @ignore
      site "unclosed
      ```
      """#
  }
  expect {
    ok
    unwarned "baudelaire::lint::found"
    file "a/index.html" { missing "@ignore" }
  }
}

// The escape hatch for a finding that is right about the markup and wrong about
// the page: one element, marked by the author, that no rule looks at.
scenario "an element marked off is left alone by every rule" {
  files {
    "config.kdl" #"""
      site "T"
      paths {
        content "content"
        dist "public"
      }
      check {
        strict
        snippets { kdl }
      }
      """#
    "content/a.typ" #"""
      #let frontmatter = (title: "A",)

      #html.elem("img", attrs: ("src": "/logo.png", "data-lint": "off"))

      #html.elem("code", attrs: ("data-lang": "kdl", "data-lint": "off"))[site "unclosed]
      """#
  }
  expect {
    ok
    unwarned "baudelaire::lint::found"
  }
}

// `nolint` is transparent: the page it writes is the page it would have written
// without it, and everything inside is invisible to every rule.
scenario "a marked region is left alone, native elements included" {
  files {
    "config.kdl" #"""
      site "T"
      paths {
        content "content"
        dist "public"
      }
      check {
        strict
        snippets { kdl }
      }
      """#
    "content/a.typ" #"""
      #import "@baudelaire/html:0.1.0": nolint
      #let frontmatter = (title: "A",)

      #nolint[
        ==== Deep on purpose

        #html.elem("img", attrs: (src: "/logo.png"))

        ```kdl
        site "unclosed
        ```
      ]
      """#
  }
  expect {
    ok
    unwarned "baudelaire::lint::found"
    file "a/index.html" {
      contains "<h5"
      missing "data-lint"
      missing "<div>"
    }
  }
}

// The splice lifts an inner marker into the element the walk has already left,
// so one pass removed the outer wrapper and shipped the inner one, `data-lint`
// attribute and all.
scenario "a marker inside a marker leaves nothing behind" {
  files {
    "config.kdl" #"""
      site "T"
      paths {
        content "content"
        dist "public"
      }
      check { strict }
      """#
    "content/a.typ" #"""
      #import "@baudelaire/html:0.1.0": nolint
      #let frontmatter = (title: "A",)

      #nolint("headings")[
        ==== Deep on purpose

        #nolint("alt")[
          #html.elem("img", attrs: (src: "/logo.png"))
        ]
      ]
      """#
  }
  expect {
    ok
    unwarned "baudelaire::lint::found"
    file "a/index.html" {
      contains "<h5"
      missing "data-lint"
    }
  }
}

// A marker that names rules keeps only those off, so a page can say "this
// heading is deliberate" without going blind to everything else.
scenario "a marker names the rules it keeps off" {
  files {
    "config.kdl" #"""
      site "T"
      paths {
        content "content"
        dist "public"
      }
      check { }
      """#
    "content/a.typ" #"""
      #import "@baudelaire/html:0.1.0": nolint
      #let frontmatter = (title: "A",)

      #nolint("headings")[
        ==== Deep on purpose

        #html.elem("img", attrs: (src: "/logo.png"))
      ]
      """#
  }
  expect {
    ok
    // The heading is spared; the image is not.
    warns "baudelaire::lint::found"
  }
}
