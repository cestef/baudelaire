// Internal `.typ` links become permalinks; unresolvable ones are a gate.

scenario "an internal typ link is rewritten and an external one is left alone" {
  files {
    "config.kdl" #"""
      site "Test"
      paths {
        content "content"
        dist "public"
      }
      """#
    "content/posts/a.typ" #"""
      #let frontmatter = (title: "A",)
      See #link("b.typ")[B] and #link("https://example.com")[ext].
      """#
    "content/posts/b.typ" #"""
      #let frontmatter = (title: "B",)
      B body
      """#
  }
  expect {
    ok
    file "posts/a/index.html" {
      contains #"href="/posts/b/""#
      contains "https://example.com"
    }
  }
}

scenario "a broken internal link fails a strict build" {
  files {
    "config.kdl" #"""
      site "T"
      paths {
        content "content"
        dist "public"
      }
      """#
    "content/posts/a.typ" #"""
      #let frontmatter = (title: "A",)
      See #link("missing.typ")[gone].
      """#
  }
  expect {
    fails { code "baudelaire::links::broken" }
  }
}

scenario "a broken internal link only warns when strictness is off" {
  files {
    "config.kdl" #"""
      site "T"
      paths {
        content "content"
        dist "public"
      }
      links {
        strict #false
      }
      """#
    "content/posts/a.typ" #"""
      #let frontmatter = (title: "A",)
      See #link("missing.typ")[gone].
      """#
  }
  expect {
    ok
    file "posts/a/index.html"
  }
}

scenario "frontmatter redirects emit stub pages beside the real one" {
  files {
    "config.kdl" #"""
      site "T"
      paths {
        content "content"
        dist "public"
      }
      """#
    "content/posts/new.typ" #"""
      #let frontmatter = (title: "New", slug: "new", redirect: ("/old", "/legacy/post"),)
      body
      """#
  }
  expect {
    ok
    file "old/index.html" {
      contains #"http-equiv="refresh""#
      contains "url=/posts/new/"
    }
    file "legacy/post/index.html" {
      contains #"http-equiv="refresh""#
      contains "url=/posts/new/"
    }
    file "posts/new/index.html"
  }
}

// `generate { redirects }` swaps the stubs for a rule file the host answers
// with a real 301. The stubs have to go: Netlify and Cloudflare Pages both
// serve a static file in preference to a redirect rule, so a stub left at the
// old path would win and the rule would never fire.
scenario "generate redirects writes a rule file instead of stubs" {
  files {
    "config.kdl" #"""
      site "T"
      paths {
        content "content"
        dist "public"
      }
      generate {
        redirects #true
      }
      """#
    "content/posts/new.typ" #"""
      #let frontmatter = (title: "New", slug: "new", redirect: ("/old", "/legacy/post"),)
      body
      """#
  }
  expect {
    ok
    file "_redirects" {
      contains "/old /posts/new/ 301"
      contains "/legacy/post /posts/new/ 301"
    }
    absent "old/index.html"
    absent "legacy/post/index.html"
    file "posts/new/index.html"
  }
}

// `redirect` on a page covers a page that still exists. A paginated `page/1/`,
// a renamed term listing and a deleted section have no frontmatter to declare
// anything in, so the config claims those paths instead.
scenario "the config redirects a path no page owns" {
  files {
    "config.kdl" #"""
      site "T"
      paths {
        content "content"
        dist "public"
      }
      redirect {
        "/blog/page/1/" "/posts/"
        "/2019/gone/" "/posts/new/"
        "/elsewhere/" "https://example.org/moved"
      }
      """#
    "content/posts/new.typ" #"""
      #let frontmatter = (title: "New", slug: "new",)
      body
      """#
  }
  expect {
    ok
    file "blog/page/1/index.html" { contains "url=/posts/" }
    file "2019/gone/index.html" { contains "url=/posts/new/" }
    // An absolute target forwards off the site untouched: a section that moved
    // to another host is the case with no other answer.
    file "elsewhere/index.html" { contains "url=https://example.org/moved" }
    file "posts/new/index.html"
  }
}

// One emitter, one format switch: a config pair is a redirect like any other
// and joins the rule file rather than being left behind as a stub the host
// would serve in preference to its own rule.
scenario "config redirects join the generated rule file" {
  files {
    "config.kdl" #"""
      site "T"
      paths {
        content "content"
        dist "public"
      }
      generate {
        redirects #true
      }
      redirect {
        "/blog/page/1/" "/posts/"
      }
      """#
    "content/posts/new.typ" #"""
      #let frontmatter = (title: "New", slug: "new", redirect: ("/old",),)
      body
      """#
  }
  expect {
    ok
    file "_redirects" {
      contains "/old /posts/new/ 301"
      contains "/blog/page/1/ /posts/ 301"
    }
    absent "blog/page/1/index.html"
  }
}

// The whole point of the claim accounting: a config line must not be able to
// bury a page under a stub that forwards away from it.
scenario "a config redirect onto a real page is a collision" {
  files {
    "config.kdl" #"""
      site "T"
      redirect {
        "/posts/new/" "/posts/other/"
      }
      """#
    "content/posts/new.typ" #"""
      #let frontmatter = (title: "New", slug: "new",)
      body
      """#
  }
  expect {
    fails { code "baudelaire::content::collision" }
  }
}

// A fragment used to be `Link::Passthrough`: resolved as part of the URL and
// never checked, so renaming a heading silently broke every deep link into it.
scenario "a link to a heading that does not exist is caught" {
  files {
    "config.kdl" #"""
      site "T"
      """#
    "content/guide.typ" #"""
      #let frontmatter = (title: "Guide",)
      == Installing
      how to install
      """#
    "content/index.typ" #"""
      #let frontmatter = (title: "H",)
      #link("/content/guide.typ#instaling")[typo'd anchor]
      """#
  }
  expect {
    // The aggregate reports as a broken link; the precise `links::anchor` code
    // rides on the child, which `check::tests` pins.
    fails { code "baudelaire::links::broken" }
  }
}

scenario "a link to a heading that exists is fine" {
  files {
    "config.kdl" #"""
      site "T"
      """#
    "content/guide.typ" #"""
      #let frontmatter = (title: "Guide",)
      == Installing
      how to install
      """#
    "content/index.typ" #"""
      #let frontmatter = (title: "H",)
      #link("/content/guide.typ#installing")[good anchor]
      #link("/content/guide.typ")[no fragment at all]
      """#
  }
  expect {
    ok
    file "index.html" { contains "/guide/#installing" }
  }
}

// The anchor check must not fire on a page whose ids baudelaire never derived,
// only on one that genuinely lacks the heading. With `anchors #false` a page
// exposes exactly its authored ids, and those are still checked.
scenario "with anchor generation off, only authored ids exist" {
  files {
    "config.kdl" #"""
      site "T"
      html { anchors #false }
      """#
    "content/guide.typ" #"""
      #let frontmatter = (title: "Guide",)
      == Installing
      how to install
      """#
    "content/index.typ" #"""
      #let frontmatter = (title: "H",)
      #link("/content/guide.typ#installing")[was derived, now absent]
      """#
  }
  expect {
    // The aggregate reports as a broken link; the precise `links::anchor` code
    // rides on the child, which `check::tests` pins.
    fails { code "baudelaire::links::broken" }
  }
}

// A dangling anchor obeys the same strict-vs-warn gate as a dangling page, so
// a site that chose warnings keeps getting warnings.
scenario "a dangling anchor is a warning when links are not strict" {
  files {
    "config.kdl" #"""
      site "T"
      links { strict #false }
      """#
    "content/guide.typ" #"""
      #let frontmatter = (title: "Guide",)
      == Installing
      """#
    "content/index.typ" #"""
      #let frontmatter = (title: "H",)
      #link("/content/guide.typ#nope")[bad]
      """#
  }
  expect {
    ok
    file "index.html"
  }
}

// Translating a page by copying its frontmatter carries the `redirect` list
// along, and each edition forwards its old path under its own language prefix.
// The collision check compared those paths *unlocalized*, so the documented
// translation workflow failed the build over a clash that never existed on disk.
scenario "each edition forwards its old path under its own language" {
  files {
    "config.kdl" #"""
      site "T"
      lang "en"
      languages {
        fr { name "Français" }
      }
      """#
    "content/posts/a.typ" #"""
      #let frontmatter = (title: "A", redirect: ("/old/a/",),)
      body
      """#
    "content/posts/a.fr.typ" #"""
      #let frontmatter = (title: "A", redirect: ("/old/a/",),)
      corps
      """#
  }
  expect {
    ok
    file "old/a/index.html" { contains "/posts/a/" }
    file "fr/old/a/index.html" { contains "/fr/posts/a/" }
  }
}

// `generate { redirects }` writes a rule file *instead of* stubs, and the static
// tree wins any path it claims. A site publishing its own `_redirects` therefore
// lost both halves at once: the generated rules were dropped on the way out and
// the stubs were never written, so every declared old path 404'd in silence.
scenario "a hand-written rule file brings the stubs back rather than dropping the redirects" {
  files {
    "config.kdl" #"""
      site "T"
      generate {
        redirects #true
      }
      """#
    "static/_redirects" #"""
      /hand/written/ /posts/new/ 301
      """#
    "content/posts/new.typ" #"""
      #let frontmatter = (title: "New", slug: "new", redirect: ("/old/",),)
      body
      """#
  }
  expect {
    ok
    warns "baudelaire::output::redirects_shadowed"
    // The site's own rule file is served untouched.
    file "_redirects" {
      contains "/hand/written/ /posts/new/ 301"
      missing "/old/"
    }
    // and the old path still forwards, by the mechanism that works anywhere.
    file "old/index.html" { contains "/posts/new/" }
  }
}

// The migration escape hatch: a page names the URL it answers at, whatever its
// collection's pattern would have produced. Every generator this project is
// migrated from has one (Hugo `url`, Zola `path`, Jekyll and Eleventy
// `permalink`), and without it an old URL set could only be approximated by
// reverse-engineering one pattern per shape.
scenario "a page publishes at the path its frontmatter names" {
  files {
    "config.kdl" #"""
      site "T"
      url "https://example.com"
      lang "en"
      languages {
        fr { name "Français" }
      }
      generate { sitemap #true }
      """#
    "content/posts/a.typ" #"""
      #let frontmatter = (title: "A", path: "/2019/legacy.html",)
      body
      """#
    "content/posts/a.fr.typ" #"""
      #let frontmatter = (title: "A", path: "/2019/heritage.html",)
      corps
      """#
    "content/posts/b.typ" #"""
      #let frontmatter = (title: "B", path: "about-us",)
      See #link("a.typ")[the old one].
      """#
  }
  expect {
    ok
    // A path naming a file publishes as that file, not as a directory holding
    // an index.html: `/2019/post.html` is the shape a Jekyll site is preserving.
    file "2019/legacy.html" { contains "body" }
    absent "2019/legacy.html/index.html"
    // One naming a directory is normalized like any other permalink, leading
    // and trailing slashes optional.
    file "about-us/index.html"
    // A link to the page resolves to the path it claimed...
    file "about-us/index.html" { contains #"href="/2019/legacy.html""# }
    // ...and so does the sitemap.
    file "sitemap.xml" { contains "<loc>https://example.com/2019/legacy.html</loc>" }
    // Each edition takes its own, under its own language prefix. They stay one
    // page in two languages: pairing is on the slug, which `path` does not touch.
    file "fr/2019/heritage.html" { contains "corps" }
    file "2019/legacy.html" { contains #"hreflang="fr" href="https://example.com/fr/2019/heritage.html""# }
  }
}

// Two pages cannot answer at one URL, whichever way each asked for it.
scenario "two pages claiming one path is an error" {
  files {
    "config.kdl" #"""
      site "T"
      """#
    "content/posts/a.typ" #"""
      #let frontmatter = (title: "A", path: "/same/",)
      body
      """#
    "content/posts/b.typ" #"""
      #let frontmatter = (title: "B", path: "/same/",)
      body
      """#
  }
  expect {
    fails { code "baudelaire::content::collision" }
  }
}
