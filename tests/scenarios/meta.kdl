// The head tags and the per-element annotations the DOM pass adds.

scenario "meta tags come from frontmatter and config" {
  files {
    "config.kdl" #"""
      site "S"
      url "https://s.example"
      """#
    "content/post.typ" #"""
      #let frontmatter = (title: "Hello", summary: "A short summary.")
      body
      """#
  }
  expect {
    ok
    file "post/index.html" {
      contains #"name="description" content="A short summary.""#
      contains #"property="og:title" content="Hello""#
      contains #"property="og:site_name" content="S""#
      // URL-absolute tags appear because a base `url` is set.
      contains #"rel="canonical" href="https://s.example/post/""#
      contains #"property="og:url" content="https://s.example/post/""#
    }
  }
}

scenario "meta tags are omitted when html meta is off" {
  files {
    "config.kdl" #"""
      site "S"
      url "https://s.example"
      html {
        meta #false
      }
      """#
    "content/post.typ" #"""
      #let frontmatter = (title: "Hi", summary: "s")
      body
      """#
  }
  expect {
    ok
    file "post/index.html" { missing "og:title" }
  }
}

scenario "an og:image is absolute and follows the fingerprinted name" {
  // Fingerprinting is off in a build without the stylesheet rewriter.
  requires "css"
  files {
    "config.kdl" #"""
      site "S"
      url "https://s.example"
      paths {
        content "content"
        dist "public"
        assets "assets"
      }
      assets {
        fingerprint #true
      }
      """#
    "assets/pic.png" png="4x4"
    "content/post.typ" #"""
      #let frontmatter = (title: "Hi", image: "/assets/pic.png")
      body
      """#
  }
  expect {
    ok
    file "post/index.html" {
      contains #"property="og:image""#
      contains #"content="https://s.example/assets/pic."#
      // The raw name was replaced by the hashed one.
      missing #"assets/pic.png""#
    }
  }
}

scenario "images are annotated for lazy decoding" {
  files {
    "config.kdl" #"""
      site "S"
      """#
    "content/p.typ" #"""
      #let frontmatter = (title: "P")
      #html.elem("img", attrs: (src: "/photo.png"))
      """#
  }
  expect {
    ok
    file "p/index.html" {
      contains #"loading="lazy""#
      contains #"decoding="async""#
    }
  }
}

scenario "headings get unique slug anchors" {
  files {
    "config.kdl" #"""
      site "T"
      paths {
        content "content"
        dist "public"
      }
      """#
    "content/docs/guide.typ" #"""
      #let frontmatter = (title: "Guide",)
      = Guide

      == Setup
      one

      == Setup
      two
      """#
  }
  expect {
    ok
    file "docs/guide/index.html" {
      contains #"id="guide""#
      // Two headings slugging alike are disambiguated, not duplicated.
      contains #"id="setup""#
      contains #"id="setup-2""#
    }
  }
}

scenario "anchors off leaves headings bare" {
  files {
    "config.kdl" #"""
      site "T"
      paths {
        content "content"
        dist "public"
      }
      html {
        anchors #false
      }
      """#
    "content/docs/guide.typ" #"""
      #let frontmatter = (title: "Guide",)
      == Setup
      body
      """#
  }
  expect {
    ok
    file "docs/guide/index.html" { missing #"id="setup""# }
  }
}

// A dated page is an article, and an article has a vocabulary: when it was
// published, when it changed, who wrote it, what it is about. The tags were the
// half of OpenGraph that was never emitted, and several unfurlers read
// `article:published_time` for the dateline.
scenario "a dated page carries the article vocabulary" {
  files {
    "config.kdl" #"""
      site "S"
      url "https://s.example"
      author "Ada"
      content {
        taxonomies {
          tags listing=#true
        }
      }
      """#
    "content/post.typ" #"""
      #let frontmatter = (
        title: "Hello",
        date: datetime(year: 2026, month: 3, day: 4),
        updated: datetime(year: 2026, month: 5, day: 6),
        tags: ("rust",),
      )
      body
      """#
    "content/plain.typ" #"""
      #let frontmatter = (title: "Plain")
      body
      """#
  }
  expect {
    ok
    file "post/index.html" {
      contains #"property="og:type" content="article""#
      contains #"property="article:published_time" content="2026-03-04""#
      contains #"property="article:modified_time" content="2026-05-06""#
      contains #"property="article:author" content="Ada""#
      contains #"property="article:tag" content="rust""#
    }
    // An undated page is a website page, and has no article vocabulary to carry.
    file "plain/index.html" {
      contains #"property="og:type" content="website""#
      missing "article:published_time"
      missing "article:author"
    }
  }
}

// Structured data is opt-in: the meta tags beside it restate what the page
// already says, while this is a claim made to a search engine about what the
// page is.
scenario "json-ld is emitted only when asked for" {
  files {
    "config.kdl" #"""
      site "S"
      url "https://s.example"
      html {
        jsonld #true
      }
      """#
    "content/post.typ" #"""
      #let frontmatter = (
        title: "Hello",
        date: datetime(year: 2026, month: 3, day: 4),
      )
      body
      """#
  }
  expect {
    ok
    file "post/index.html" {
      contains #"type="application/ld+json""#
      contains #""@type":"Article""#
      contains #""datePublished":"2026-03-04""#
      contains #""url":"https://s.example/post/""#
    }
  }
}

scenario "no json-ld without the key" {
  files {
    "config.kdl" #"""
      site "S"
      url "https://s.example"
      """#
    "content/post.typ" #"""
      #let frontmatter = (title: "Hello")
      body
      """#
  }
  expect {
    ok
    file "post/index.html" {
      missing "application/ld+json"
    }
  }
}

// `description`, `summary`, `image`, `alt` and `author` are declared keys, so a
// wrong-typed value is named where it was written instead of reading as absent.
scenario "a meta key of the wrong type is refused" {
  files {
    "config.kdl" #"""
      site "S"
      url "https://s.example"
      """#
    "content/post.typ" #"""
      #let frontmatter = (title: "Hello", description: 7)
      body
      """#
  }
  expect {
    fails { code "baudelaire::content::frontmatter_field" }
  }
}

// A near-miss of one of them is a typo, and used to pass silently into `extra`,
// shipping a page with no description out of a green build.
scenario "a misspelt description is reported rather than dropped" {
  files {
    "config.kdl" #"""
      site "S"
      url "https://s.example"
      """#
    "content/post.typ" #"""
      #let frontmatter = (title: "Hello", descripton: "A short summary.")
      body
      """#
  }
  expect {
    fails { code "baudelaire::content::unknown_frontmatter_key" }
  }
}

// But a key that merely *starts* with one is a different word, not a slip: a
// site may still carry its own `authors` beside the built-in `author`.
scenario "a longer key that extends a built-in passes through" {
  files {
    "config.kdl" #"""
      site "S"
      url "https://s.example"
      """#
    "content/post.typ" #"""
      #let frontmatter = (title: "Hello", authors: ("A", "B"), images: ("a.png",))
      body
      """#
  }
  expect {
    ok
    file "post/index.html" { contains "body" }
  }
}
