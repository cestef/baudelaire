// What a template is handed: the page, its siblings, the section tree, and the
// build-time constants from `client { }`.

scenario "a frontmatter template wraps the page body" {
  files {
    "config.kdl" #"""
      site "Test"
      paths {
        content "content"
        dist "public"
        templates "templates"
      }
      """#
    "templates/post.typ" #"""
      #let post(page, body) = {
        html.elem("article", attrs: (class: "post"))[
          #html.elem("h1", page.frontmatter.title)
          #body
        ]
      }
      """#
    "content/posts/hello.typ" #"""
      #let frontmatter = (title: "Hi", template: "post.typ",)
      Hello body
      """#
  }
  expect {
    ok
    file "posts/hello/index.html" {
      contains #"<article class="post">"#
      // Headings carry an anchor id, so pin the text rather than the attributes.
      contains ">Hi</h1>"
      contains "Hello body"
    }
  }
}

scenario "a collection's template applies without frontmatter asking for it" {
  files {
    "config.kdl" #"""
      site "Test"
      paths {
        content "content"
        dist "public"
      }
      content {
        collections {
          posts { template "post.typ" }
        }
      }
      """#
    "templates/post.typ" #"""
      #let post(page, body) = html.elem("main", body)
      """#
    "content/posts/hello.typ" #"""
      #let frontmatter = (title: "Hi",)
      body here
      """#
  }
  expect {
    ok
    file "posts/hello/index.html" { contains "<main>" }
  }
}

scenario "prev and next siblings reach the template" {
  files {
    "config.kdl" #"""
      site "T"
      content {
        collections {
          posts { template "post.typ" }
        }
      }
      """#
    // Render `page.nav` prev/next as rel-tagged links.
    "templates/post.typ" #"""
      #let post(page, body) = html.elem("html", html.elem("body", {
        body
        if page.nav.prev != none { html.elem("a", attrs: (rel: "prev", href: page.nav.prev.url), page.nav.prev.title) }
        if page.nav.next != none { html.elem("a", attrs: (rel: "next", href: page.nav.next.url), page.nav.next.title) }
      }))
      """#
    // Default collection sort is `order`; three pages in a known sequence.
    "content/posts/a.typ" #"""
      #let frontmatter = (title: "First", order: 1,)
      body a
      """#
    "content/posts/b.typ" #"""
      #let frontmatter = (title: "Second", order: 2,)
      body b
      """#
    "content/posts/c.typ" #"""
      #let frontmatter = (title: "Third", order: 3,)
      body c
      """#
  }
  expect {
    ok
    file "posts/a/index.html" {
      missing #"rel="prev""#
      contains #"rel="next" href="/posts/b/""#
      contains "Second"
    }
    file "posts/b/index.html" {
      contains #"rel="prev" href="/posts/a/""#
      contains "First"
      contains #"rel="next" href="/posts/c/""#
      contains "Third"
    }
    file "posts/c/index.html" {
      contains #"rel="prev" href="/posts/b/""#
      contains "Second"
      missing #"rel="next""#
    }
  }
}

scenario "sections expose the ordered page set, not filesystem order" {
  files {
    "config.kdl" #"""
      site "T"
      content {
        collections {
          guide { sort "order"; template "page.typ" }
        }
      }
      """#
    // Every section id and its pages' titles, in order, as a flat trail.
    "templates/page.typ" #"""
      #import "@baudelaire/sections:0.1.0": sections
      #let page(page, body) = html.elem("html", html.elem("body", {
        body
        for section in sections(page.lang) {
          for entry in section.pages {
            html.elem("span", attrs: (class: "nav"), section.id + ":" + entry.title)
          }
        }
      }))
      """#
    "content/guide/b.typ" #"""
      #let frontmatter = (title: "Second", order: 2,)
      body
      """#
    "content/guide/a.typ" #"""
      #let frontmatter = (title: "First", order: 1,)
      body
      """#
    "content/guide/c.typ" #"""
      #let frontmatter = (title: "Third", order: 3,)
      body
      """#
  }
  expect {
    ok
    file "guide/a/index.html" {
      order "guide:First" "guide:Second" "guide:Third"
    }
  }
}

scenario "a subdirectory becomes a nested child section" {
  files {
    "config.kdl" #"""
      site "T"
      content {
        collections {
          guide { sort "order"; template "page.typ" }
        }
      }
      """#
    // Each section's id + direct-page titles, then one level of children.
    "templates/page.typ" #"""
      #import "@baudelaire/sections:0.1.0": sections
      #let page(page, body) = html.elem("html", html.elem("body", {
        for s in sections(page.lang) {
          html.elem("span", "S:" + s.id)
          for p in s.pages { html.elem("span", "P:" + s.id + "/" + p.title) }
          for c in s.children {
            html.elem("span", "C:" + s.id + ">" + c.id)
            for p in c.pages { html.elem("span", "P:" + c.id + "/" + p.title) }
          }
        }
      }))
      """#
    "content/guide/intro.typ" #"""
      #let frontmatter = (title: "Intro", order: 1,)
      body
      """#
    "content/guide/advanced/deep.typ" #"""
      #let frontmatter = (title: "Deep", order: 2,)
      body
      """#
  }
  expect {
    ok
    file "guide/intro/index.html" {
      contains "S:guide"
      contains "P:guide/Intro"
      contains "C:guide>advanced"
      contains "P:advanced/Deep"
      // The nested page is not also a direct child of guide.
      missing "P:guide/Deep"
    }
  }
}

scenario "client constants reach pages through sys.inputs" {
  files {
    "config.kdl" #"""
      site "T"
      client {
        analytics "plausible"
        revalidate 3600
      }
      """#
    "content/a.typ" #"""
      #let frontmatter = (title: "A",)
      Tracker: #sys.inputs.baudelaire.client.analytics, every #sys.inputs.baudelaire.client.revalidate
      """#
  }
  expect {
    ok
    file "a/index.html" { contains "Tracker: plausible, every 3600" }
  }
}

// `page.reading` is counted from the page's own typst source, since that is
// the only version in hand when a template is handed its page: the render has
// not happened yet. Code lines are machinery, not prose, and counting them
// would inflate a short page most.
scenario "a template can render a reading estimate" {
  files {
    "config.kdl" #"""
      site "T"
      content {
        collections {
          posts { template "post.typ" }
        }
      }
      """#
    "templates/post.typ" #"""
      #let post(page, body) = html.elem("html", html.elem("body", {
        html.elem("p", "words=" + str(page.reading.words))
        html.elem("p", "minutes=" + str(page.reading.minutes))
        body
      }))
      """#
    "content/posts/a.typ" #"""
      #let frontmatter = (title: "A",)
      #let ignored = "machinery"
      one two three four five
      """#
  }
  expect {
    ok
    file "posts/a/index.html" {
      contains "words=5"
      contains "minutes=1"
    }
  }
}

// ISO-8601 is right for a machine and wrong for a reader, and typst cannot fix
// it in a template: its own `datetime.display` knows English month names only.
// Both forms reach the page, and a language names its own months.
scenario "a page and a listing carry a localized date" {
  files {
    "config.kdl" #"""
      site "T"
      lang "en"
      languages {
        fr {
          strings {
            date "{day} {month} {year}"
            months "janvier" "février" "mars" "avril" "mai" "juin" \
                   "juillet" "août" "septembre" "octobre" "novembre" "décembre"
          }
        }
      }
      content {
        collections {
          posts { sort "date"; template "post.typ"; paginate { template "index.typ" } }
        }
      }
      """#
    "templates/post.typ" #"""
      #let post(page, body) = html.elem("html", html.elem("body", {
        html.elem("time", attrs: (datetime: page.date.iso), page.date.display)
        body
      }))
      """#
    "templates/index.typ" #"""
      #let index(page, body) = html.elem("html", html.elem("body", {
        for entry in page.frontmatter.entries {
          html.elem("li", entry.display)
        }
      }))
      """#
    "content/posts/a.fr.typ" #"""
      #let frontmatter = (title: "Bonjour", date: datetime(year: 2026, month: 7, day: 30),)
      body
      """#
    "content/posts/a.typ" #"""
      #let frontmatter = (title: "Hello", date: datetime(year: 2026, month: 7, day: 30),)
      body
      """#
  }
  expect {
    ok
    // The machine-readable form stays ISO-8601 in both languages.
    file "fr/posts/a/index.html" {
      contains #"datetime="2026-07-30""#
      contains "30 juillet 2026"
    }
    file "posts/a/index.html" {
      contains #"datetime="2026-07-30""#
      contains "July 30, 2026"
    }
    file "fr/posts/index.html" { contains "30 juillet 2026" }
    file "posts/index.html" { contains "July 30, 2026" }
  }
}

// A page knows itself: where it publishes, which collection it belongs to, and
// the files sitting beside it in its own bundle. None of that names another
// page, so it widens only this page's own cache identity, which is why it can
// be in the wrapper at all. Hugo, Zola, Jekyll and Eleventy all expose it, and a
// theme port used to have to reconstruct the URL from the catalogue.
scenario "a page carries its own url, collection and colocated files" {
  files {
    "config.kdl" #"""
      site "T"
      url "https://example.com"
      content {
        collections {
          posts { template "page.typ" }
        }
      }
      """#
    "templates/page.typ" #"""
      #import "@baudelaire/html:0.1.0": h
      #let page(page, body) = h("main", {
        h("p", "at:" + page.url)
        h("p", "in:" + page.collection)
        let hero = page.frontmatter.at("hero", default: none)
        if hero != none { h("p", "hero:" + page.assets.at(hero, default: "none")) }
        body
      })
      """#
    "content/posts/hello/index.typ" #"""
      #let frontmatter = (title: "Hello", hero: "cover.svg",)
      #image("cover.svg")
      body
      """#
    "content/posts/hello/cover.svg" #"""
      <svg xmlns="http://www.w3.org/2000/svg" width="4" height="4"></svg>
      """#
    "content/posts/plain.typ" #"""
      #let frontmatter = (title: "Plain",)
      body
      """#
  }
  expect {
    ok
    file "posts/hello/index.html" {
      contains "at:/posts/hello/"
      contains "in:posts"
      // The URL the extractor publishes it at, so a frontmatter name resolves.
      contains "hero:/assets/posts/hello/cover.svg"
    }
    // A page that shares its directory with its neighbours owns no files: the
    // map is empty rather than a listing of the section.
    file "posts/plain/index.html" {
      contains "at:/posts/plain/"
      missing "hero:"
    }
  }
}
