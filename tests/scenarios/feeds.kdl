// Sitemap and syndication: opt-in, and only in the formats asked for.

scenario "a sitemap and an rss feed are emitted when a url is set" {
  files {
    "config.kdl" #"""
      site "T"
      url "https://example.com"
      paths {
        content "content"
        dist "public"
      }
      generate {
        sitemap #true
        feed { formats "rss" }
      }
      """#
    "content/posts/a.typ" #"""
      #let frontmatter = (title: "A", slug: "a", date: datetime(year: 2024, month: 1, day: 2),)
      body
      """#
  }
  expect {
    ok
    file "sitemap.xml" { contains "<loc>https://example.com/posts/a/</loc>" }
    file "rss.xml" {
      contains "<item>"
      contains "https://example.com/posts/a/"
      contains "<pubDate>"
    }
  }
}

scenario "a feed entry with no title falls back to the page id" {
  files {
    "config.kdl" #"""
      site "T"
      url "https://example.com"
      generate {
        feed {
            formats "rss" "atom"
          }
      }
      """#
    "content/posts/untitled.typ" #"""
      #let frontmatter = (date: datetime(year: 2024, month: 1, day: 2),)
      body
      """#
  }
  expect {
    ok
    file "rss.xml" { contains "<title>posts/untitled</title>" }
    file "atom.xml" {
      contains "<title>posts/untitled</title>"
      missing "<title></title>"
    }
  }
}

scenario "a term feed sits beside its term page and carries only that term" {
  files {
    "config.kdl" #"""
      site "T"
      url "https://example.com"
      content {
        taxonomies {
          tags listing=#true
        }
      }
      generate {
        feed { formats "rss"; terms #true }
      }
      """#
    "content/posts/a.typ" #"""
      #let frontmatter = (title: "A", date: datetime(year: 2024, month: 1, day: 2), tags: ("rust",),)
      body
      """#
    "content/posts/b.typ" #"""
      #let frontmatter = (title: "B", date: datetime(year: 2024, month: 1, day: 3), tags: ("typst",),)
      body
      """#
  }
  expect {
    ok
    file "tags/rust/rss.xml" {
      contains "https://example.com/posts/a/"
      missing "/posts/b/"
      contains "<title>T - Tags: rust</title>"
      // A term feed identifies itself by its own URL, so an aggregator does not
      // merge it with the site feed.
      contains "<link>https://example.com/tags/rust/</link>"
    }
    file "tags/typst/rss.xml"
    file "rss.xml" {
      contains "/posts/a/"
      contains "/posts/b/"
    }
  }
}

scenario "term feeds stay off by default" {
  files {
    "config.kdl" #"""
      site "T"
      url "https://example.com"
      content {
        taxonomies {
          tags listing=#true
        }
      }
      generate {
        feed { formats "rss" }
      }
      """#
    "content/posts/a.typ" #"""
      #let frontmatter = (title: "A", date: datetime(year: 2024, month: 1, day: 2), tags: ("rust",),)
      body
      """#
  }
  expect {
    ok
    file "rss.xml"
    absent "tags/rust/rss.xml"
  }
}

scenario "only the configured feed format is emitted: atom" {
  files {
    "config.kdl" #"""
      site "T"
      url "https://example.com"
      paths {
        content "content"
        dist "public"
      }
      generate {
        feed {
            formats "atom"
          }
      }
      """#
    "content/posts/a.typ" #"""
      #let frontmatter = (title: "A", slug: "a", date: datetime(year: 2024, month: 1, day: 2),)
      body
      """#
  }
  expect {
    ok
    file "atom.xml" {
      contains "http://www.w3.org/2005/Atom"
      contains "<entry>"
    }
    absent "rss.xml"
  }
}

scenario "only the configured feed format is emitted: json" {
  files {
    "config.kdl" #"""
      site "T"
      url "https://example.com"
      paths {
        content "content"
        dist "public"
      }
      generate {
        feed {
            formats "json"
          }
      }
      """#
    "content/posts/a.typ" #"""
      #let frontmatter = (title: "A", slug: "a", date: datetime(year: 2024, month: 1, day: 2),)
      body
      """#
  }
  expect {
    ok
    file "feed.json" {
      contains "https://jsonfeed.org/version/1.1"
      contains #""url":"https://example.com/posts/a/""#
      contains #""date_published":"2024-01-02T00:00:00Z""#
      contains #""feed_url":"https://example.com/feed.json""#
    }
    absent "rss.xml"
    absent "atom.xml"
  }
}

scenario "nothing syndicated is emitted without a url" {
  files {
    "config.kdl" #"""
      site "T"
      paths {
        content "content"
        dist "public"
      }
      """#
    "content/posts/a.typ" #"""
      #let frontmatter = (title: "A", date: datetime(year: 2024, month: 1, day: 2),)
      body
      """#
  }
  expect {
    ok
    absent "sitemap.xml"
    absent "rss.xml"
  }
}

scenario "a site that opts into neither gets neither, silently" {
  files {
    "config.kdl" #"""
      site "T"
      url "https://example.com"
      paths {
        content "content"
        dist "public"
      }
      """#
    "content/index.typ" #"""
      #let frontmatter = (title: "H",)
      home
      """#
  }
  expect {
    ok
    absent "sitemap.xml"
    absent "rss.xml"
  }
}

scenario "a sitemap without a url is a request that cannot be met" {
  files {
    "config.kdl" #"""
      site "T"
      paths {
        content "content"
        dist "public"
      }
      generate {
        sitemap #true
      }
      """#
    "content/index.typ" #"""
      #let frontmatter = (title: "H",)
      home
      """#
  }
  expect {
    fails { code "baudelaire::output::url_required" }
  }
}

scenario "a feed without a url is a request that cannot be met" {
  files {
    "config.kdl" #"""
      site "T"
      paths {
        content "content"
        dist "public"
      }
      generate {
        feed { formats "rss" }
      }
      """#
    "content/index.typ" #"""
      #let frontmatter = (title: "H",)
      home
      """#
  }
  expect {
    fails { code "baudelaire::output::url_required" }
  }
}

// An item that carries nothing but a title is a wall of bare titles in a reader,
// which is what every feed used to be: no description, no categories, and one
// date doing the work of two.
scenario "a feed item carries its description, categories and both dates" {
  files {
    "config.kdl" #"""
      site "T"
      url "https://example.com"
      content {
        taxonomies {
          tags
        }
      }
      generate {
        feed { formats "rss" "atom" "json" }
      }
      """#
    "content/posts/a.typ" #"""
      #let frontmatter = (
        title: "A",
        date: datetime(year: 2024, month: 1, day: 2),
        updated: datetime(year: 2026, month: 3, day: 4),
        description: "what the post is about",
        tags: ("rust", "typst"),
      )
      body
      """#
  }
  expect {
    ok
    file "rss.xml" {
      contains "<description>what the post is about</description>"
      contains "<category>rust</category>"
      contains "<category>typst</category>"
      // RSS has only a publication date, so the rewrite has nowhere to go here.
      contains "<pubDate>Tue, 02 Jan 2024 00:00:00 +0000</pubDate>"
    }
    file "atom.xml" {
      contains "<summary>what the post is about</summary>"
      contains #"<category term="rust"/>"#
      // Atom separates them: `updated` is the rewrite, `published` the original.
      contains "<updated>2026-03-04T00:00:00Z</updated>"
      contains "<published>2024-01-02T00:00:00Z</published>"
    }
    file "feed.json" {
      contains #""summary":"what the post is about""#
      contains #""date_published":"2024-01-02T00:00:00Z""#
      contains #""date_modified":"2026-03-04T00:00:00Z""#
      contains #""tags":["rust","typst"]"#
    }
  }
}

// `updated` is when the page last changed; `date` is when it went up and is what
// orders every listing. The sitemap wants the former, and used to be handed the
// latter, so a rewritten page told crawlers it had not moved since publication.
scenario "the sitemap reports the rewrite date, not the publication date" {
  files {
    "config.kdl" #"""
      site "T"
      url "https://example.com"
      generate {
        sitemap #true
      }
      """#
    "content/posts/rewritten.typ" #"""
      #let frontmatter = (
        title: "Rewritten",
        date: datetime(year: 2023, month: 5, day: 6),
        updated: datetime(year: 2026, month: 7, day: 8),
      )
      body
      """#
    "content/posts/untouched.typ" #"""
      #let frontmatter = (title: "Untouched", date: datetime(year: 2023, month: 5, day: 6),)
      body
      """#
  }
  expect {
    ok
    file "sitemap.xml" {
      contains "<lastmod>2026-07-08</lastmod>"
      // A page that never changed still reports its publication date.
      contains "<lastmod>2023-05-06</lastmod>"
    }
  }
}

// The feeds existed and nothing pointed at them: no reader, extension or
// subscribe button could find one. typst-html owns `<head>`, so a layout could
// not add the tag either.
scenario "every page advertises the feeds in its head" {
  files {
    "config.kdl" #"""
      site "T"
      url "https://example.com"
      generate {
        feed { formats "rss" "json" }
      }
      """#
    "content/posts/a.typ" #"""
      #let frontmatter = (title: "A", date: datetime(year: 2024, month: 1, day: 2),)
      body
      """#
  }
  expect {
    ok
    file "posts/a/index.html" {
      contains #"<link rel="alternate" type="application/rss+xml" title="T" href="https://example.com/rss.xml">"#
      contains #"<link rel="alternate" type="application/feed+json" title="T" href="https://example.com/feed.json">"#
      // Only the configured formats are advertised.
      missing "application/atom+xml"
    }
  }
}

// A site with no feeds must not advertise any.
scenario "a site without feeds advertises none" {
  files {
    "config.kdl" #"""
      site "T"
      url "https://example.com"
      """#
    "content/index.typ" #"""
      #let frontmatter = (title: "H",)
      home
      """#
  }
  expect {
    ok
    file "index.html" { missing "application/rss+xml" }
  }
}
