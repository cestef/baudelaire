// Sitemap and syndication: opt-in, and only in the formats asked for.

scenario "a sitemap and an rss feed are emitted when a url is set" {
  files {
    "config.kdl" #"""
      site "T"
      url "https://example.com"
      paths {
        content "content"
        dist "public"
      }
      generate {
        sitemap #true
        feed { formats "rss" }
      }
      """#
    "content/posts/a.typ" #"""
      #let frontmatter = (title: "A", slug: "a", date: datetime(year: 2024, month: 1, day: 2),)
      body
      """#
  }
  expect {
    ok
    file "sitemap.xml" { contains "<loc>https://example.com/posts/a/</loc>" }
    file "rss.xml" {
      contains "<item>"
      contains "https://example.com/posts/a/"
      contains "<pubDate>"
    }
  }
}

scenario "a feed entry with no title falls back to the page id" {
  files {
    "config.kdl" #"""
      site "T"
      url "https://example.com"
      generate {
        feed {
            formats "rss" "atom"
          }
      }
      """#
    "content/posts/untitled.typ" #"""
      #let frontmatter = (date: datetime(year: 2024, month: 1, day: 2),)
      body
      """#
  }
  expect {
    ok
    file "rss.xml" { contains "<title>posts/untitled</title>" }
    file "atom.xml" {
      contains "<title>posts/untitled</title>"
      missing "<title></title>"
    }
  }
}

scenario "a term feed sits beside its term page and carries only that term" {
  files {
    "config.kdl" #"""
      site "T"
      url "https://example.com"
      content {
        taxonomies {
          tags listing=#true
        }
      }
      generate {
        feed { formats "rss"; terms #true }
      }
      """#
    "content/posts/a.typ" #"""
      #let frontmatter = (title: "A", date: datetime(year: 2024, month: 1, day: 2), tags: ("rust",),)
      body
      """#
    "content/posts/b.typ" #"""
      #let frontmatter = (title: "B", date: datetime(year: 2024, month: 1, day: 3), tags: ("typst",),)
      body
      """#
  }
  expect {
    ok
    file "tags/rust/rss.xml" {
      contains "https://example.com/posts/a/"
      missing "/posts/b/"
      contains "<title>T - Tags: rust</title>"
      // A term feed identifies itself by its own URL, so an aggregator does not
      // merge it with the site feed.
      contains "<link>https://example.com/tags/rust/</link>"
    }
    file "tags/typst/rss.xml"
    file "rss.xml" {
      contains "/posts/a/"
      contains "/posts/b/"
    }
  }
}

scenario "term feeds stay off by default" {
  files {
    "config.kdl" #"""
      site "T"
      url "https://example.com"
      content {
        taxonomies {
          tags listing=#true
        }
      }
      generate {
        feed { formats "rss" }
      }
      """#
    "content/posts/a.typ" #"""
      #let frontmatter = (title: "A", date: datetime(year: 2024, month: 1, day: 2), tags: ("rust",),)
      body
      """#
  }
  expect {
    ok
    file "rss.xml"
    absent "tags/rust/rss.xml"
  }
}

// The site feed carries everything dated, which is the wrong granularity for a
// site that publishes more than one kind of thing. A collection feed sits
// beside that collection's index and carries only its members.
scenario "a collection feed sits beside its index and carries only its members" {
  files {
    "config.kdl" #"""
      site "T"
      url "https://example.com"
      content {
        collections {
          posts { feed #true; paginate { template "list.typ" } }
          notes { paginate { template "list.typ" } }
        }
      }
      generate {
        feed { formats "rss" }
      }
      """#
    "templates/list.typ" #"""
      #let list(page, body) = body
      """#
    "content/posts/a.typ" #"""
      #let frontmatter = (title: "A", date: datetime(year: 2024, month: 1, day: 2),)
      body
      """#
    "content/notes/n.typ" #"""
      #let frontmatter = (title: "N", date: datetime(year: 2024, month: 1, day: 3),)
      body
      """#
  }
  expect {
    ok
    file "posts/rss.xml" {
      contains "https://example.com/posts/a/"
      missing "/notes/n/"
      contains "<title>T - Posts</title>"
      // Its home is the index it sits beside, so an aggregator neither merges
      // it with the site feed nor links a reader to a page nobody wrote.
      contains "<link>https://example.com/posts/</link>"
    }
    // A collection that did not ask gets none, which is the point of the key
    // being per collection: a `docs` tree wants no feed.
    absent "notes/rss.xml"
    file "rss.xml" {
      contains "/posts/a/"
      contains "/notes/n/"
    }
    // The whole reason for having one: a reader on a post is offered the posts,
    // not the everything.
    file "posts/a/index.html" {
      contains #"href="https://example.com/posts/rss.xml""#
      contains #"title="T - Posts""#
      contains #"href="https://example.com/rss.xml""#
    }
    // A page outside the collection advertises the site feed alone.
    file "notes/n/index.html" { missing "/posts/rss.xml" }
  }
}

// A `mount` moves the index, and the feed follows it: the two cannot disagree
// about where the collection lives.
scenario "a mounted collection carries its feed at the mount" {
  files {
    "config.kdl" #"""
      site "T"
      url "https://example.com"
      content {
        collections {
          posts { feed #true; paginate { mount "/blog/"; template "list.typ" } }
        }
      }
      generate {
        feed { formats "rss" }
      }
      """#
    "templates/list.typ" #"""
      #let list(page, body) = body
      """#
    "content/posts/a.typ" #"""
      #let frontmatter = (title: "A", date: datetime(year: 2024, month: 1, day: 2),)
      body
      """#
  }
  expect {
    ok
    file "blog/rss.xml" { contains "<link>https://example.com/blog/</link>" }
    absent "posts/rss.xml"
    file "posts/a/index.html" { contains #"href="https://example.com/blog/rss.xml""# }
  }
}

// Mounted at the root, a collection wants the file the site feed is already
// written to. One file cannot be two feeds, and overwriting the site feed with
// the narrower one is the outcome nobody asked for.
scenario "a collection mounted at the site root is told it has no feed of its own" {
  files {
    "config.kdl" #"""
      site "T"
      url "https://example.com"
      content {
        collections {
          posts { feed #true; paginate { mount "/"; template "list.typ" } }
        }
      }
      generate {
        feed { formats "rss" }
      }
      """#
    "templates/list.typ" #"""
      #let list(page, body) = body
      """#
    "content/posts/a.typ" #"""
      #let frontmatter = (title: "A", date: datetime(year: 2024, month: 1, day: 2),)
      body
      """#
  }
  expect {
    ok
    warns "baudelaire::feed::mounted"
    // The site feed keeps the path, and says what it always said.
    file "rss.xml" { contains "<title>T</title>" }
    // And no page offers a second subscription to that same file, which would
    // contradict the warning on every page of the site.
    file "posts/a/index.html" { missing "T - Posts" }
  }
}

// Each language's feed sits under its own prefix, and a member advertises the
// one in its own language.
scenario "a collection feed is written per language" {
  files {
    "config.kdl" #"""
      site "T"
      url "https://example.com"
      lang "en"
      languages {
        en { }
        fr { }
      }
      content {
        collections {
          posts { feed #true; paginate { template "list.typ" } }
        }
      }
      generate {
        feed { formats "rss" }
      }
      """#
    "templates/list.typ" #"""
      #let list(page, body) = body
      """#
    "content/posts/a.typ" #"""
      #let frontmatter = (title: "A", date: datetime(year: 2024, month: 1, day: 2),)
      body
      """#
    "content/posts/a.fr.typ" #"""
      #let frontmatter = (title: "A en français", date: datetime(year: 2024, month: 1, day: 2),)
      corps
      """#
  }
  expect {
    ok
    file "posts/rss.xml" {
      contains "https://example.com/posts/a/"
      missing "/fr/posts/a/"
    }
    file "fr/posts/rss.xml" {
      contains "https://example.com/fr/posts/a/"
      missing #"<link>https://example.com/posts/a/</link>"#
    }
    file "fr/posts/a/index.html" { contains #"href="https://example.com/fr/posts/rss.xml""# }
    // The generated index is a member of no feed, but it advertises its own
    // language's: its collection is the language-scoped section internally, and
    // a reader must not be handed the default language's feed because of it.
    file "fr/posts/index.html" { contains #"href="https://example.com/fr/posts/rss.xml""# }
  }
}

// A feed with nothing dated writes no file, so nothing may advertise one.
scenario "an undated collection advertises no feed it does not have" {
  files {
    "config.kdl" #"""
      site "T"
      url "https://example.com"
      content {
        collections {
          docs { feed #true; paginate { template "list.typ" } }
        }
      }
      generate {
        feed { formats "rss" }
      }
      """#
    "templates/list.typ" #"""
      #let list(page, body) = body
      """#
    "content/docs/a.typ" #"""
      #let frontmatter = (title: "A",)
      body
      """#
  }
  expect {
    ok
    absent "docs/rss.xml"
    // Known gap, pinned so it is a decision rather than a surprise: the tag is
    // written from the config, which cannot know the collection turned out to
    // have nothing dated in it. Asking the page set here would tie every page's
    // cache identity to every other page's dates.
    file "docs/a/index.html" { contains "/docs/rss.xml" }
  }
}

// Two collections asking, one of them unable: the row cannot name which, so it
// must not claim the other's feed went unwritten either.
scenario "one collection without an index does not cost the other its feed" {
  files {
    "config.kdl" #"""
      site "T"
      url "https://example.com"
      content {
        collections {
          posts { feed #true; paginate { template "list.typ" } }
          docs { feed #true }
        }
      }
      generate {
        feed { formats "rss" }
      }
      """#
    "templates/list.typ" #"""
      #let list(page, body) = body
      """#
    "content/posts/a.typ" #"""
      #let frontmatter = (title: "A", date: datetime(year: 2024, month: 1, day: 2),)
      body
      """#
    "content/docs/d.typ" #"""
      #let frontmatter = (title: "D", date: datetime(year: 2024, month: 1, day: 3),)
      body
      """#
  }
  expect {
    ok
    warns "baudelaire::config::inert"
    file "posts/rss.xml" { contains "/posts/a/" }
    absent "docs/rss.xml"
  }
}

// The collection key sits far from `generate { feed { } }`, so asking there and
// naming no format is the likely first-use mistake.
scenario "a collection feed with no configured format is reported as inert" {
  files {
    "config.kdl" #"""
      site "T"
      url "https://example.com"
      content {
        collections {
          posts { feed #true; paginate { template "list.typ" } }
        }
      }
      """#
    "templates/list.typ" #"""
      #let list(page, body) = body
      """#
    "content/posts/a.typ" #"""
      #let frontmatter = (title: "A", date: datetime(year: 2024, month: 1, day: 2),)
      body
      """#
  }
  expect {
    ok
    warns "baudelaire::config::inert"
    absent "posts/rss.xml"
    absent "rss.xml"
  }
}

// A feed's home is the collection's index, so a collection with none has
// nowhere to put one and is told rather than silently writing nothing.
scenario "a collection feed without an index is reported as inert" {
  files {
    "config.kdl" #"""
      site "T"
      url "https://example.com"
      content {
        collections {
          posts { feed #true }
        }
      }
      generate {
        feed { formats "rss" }
      }
      """#
    "content/posts/a.typ" #"""
      #let frontmatter = (title: "A", date: datetime(year: 2024, month: 1, day: 2),)
      body
      """#
  }
  expect {
    ok
    warns "baudelaire::config::inert"
    absent "posts/rss.xml"
  }
}

scenario "only the configured feed format is emitted: atom" {
  files {
    "config.kdl" #"""
      site "T"
      url "https://example.com"
      paths {
        content "content"
        dist "public"
      }
      generate {
        feed {
            formats "atom"
          }
      }
      """#
    "content/posts/a.typ" #"""
      #let frontmatter = (title: "A", slug: "a", date: datetime(year: 2024, month: 1, day: 2),)
      body
      """#
  }
  expect {
    ok
    file "atom.xml" {
      contains "http://www.w3.org/2005/Atom"
      contains "<entry>"
    }
    absent "rss.xml"
  }
}

scenario "only the configured feed format is emitted: json" {
  files {
    "config.kdl" #"""
      site "T"
      url "https://example.com"
      paths {
        content "content"
        dist "public"
      }
      generate {
        feed {
            formats "json"
          }
      }
      """#
    "content/posts/a.typ" #"""
      #let frontmatter = (title: "A", slug: "a", date: datetime(year: 2024, month: 1, day: 2),)
      body
      """#
  }
  expect {
    ok
    file "feed.json" {
      contains "https://jsonfeed.org/version/1.1"
      contains #""url":"https://example.com/posts/a/""#
      contains #""date_published":"2024-01-02T00:00:00Z""#
      contains #""feed_url":"https://example.com/feed.json""#
    }
    absent "rss.xml"
    absent "atom.xml"
  }
}

scenario "nothing syndicated is emitted without a url" {
  files {
    "config.kdl" #"""
      site "T"
      paths {
        content "content"
        dist "public"
      }
      """#
    "content/posts/a.typ" #"""
      #let frontmatter = (title: "A", date: datetime(year: 2024, month: 1, day: 2),)
      body
      """#
  }
  expect {
    ok
    absent "sitemap.xml"
    absent "rss.xml"
  }
}

scenario "a site that opts into neither gets neither, silently" {
  files {
    "config.kdl" #"""
      site "T"
      url "https://example.com"
      paths {
        content "content"
        dist "public"
      }
      """#
    "content/index.typ" #"""
      #let frontmatter = (title: "H",)
      home
      """#
  }
  expect {
    ok
    absent "sitemap.xml"
    absent "rss.xml"
  }
}

scenario "a sitemap without a url is a request that cannot be met" {
  files {
    "config.kdl" #"""
      site "T"
      paths {
        content "content"
        dist "public"
      }
      generate {
        sitemap #true
      }
      """#
    "content/index.typ" #"""
      #let frontmatter = (title: "H",)
      home
      """#
  }
  expect {
    fails { code "baudelaire::output::url_required" }
  }
}

scenario "a feed without a url is a request that cannot be met" {
  files {
    "config.kdl" #"""
      site "T"
      paths {
        content "content"
        dist "public"
      }
      generate {
        feed { formats "rss" }
      }
      """#
    "content/index.typ" #"""
      #let frontmatter = (title: "H",)
      home
      """#
  }
  expect {
    fails { code "baudelaire::output::url_required" }
  }
}

// An item that carries nothing but a title is a wall of bare titles in a reader,
// which is what every feed used to be: no description, no categories, and one
// date doing the work of two.
scenario "a feed item carries its description, categories and both dates" {
  files {
    "config.kdl" #"""
      site "T"
      url "https://example.com"
      content {
        taxonomies {
          tags
        }
      }
      generate {
        feed { formats "rss" "atom" "json" }
      }
      """#
    "content/posts/a.typ" #"""
      #let frontmatter = (
        title: "A",
        date: datetime(year: 2024, month: 1, day: 2),
        updated: datetime(year: 2026, month: 3, day: 4),
        description: "what the post is about",
        tags: ("rust", "typst"),
      )
      body
      """#
  }
  expect {
    ok
    file "rss.xml" {
      contains "<description>what the post is about</description>"
      contains "<category>rust</category>"
      contains "<category>typst</category>"
      // RSS has only a publication date, so the rewrite has nowhere to go here.
      contains "<pubDate>Tue, 02 Jan 2024 00:00:00 +0000</pubDate>"
    }
    file "atom.xml" {
      contains "<summary>what the post is about</summary>"
      contains #"<category term="rust"/>"#
      // Atom separates them: `updated` is the rewrite, `published` the original.
      contains "<updated>2026-03-04T00:00:00Z</updated>"
      contains "<published>2024-01-02T00:00:00Z</published>"
    }
    file "feed.json" {
      contains #""summary":"what the post is about""#
      contains #""date_published":"2024-01-02T00:00:00Z""#
      contains #""date_modified":"2026-03-04T00:00:00Z""#
      contains #""tags":["rust","typst"]"#
    }
  }
}

// `updated` is when the page last changed; `date` is when it went up and is what
// orders every listing. The sitemap wants the former, and used to be handed the
// latter, so a rewritten page told crawlers it had not moved since publication.
scenario "the sitemap reports the rewrite date, not the publication date" {
  files {
    "config.kdl" #"""
      site "T"
      url "https://example.com"
      generate {
        sitemap #true
      }
      """#
    "content/posts/rewritten.typ" #"""
      #let frontmatter = (
        title: "Rewritten",
        date: datetime(year: 2023, month: 5, day: 6),
        updated: datetime(year: 2026, month: 7, day: 8),
      )
      body
      """#
    "content/posts/untouched.typ" #"""
      #let frontmatter = (title: "Untouched", date: datetime(year: 2023, month: 5, day: 6),)
      body
      """#
  }
  expect {
    ok
    file "sitemap.xml" {
      contains "<lastmod>2026-07-08</lastmod>"
      // A page that never changed still reports its publication date.
      contains "<lastmod>2023-05-06</lastmod>"
    }
  }
}

// The feeds existed and nothing pointed at them: no reader, extension or
// subscribe button could find one. typst-html owns `<head>`, so a layout could
// not add the tag either.
scenario "every page advertises the feeds in its head" {
  files {
    "config.kdl" #"""
      site "T"
      url "https://example.com"
      generate {
        feed { formats "rss" "json" }
      }
      """#
    "content/posts/a.typ" #"""
      #let frontmatter = (title: "A", date: datetime(year: 2024, month: 1, day: 2),)
      body
      """#
  }
  expect {
    ok
    file "posts/a/index.html" {
      contains #"<link rel="alternate" type="application/rss+xml" title="T" href="https://example.com/rss.xml">"#
      contains #"<link rel="alternate" type="application/feed+json" title="T" href="https://example.com/feed.json">"#
      // Only the configured formats are advertised.
      missing "application/atom+xml"
    }
  }
}

// A site with no feeds must not advertise any.
scenario "a site without feeds advertises none" {
  files {
    "config.kdl" #"""
      site "T"
      url "https://example.com"
      """#
    "content/index.typ" #"""
      #let frontmatter = (title: "H",)
      home
      """#
  }
  expect {
    ok
    file "index.html" { missing "application/rss+xml" }
  }
}

// A feed channel has to say what the site is. RSS makes the element mandatory,
// so before there was a key for it every feed repeated its own title.
scenario "the site description fills every feed's channel blurb" {
  files {
    "config.kdl" #"""
      site "T"
      description "Notes from the road."
      url "https://example.com"
      generate {
        feed { formats "rss" "atom" "json" }
        llms
      }
      """#
    "content/posts/a.typ" #"""
      #let frontmatter = (title: "A", date: datetime(year: 2024, month: 1, day: 2),)
      body
      """#
  }
  expect {
    ok
    file "rss.xml" { contains "<description>Notes from the road.</description>" }
    file "atom.xml" { contains "<subtitle>Notes from the road.</subtitle>" }
    file "feed.json" { contains #""description":"Notes from the road.""# }
    // `llms { summary }` answers the same question, so an unset one reads the
    // site's description rather than leaving the blockquote out.
    file "llms.txt" { contains "> Notes from the road." }
  }
}

// Unset, a channel still needs the element: it falls back to the feed's title,
// which is what every feed carried before the key existed.
scenario "a feed with no description falls back to its title" {
  files {
    "config.kdl" #"""
      site "T"
      url "https://example.com"
      generate { feed { formats "rss" "atom" } }
      """#
    "content/posts/a.typ" #"""
      #let frontmatter = (title: "A", date: datetime(year: 2024, month: 1, day: 2),)
      body
      """#
  }
  expect {
    ok
    file "rss.xml" { contains "<description>T</description>" }
    // Atom's subtitle is optional, so nothing stands in for an absent one.
    file "atom.xml" { missing "<subtitle>" }
  }
}

// Per language, beside `site` and `author`: a French feed carrying an English
// blurb is the bug this override exists to prevent.
scenario "a language describes the site in its own words" {
  files {
    "config.kdl" #"""
      site "T"
      description "Notes from the road."
      url "https://example.com"
      lang "en"
      languages {
        fr { site "T"; description "Notes de voyage." }
      }
      generate { feed { formats "rss" } }
      """#
    "content/posts/a.typ" #"""
      #let frontmatter = (title: "A", date: datetime(year: 2024, month: 1, day: 2),)
      body
      """#
    "content/posts/a.fr.typ" #"""
      #let frontmatter = (title: "A", date: datetime(year: 2024, month: 1, day: 2),)
      corps
      """#
  }
  expect {
    ok
    file "rss.xml" { contains "<description>Notes from the road.</description>" }
    file "fr/rss.xml" { contains "<description>Notes de voyage.</description>" }
  }
}

// A site arriving from Hugo (`index.xml`) or Jekyll (`feed.xml`) keeps its
// subscribers only if the file keeps its name: a reader fetches the file and
// never renders a redirect stub.
scenario "a feed is written, advertised and identified under its configured name" {
  files {
    "config.kdl" #"""
      site "T"
      url "https://example.com"
      generate {
        feed {
          formats "rss" "atom"
          names { rss "index.xml" }
        }
      }
      """#
    "content/posts/a.typ" #"""
      #let frontmatter = (title: "A", date: datetime(year: 2024, month: 1, day: 2),)
      body
      """#
  }
  expect {
    ok
    file "index.xml" { contains "<item>" }
    absent "rss.xml"
    // The head tag points at the same file the build wrote.
    file "posts/a/index.html" {
      contains #"type="application/rss+xml" title="T" href="https://example.com/index.xml""#
    }
    // A format with no override keeps its conventional name.
    file "atom.xml" { contains "<id>https://example.com/atom.xml</id>" }
  }
}

// A feed carried the one-line summary and nothing else, so a reader that renders
// entries in place had nothing to render. `content "full"` adds the page's
// prose, taken from `html { region }`: the same part of the page the search
// index reads, so the site chrome around it never travels.
scenario "a full feed carries each entry's prose beside its summary" {
  files {
    "config.kdl" #"""
      site "T"
      url "https://s.example"
      paths {
        content "content"
        dist "public"
        templates "templates"
      }
      generate {
        feed {
          formats "rss" "atom" "json"
          content "full"
        }
      }
      """#
    "templates/page.typ" #"""
      #let page(data, body) = {
        html.elem("header")[site chrome]
        html.elem("main", body)
        html.elem("footer")[footer chrome]
      }
      """#
    "content/posts/a.typ" #"""
      #let frontmatter = (
        title: "Alpha",
        date: "2026-01-02",
        description: "The short one.",
        template: "page.typ",
      )
      real prose
      """#
  }
  expect {
    ok
    file "rss.xml" {
      // Escaped markup in `content:encoded`, with its namespace declared.
      contains "xmlns:content=\"http://purl.org/rss/1.0/modules/content/\""
      contains "<content:encoded>"
      contains "real prose"
      // The summary is not replaced by it.
      contains "<description>The short one.</description>"
      // Chrome outside the region never travels.
      missing "site chrome"
      missing "footer chrome"
    }
    file "atom.xml" {
      contains "<content type=\"html\">"
      contains "real prose"
      contains "<summary>The short one.</summary>"
      missing "footer chrome"
    }
    file "feed.json" {
      contains "content_html"
      contains "real prose"
      contains "The short one."
      missing "footer chrome"
    }
  }
}

// The region a feed reads may not be there at all: a site with no template
// emits no `<main>`. The search index counts such a page whole, which is right
// for an index and catastrophic for a feed, whose entries would each become the
// whole document. The body narrows to `<body>` instead.
scenario "a full feed on a page with no region carries prose, not the document" {
  files {
    "config.kdl" #"""
      site "T"
      url "https://s.example"
      paths {
        content "content"
        dist "public"
      }
      generate {
        feed { formats "rss"; content "full" }
      }
      """#
    "content/posts/a.typ" #"""
      #let frontmatter = (
        title: "Alpha",
        date: "2026-01-02",
        description: "The short one.",
      )
      real prose
      """#
  }
  expect {
    ok
    file "rss.xml" {
      contains "<content:encoded>"
      contains "real prose"
      // Neither the doctype nor anything out of the generated `<head>`.
      missing "DOCTYPE"
      missing "charset"
      missing "og:title"
    }
  }
}

// `ignore` names the chrome a layout puts *inside* its region. It reached the
// search index and not the feed, so a sidebar inside `<main>` travelled.
scenario "a full feed drops the chrome inside its region" {
  files {
    "config.kdl" #"""
      site "T"
      url "https://s.example"
      paths {
        content "content"
        dist "public"
        templates "templates"
      }
      html {
        region { element "main"; ignore "nav" }
      }
      generate {
        feed { formats "rss"; content "full" }
      }
      """#
    "templates/page.typ" #"""
      #let page(data, body) = html.elem("main", {
        html.elem("nav")[sidebar chrome]
        body
      })
      """#
    "content/posts/a.typ" #"""
      #let frontmatter = (
        title: "Alpha",
        date: "2026-01-02",
        description: "The short one.",
        template: "page.typ",
      )
      real prose
      """#
  }
  expect {
    ok
    file "rss.xml" {
      contains "real prose"
      missing "sidebar chrome"
    }
  }
}

// And the default is unchanged: the summary alone, with no namespace declared
// for a body that is not there.
scenario "a summary feed carries no body" {
  files {
    "config.kdl" #"""
      site "T"
      url "https://s.example"
      paths {
        content "content"
        dist "public"
      }
      generate {
        feed { formats "rss" "json" }
      }
      """#
    "content/posts/a.typ" #"""
      #let frontmatter = (
        title: "Alpha",
        date: "2026-01-02",
        description: "The short one.",
      )
      real prose
      """#
  }
  expect {
    ok
    file "rss.xml" {
      contains "<description>The short one.</description>"
      missing "content:encoded"
      missing "real prose"
    }
    file "feed.json" {
      missing "content_html"
      missing "real prose"
    }
  }
}
