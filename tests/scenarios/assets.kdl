// The asset pipeline: inlining, minification, bundling.

scenario "embed inlines a local asset as a data uri" {
  files {
    "config.kdl" #"""
      site "T"
      paths {
        content "content"
        dist "public"
        assets "assets"
      }
      html {
        embed #true
      }
      """#
    "assets/style.css" #"""
      body{color:red}
      """#
    "content/posts/a.typ" #"""
      #let frontmatter = (title: "A",)
      #html.elem("link", attrs: (rel: "stylesheet", href: "/assets/style.css"))
      """#
  }
  expect {
    ok
    file "posts/a/index.html" {
      contains "data:text/css;base64,"
      missing #"href="/assets/style.css""#
    }
  }
}

scenario "minify compacts css" {
  requires "css"
  files {
    "config.kdl" #"""
      site "T"
      paths {
        content "content"
        dist "public"
        assets "assets"
      }
      assets {
        minify #true
      }
      """#
    "assets/style.css" #"""
      /* a comment */
      body {
        color: red;
      }
      """#
    "content/posts/a.typ" #"""
      #let frontmatter = (title: "A",)
      body
      """#
  }
  expect {
    ok
    file "assets/style.css" {
      missing "/*"
      missing "\n"
      contains "red"
    }
  }
}

scenario "bundling inlines js imports and drops the partials" {
  requires "js"
  files {
    "config.kdl" #"""
      site "T"
      paths {
        content "content"
        dist "public"
        assets "assets"
      }
      assets {
        bundle #true
      }
      """#
    "assets/_util.js" #"""
      export function hi() { return 42; }
      """#
    "assets/main.js" #"""
      import { hi } from './_util.js';
      console.log(hi());
      """#
    "content/posts/a.typ" #"""
      #let frontmatter = (title: "A",)
      body
      """#
  }
  expect {
    ok
    // The imported function body is bundled into the entry...
    file "assets/main.js" { contains "42" }
    // ...and the partial is never emitted standalone.
    absent "assets/_util.js"
  }
}

scenario "a typescript entry is bundled to js with its types stripped" {
  requires "js"
  files {
    "config.kdl" #"""
      site "T"
      paths {
        content "content"
        dist "public"
        assets "assets"
      }
      assets {
        bundle #true
      }
      """#
    "assets/_util.cts" #"""
      export function hi(): number { return 42; }
      """#
    "assets/main.mts" #"""
      import { hi } from './_util.cts';
      const answer: number = hi();
      console.log(answer);
      """#
    "content/posts/a.typ" #"""
      #let frontmatter = (title: "A",)
      body
      """#
  }
  expect {
    ok
    // Served as JavaScript, whatever the entry was written in...
    file "assets/main.js" {
      contains "42"
      missing ": number"
    }
    // ...and neither the entry nor the partial is left behind unbundled.
    absent "assets/main.mts"
    absent "assets/_util.cts"
  }
}

scenario "a pinned tsconfig resolves paths and the jsx runtime" {
  requires "js"
  files {
    "config.kdl" #"""
      site "T"
      paths {
        content "content"
        dist "public"
        assets "assets"
      }
      assets {
        bundle #true
        tsconfig "tsconfig.json"
      }
      """#
    "tsconfig.json" #"""
      {
        "compilerOptions": {
          "jsx": "react-jsx",
          "jsxImportSource": "@runtime",
          "baseUrl": ".",
          "paths": {
            "@runtime/jsx-runtime": ["./assets/_runtime.ts"],
            "@util": ["./assets/_util.ts"]
          }
        }
      }
      """#
    "assets/_runtime.ts" #"""
      export const jsx = (tag: string, props: Record<string, unknown>) => ({ tag, props });
      """#
    "assets/_util.ts" #"""
      export const answer: number = 42;
      """#
    "assets/main.tsx" #"""
      import { answer } from "@util";
      export const view = (label: string) => <p class="tag">{label}</p>;
      console.log(view(String(answer)));
      """#
    "content/posts/a.typ" #"""
      #let frontmatter = (title: "A",)
      body
      """#
  }
  expect {
    ok
    file "assets/main.js" {
      // The `paths` alias resolved, so the partial is inlined...
      contains "42"
      // ...and JSX went through the runtime the config named, not react's.
      missing "react/jsx-runtime"
      missing "<p class"
    }
  }
}

scenario "a tsconfig path that is not there names the setting" {
  requires "js"
  files {
    "config.kdl" #"""
      site "T"
      paths {
        content "content"
        dist "public"
        assets "assets"
      }
      assets {
        bundle #true
        tsconfig "tooling/tsconfig.json"
      }
      """#
    "assets/main.ts" #"""
      console.log(1);
      """#
    "content/posts/a.typ" #"""
      #let frontmatter = (title: "A",)
      body
      """#
  }
  expect {
    fails { code "baudelaire::asset::tsconfig" }
  }
}

scenario "a tsconfig without bundling is inert" {
  requires "js"
  files {
    "config.kdl" #"""
      site "T"
      paths {
        content "content"
        dist "public"
        assets "assets"
      }
      assets {
        tsconfig "tsconfig.json"
      }
      """#
    "tsconfig.json" #"""
      { "compilerOptions": { "jsx": "react-jsx" } }
      """#
    "content/posts/a.typ" #"""
      #let frontmatter = (title: "A",)
      body
      """#
  }
  expect {
    ok
    warns "baudelaire::config::inert"
  }
}

scenario "a type declaration is read, not emitted" {
  requires "js"
  files {
    "config.kdl" #"""
      site "T"
      paths {
        content "content"
        dist "public"
        assets "assets"
      }
      assets {
        bundle #true
      }
      """#
    "assets/globals.d.ts" #"""
      declare module "virtual:answer" {
        export const answer: number;
      }
      """#
    "assets/main.ts" #"""
      console.log(42);
      """#
    "content/posts/a.typ" #"""
      #let frontmatter = (title: "A",)
      body
      """#
  }
  expect {
    ok
    file "assets/main.js" { contains "42" }
    // Types are not code: the declaration used to be bundled on its own and
    // written out as an empty `globals.d.js`.
    absent "assets/globals.d.js"
    absent "assets/globals.d.ts"
  }
}

// The asset tree is an input tree as well as an output tree, and nothing in an
// extension says which. A default-config site published its own TypeScript
// (which no browser runs), its Sass sources, and the `_partial` files the
// bundler's own convention already called import-only, because that convention
// applied only while bundling.
scenario "the pipeline publishes artifacts, never the sources it read" {
  files {
    "config.kdl" #"""
      site "T"
      url "https://example.com"
      """#
    "assets/app.ts" #"""
      const secret: string = "internal";
      export function go(): void { console.log(secret); }
      """#
    "assets/_partial.ts" #"""
      export const helper = 1;
      """#
    "assets/globals.d.ts" #"""
      declare const VERSION: string;
      """#
    "assets/style.scss" #"""
      $ink: #222;
      body { color: $ink; }
      """#
    "assets/_brand.css" #"""
      :root { --brand: #c00; }
      """#
    "assets/site.css" #"""
      body { margin: 0; }
      """#
    "content/index.typ" #"""
      #let frontmatter = (title: "H",)
      home
      """#
  }
  expect {
    ok
    // The one file that is an artifact.
    file "assets/site.css"
    absent "assets/app.ts"
    absent "assets/_partial.ts"
    absent "assets/globals.d.ts"
    absent "assets/style.scss"
    absent "assets/_brand.css"
  }
}

// Bundling turns a script source into an artifact, and only that: the partial
// it imports and the declarations beside it stay out.
scenario "bundling publishes the bundle and none of its inputs" {
  requires "js"
  files {
    "config.kdl" #"""
      site "T"
      url "https://example.com"
      assets { bundle #true }
      """#
    "assets/app.ts" #"""
      import { helper } from "./_partial";
      export function go(): number { return helper; }
      """#
    "assets/_partial.ts" #"""
      export const helper = 1;
      """#
    "content/index.typ" #"""
      #let frontmatter = (title: "H",)
      home
      """#
  }
  expect {
    ok
    // Tree-shaken and inlined: the partial's value survives, its module does not.
    file "assets/app.js" { contains "return 1" }
    absent "assets/app.ts"
    absent "assets/_partial.js"
    absent "assets/_partial.ts"
  }
}

// Source maps are the one asset output that is a *second* file, named after the
// first and naming it back. The pair only works if the link survives
// fingerprinting, which renames the file the map is named after, so both halves
// are asserted together rather than either alone.
scenario "a bundled script ships the map it was built from" {
  requires "js"
  files {
    "config.kdl" #"""
      site "T"
      paths {
        content "content"
        dist "public"
        assets "assets"
      }
      assets {
        bundle #true
        sourcemap "external"
      }
      """#
    "assets/_util.js" #"""
      export function hi() { return 42; }
      """#
    "assets/main.js" #"""
      import { hi } from './_util.js';
      console.log(hi());
      """#
    "content/index.typ" #"""
      #let frontmatter = (title: "A",)
      body
      """#
  }
  expect {
    ok
    file "assets/main.js" {
      contains "sourceMappingURL=main.js.map"
    }
    file "assets/main.js.map" {
      // The sources travel inside the map: the pipeline never publishes a
      // partial, so a map that only named them would resolve to nothing.
      contains "sourcesContent"
      contains "return 42"
    }
  }
}

scenario "a stylesheet ships the map it was built from" {
  requires "css"
  files {
    "config.kdl" #"""
      site "T"
      paths {
        content "content"
        dist "public"
        assets "assets"
      }
      assets {
        minify #true
        sourcemap "external"
      }
      """#
    "assets/app.css" #"""
      .a { color: red; }
      .b { color: blue; }
      """#
    "content/index.typ" #"""
      #let frontmatter = (title: "A",)
      body
      """#
  }
  expect {
    ok
    file "assets/app.css" {
      // The css comment form, not the `//` one a script takes.
      contains "/*# sourceMappingURL=app.css.map */"
    }
    file "assets/app.css.map" {
      contains "sourcesContent"
      contains "color: red"
    }
  }
}

// Without the flag nothing is written and nothing is linked, which is what
// keeps a site's sources unpublished by default.
scenario "no source map is written unless the site asks" {
  requires "css"
  files {
    "config.kdl" #"""
      site "T"
      paths {
        content "content"
        dist "public"
        assets "assets"
      }
      assets {
        minify #true
      }
      """#
    "assets/app.css" #"""
      .a { color: red; }
      """#
    "content/index.typ" #"""
      #let frontmatter = (title: "A",)
      body
      """#
  }
  expect {
    ok
    file "assets/app.css" { missing "sourceMappingURL" }
    absent "assets/app.css.map"
  }
}

// The value is a posture, and each one is a different answer to "who is meant
// to read this map". `hidden` writes it and links to it from nothing, which is
// the shape for uploading to an error tracker.
scenario "a hidden map is written but nothing points at it" {
  requires "css"
  files {
    "config.kdl" #"""
      site "T"
      paths {
        content "content"
        dist "public"
        assets "assets"
      }
      assets {
        minify #true
        sourcemap "hidden"
      }
      """#
    "assets/app.css" #"""
      .a { color: red; }
      """#
    "content/index.typ" #"""
      #let frontmatter = (title: "A",)
      body
      """#
  }
  expect {
    ok
    file "assets/app.css" { missing "sourceMappingURL" }
    file "assets/app.css.map" { contains "sourcesContent" }
  }
}

scenario "an inline map travels inside the asset instead of beside it" {
  requires "css"
  files {
    "config.kdl" #"""
      site "T"
      paths {
        content "content"
        dist "public"
        assets "assets"
      }
      assets {
        minify #true
        sourcemap "inline"
      }
      """#
    "assets/app.css" #"""
      .a { color: red; }
      """#
    "content/index.typ" #"""
      #let frontmatter = (title: "A",)
      body
      """#
  }
  expect {
    ok
    file "assets/app.css" {
      contains "sourceMappingURL=data:application/json"
    }
    absent "assets/app.css.map"
  }
}

// The line sets every kind and the block narrows from there, so one line can
// say "maps everywhere except styles" without repeating itself.
scenario "the line sets every kind and the block narrows one" {
  requires "css"
  files {
    "config.kdl" #"""
      site "T"
      paths {
        content "content"
        dist "public"
        assets "assets"
      }
      assets {
        minify #true
        bundle #true
        sourcemap "external" {
          styles "off"
        }
      }
      """#
    "assets/app.css" #"""
      .a { color: red; }
      """#
    "assets/main.js" #"""
      console.log(1);
      """#
    "content/index.typ" #"""
      #let frontmatter = (title: "A",)
      body
      """#
  }
  expect {
    ok
    file "assets/app.css" { missing "sourceMappingURL" }
    absent "assets/app.css.map"
  }
}

// Naming a browser floor turns lightningcss's *transform* on: nesting is
// flattened for a browser that cannot read it. Independent of minification, so
// the output here is still readable.
scenario "targets compile css down to the browsers named" {
  requires "css"
  files {
    "config.kdl" #"""
      site "T"
      paths {
        content "content"
        dist "public"
        assets "assets"
      }
      assets {
        targets {
          chrome "80"
          safari "13.1"
        }
      }
      """#
    "assets/style.css" #"""
      .card {
        color: red;
        & .title {
          color: blue;
        }
      }
      """#
    "content/posts/a.typ" #"""
      #let frontmatter = (title: "A",)
      body
      """#
  }
  expect {
    ok
    file "assets/style.css" {
      // The nested rule is lifted out, because Chrome 80 has no nesting.
      contains ".card .title"
      // and the output is not minified: `targets` is not `minify`.
      contains "\n"
    }
  }
}

// Without a floor there is nothing to compile down to, so a sheet the browsers
// can read is left as it was written.
scenario "css is left as written when no browser is named" {
  requires "css"
  files {
    "config.kdl" #"""
      site "T"
      paths {
        content "content"
        dist "public"
        assets "assets"
      }
      """#
    "assets/style.css" #"""
      .card {
        & .title {
          color: blue;
        }
      }
      """#
    "content/posts/a.typ" #"""
      #let frontmatter = (title: "A",)
      body
      """#
  }
  expect {
    ok
    file "assets/style.css" { contains "& .title" }
  }
}

// The two halves of `minify` are separate asks: a site may want small
// stylesheets and readable scripts.
scenario "minify names the kinds it applies to" {
  requires "css"
  files {
    "config.kdl" #"""
      site "T"
      paths {
        content "content"
        dist "public"
        assets "assets"
      }
      assets {
        minify {
          js #false
        }
      }
      """#
    "assets/style.css" #"""
      /* a comment */
      body {
        color: red;
      }
      """#
    "content/posts/a.typ" #"""
      #let frontmatter = (title: "A",)
      body
      """#
  }
  expect {
    ok
    // The block's presence still turns css on; only js was taken back.
    file "assets/style.css" { contains "body{color:red}" }
  }
}
