// Markdown pages: a `.md` file under `content/` is a page like any other.
//
// The point of these is not that markdown renders -- it is that a markdown page
// is indistinguishable from a typst one by the time anything downstream looks
// at it. Its frontmatter reaches the template as the same dict, its permalink
// is built the same way, and it takes part in the link graph.

scenario "a markdown page builds like any other" {
  requires "markdown"
  files {
    "config.kdl" #"""
      site "Test"
      paths {
        content "content"
        dist "public"
        templates "templates"
      }
      """#
    "templates/page.typ" #"""
      #let page(page, body) = html.elem("main", {
        html.elem("h1", page.frontmatter.title)
        body
      })
      """#
    "content/hello.md" #"""
      ;;;
      title "Hello"
      template "page.typ"
      ;;;

      Ordinary **prose** with `code` and a [link](/other/).

      - one
      - two
      """#
    "content/other.typ" #"""
      #let frontmatter = (title: "Other", template: "page.typ",)
      Target.
      """#
  }
  expect {
    ok
    file "hello/index.html" {
      // The frontmatter reached the template.
      contains ">Hello</h1>"
      // Inline marks became real elements, not literal asterisks.
      contains "<strong>prose</strong>"
      contains "<code>code</code>"
      contains "<li>one</li>"
      // The link resolved through the same graph a typst page's does.
      contains #"href="/other/""#
    }
  }
}

// The property the lowering rests on. Typst syntax written in markdown prose is
// text, not code: a `#call()` renders literally and an unbalanced bracket does
// not swallow the rest of the page.
scenario "typst syntax in markdown prose stays text" {
  requires "markdown"
  files {
    "config.kdl" #"""
      site "Test"
      paths {
        content "content"
        dist "public"
        templates "templates"
      }
      """#
    "templates/page.typ" #"""
      #let page(page, body) = html.elem("main", body)
      """#
    "content/raw.md" #"""
      ;;;
      title "Raw"
      template "page.typ"
      ;;;

      A #heading(level: 1)[fake] call, a [ bracket, and a $sum$ dollar.
      """#
  }
  expect {
    ok
    file "raw/index.html" {
      contains "#heading(level: 1)"
      contains "$sum$"
      // If the call had evaluated there would be an h1 here.
      missing "</h1>"
    }
  }
}

// The escape hatch. A fence marked `eval` is how a markdown page reaches Typst;
// an unmarked one is a sample, so a page can document Typst without running it.
scenario "a fence marked eval runs and a plain one is shown" {
  requires "markdown"
  files {
    "config.kdl" #"""
      site "Test"
      paths {
        content "content"
        dist "public"
        templates "templates"
      }
      """#
    "templates/page.typ" #"""
      #let page(page, body) = html.elem("main", body)
      """#
    "content/fence.md" #"""
      ;;;
      title "Fence"
      template "page.typ"
      ;;;

      ```typ eval
      #html.elem("aside", "from typst")
      ```

      ```typ
      #html.elem("aside", "not run")
      ```
      """#
  }
  expect {
    ok
    file "fence/index.html" {
      contains "<aside>from typst</aside>"
      // The example is shown as source, so its markup is escaped text.
      contains "not run"
      missing "<aside>not run</aside>"
    }
  }
}

// Frontmatter is KDL, and it feeds the same field dispatch a typst page's
// export does: built-in keys are typed, and taxonomy keys collect terms.
scenario "kdl frontmatter drives the built-in fields" {
  requires "markdown"
  files {
    "config.kdl" #"""
      site "Test"
      paths {
        content "content"
        dist "public"
        templates "templates"
      }
      content {
        taxonomies {
          tags listing=#true
        }
      }
      """#
    "templates/page.typ" #"""
      #let page(page, body) = html.elem("main", {
        html.elem("h1", page.frontmatter.title)
        html.elem("time", page.date.iso)
        body
      })
      """#
    "content/post.md" #"""
      ;;;
      title "Post"
      template "page.typ"
      slug "renamed"
      date "2026-08-05"
      tags "rust" "typst"
      ;;;

      Body.
      """#
  }
  expect {
    ok
    // `slug` was honoured, so the built-in key was read and not passed through.
    file "renamed/index.html" {
      contains ">Post</h1>"
      contains "2026-08-05"
    }
    // The taxonomy key collected its terms.
    file "tags/rust/index.html"
    file "tags/typst/index.html"
  }
}

// A markdown page may declare nothing at all; it is still a page.
scenario "a markdown page without frontmatter is still a page" {
  requires "markdown"
  files {
    "config.kdl" #"""
      site "Test"
      paths {
        content "content"
        dist "public"
        templates "templates"
      }
      content {
        collections {
          _root { template "page.typ" }
        }
      }
      """#
    "templates/page.typ" #"""
      #let page(page, body) = html.elem("main", body)
      """#
    "content/bare.md" #"""
      Just a body.
      """#
  }
  expect {
    ok
    file "bare/index.html" {
      contains "Just a body."
    }
  }
}

// Raw HTML is refused rather than dropped: the DOM is typed, so there is
// nowhere to splice a string of markup into.
scenario "raw html in markdown is an error" {
  requires "markdown"
  files {
    "config.kdl" #"""
      site "Test"
      paths {
        content "content"
        dist "public"
        templates "templates"
      }
      """#
    "templates/page.typ" #"""
      #let page(page, body) = html.elem("main", body)
      """#
    "content/html.md" #"""
      ;;;
      title "Html"
      template "page.typ"
      ;;;

      <div>spliced</div>
      """#
  }
  expect {
    fails {
      code "baudelaire::markdown::raw_html"
    }
  }
}

// YAML pasted out of another generator is simply a page. This used to be the
// trap the whole dialect design exists to remove: `---` opened a KDL block, and
// `title:` is a valid KDL node name, so a pasted post parsed green and then
// failed one step later on a dozen keys nobody has.
scenario "yaml pasted from another generator is just a page" {
  requires "markdown"
  files {
    "config.kdl" #"""
      site "Test"
      paths {
        content "content"
        dist "public"
        templates "templates"
      }
      content {
        taxonomies { tags listing=#true }
      }
      """#
    "templates/page.typ" #"""
      #let page(page, body) = html.elem("main", {
        html.elem("h1", page.frontmatter.title)
        html.elem("time", page.date.iso)
        body
      })
      """#
    "content/hello.md" #"""
      ---
      title: The night train
      template: page.typ
      date: "2026-08-05"
      slug: renamed
      draft: false
      tags:
        - rail
      ---

      Body.
      """#
  }
  expect {
    ok
    file "renamed/index.html" {
      contains ">The night train</h1>"
      contains "2026-08-05"
    }
    // A one-element list, which is the thing KDL cannot spell at all.
    file "tags/rail/index.html"
  }
}

// TOML, behind the fence Zola and Hugo made the convention. Its date literal is
// real, unlike YAML's and KDL's, and reaches the same reader as the ISO string.
scenario "a toml block is read behind its own fence" {
  requires "markdown"
  files {
    "config.kdl" #"""
      site "Test"
      paths {
        content "content"
        dist "public"
        templates "templates"
      }
      content {
        taxonomies { tags listing=#true }
      }
      """#
    "templates/page.typ" #"""
      #let page(page, body) = html.elem("main", {
        html.elem("h1", page.frontmatter.title)
        html.elem("time", page.date.iso)
        body
      })
      """#
    "content/hello.md" #"""
      +++
      title = "The night train"
      template = "page.typ"
      date = 2026-08-05
      order = 2
      tags = ["rail"]
      +++

      Body.
      """#
  }
  expect {
    ok
    file "hello/index.html" {
      contains ">The night train</h1>"
      contains "2026-08-05"
    }
    file "tags/rail/index.html"
  }
}

// The three fences are the whole of the declaration, so the same fields written
// three ways produce the same page. This is the property everything downstream
// rests on: by the time the engine looks, there is no dialect left.
scenario "the three dialects declare the same page" {
  requires "markdown"
  files {
    "config.kdl" #"""
      site "Test"
      paths {
        content "content"
        dist "public"
        templates "templates"
      }
      """#
    "templates/page.typ" #"""
      #let page(page, body) = html.elem("main", {
        html.elem("h1", page.frontmatter.title)
        body
      })
      """#
    "content/y.md" #"""
      ---
      title: Same
      template: page.typ
      ---

      Body.
      """#
    "content/t.md" #"""
      +++
      title = "Same"
      template = "page.typ"
      +++

      Body.
      """#
    "content/k.md" #"""
      ;;;
      title "Same"
      template "page.typ"
      ;;;

      Body.
      """#
  }
  expect {
    ok
    file "y/index.html" { contains ">Same</h1>" }
    file "t/index.html" { contains ">Same</h1>" }
    file "k/index.html" { contains ">Same</h1>" }
  }
}

// A block that does not parse names the language it failed to be, so a YAML
// error never tells the reader their KDL is wrong.
scenario "a broken yaml block reports yaml" {
  requires "markdown"
  files {
    "config.kdl" #"""
      site "Test"
      paths {
        content "content"
        dist "public"
        templates "templates"
      }
      """#
    "templates/page.typ" #"""
      #let page(page, body) = html.elem("main", body)
      """#
    "content/bad.md" #"""
      ---
      title: "unclosed
        bad: [1, 2
      ---

      Body.
      """#
  }
  expect {
    fails { code "baudelaire::markdown::frontmatter" }
  }
}

scenario "a broken toml block reports toml" {
  requires "markdown"
  files {
    "config.kdl" #"""
      site "Test"
      paths {
        content "content"
        dist "public"
        templates "templates"
      }
      """#
    "templates/page.typ" #"""
      #let page(page, body) = html.elem("main", body)
      """#
    "content/bad.md" #"""
      +++
      title = = "twice"
      +++

      Body.
      """#
  }
  expect {
    fails { code "baudelaire::markdown::frontmatter" }
  }
}

// Frontmatter that is genuinely not KDL names the file and says what the block
// is written in.
scenario "unparseable frontmatter is a precise error" {
  requires "markdown"
  files {
    "config.kdl" #"""
      site "Test"
      paths {
        content "content"
        dist "public"
        templates "templates"
      }
      """#
    "templates/page.typ" #"""
      #let page(page, body) = html.elem("main", body)
      """#
    "content/bad.md" #"""
      ;;;
      title "never closed
      ;;;

      Body.
      """#
  }
  expect {
    fails {
      code "baudelaire::markdown::frontmatter"
    }
  }
}

// The site decides what a markdown page may contain. Each knob is checked
// through a real build, not just through the parser.
scenario "a site can drop raw html instead of refusing it" {
  requires "markdown"
  files {
    "config.kdl" #"""
      site "Test"
      paths {
        content "content"
        dist "public"
        templates "templates"
      }
      content {
        markdown {
          html "drop"
        }
      }
      """#
    "templates/page.typ" #"""
      #let page(page, body) = html.elem("main", body)
      """#
    "content/html.md" #"""
      ;;;
      title "Html"
      template "page.typ"
      ;;;

      Before <div>spliced</div> after.
      """#
  }
  expect {
    ok
    file "html/index.html" {
      contains "Before"
      contains "after."
      // The *markup* is what goes: the text it wrapped is still the author's
      // prose, and dropping that would lose the page a sentence.
      contains "spliced"
      missing "<div>"
    }
  }
}

// An `eval` fence runs arbitrary Typst at build time, so a site building
// content it did not write can refuse it outright.
scenario "a site can forbid eval fences" {
  requires "markdown"
  files {
    "config.kdl" #"""
      site "Test"
      paths {
        content "content"
        dist "public"
        templates "templates"
      }
      content {
        markdown {
          eval #false
        }
      }
      """#
    "templates/page.typ" #"""
      #let page(page, body) = html.elem("main", body)
      """#
    "content/fence.md" #"""
      ;;;
      title "Fence"
      template "page.typ"
      ;;;

      ```typ eval
      #html.elem("aside", "should not run")
      ```
      """#
  }
  expect {
    ok
    file "fence/index.html" {
      // Shown as source rather than executed.
      contains "should not run"
      missing "<aside>"
    }
  }
}

// `-name` removes one of the defaults, the same spelling `typst { features }`
// uses, so a site keeps every default it did not mention.
scenario "extensions toggle against the defaults" {
  requires "markdown"
  files {
    "config.kdl" #"""
      site "Test"
      paths {
        content "content"
        dist "public"
        templates "templates"
      }
      content {
        markdown {
          extensions "-tables"
        }
      }
      """#
    "templates/page.typ" #"""
      #let page(page, body) = html.elem("main", body)
      """#
    "content/off.md" #"""
      ;;;
      title "Off"
      template "page.typ"
      ;;;

      | a | b |
      | --- | --- |
      | 1 | 2 |

      A ~~struck~~ word.
      """#
  }
  expect {
    ok
    file "off/index.html" {
      // Tables were switched off, so the pipes are literal text.
      missing "<table"
      // ...and strikethrough, which was never mentioned, still works.
      contains "<s>struck</s>"
    }
  }
}

// A name no extension has is refused, with the same near-miss suggestion any
// other misspelled config value gets.
scenario "an unknown extension is refused" {
  requires "markdown"
  files {
    "config.kdl" #"""
      site "Test"
      paths { content "content"; dist "public" }
      content {
        markdown {
          extensions "tabels"
        }
      }
      """#
  }
  expect {
    fails {
      code "baudelaire::config::unknown_value"
    }
  }
}

// Dropping raw HTML is not lossless for a *block*: CommonMark hands the whole
// block over as one run, so its contents go with its tags. Pinned because the
// inline case reads as though nothing is ever lost, and it is why `refuse` is
// the default.
scenario "dropping a raw html block drops what is inside it" {
  requires "markdown"
  files {
    "config.kdl" #"""
      site "Test"
      paths {
        content "content"
        dist "public"
        templates "templates"
      }
      content {
        markdown {
          html "drop"
        }
      }
      """#
    "templates/page.typ" #"""
      #let page(page, body) = html.elem("main", body)
      """#
    "content/block.md" #"""
      ;;;
      title "Block"
      template "page.typ"
      ;;;

      Kept prose.

      <div class="callout">
      This sentence lives inside an HTML block.
      </div>
      """#
  }
  expect {
    ok
    file "block/index.html" {
      contains "Kept prose."
      missing "lives inside"
    }
  }
}

// A comment is dropped because it renders as nothing anywhere. A run that
// merely *opens and closes* with one is not a comment: CommonMark ends an HTML
// block on the line carrying `-->`, so this arrives as a single event with an
// element hidden inside it. Testing the two ends dropped the whole run, which
// lost the author's content and walked past the `html` policy in one go: a
// green build, and `SECRET` published nowhere.
scenario "an html block wrapped in comments is still refused" {
  requires "markdown"
  files {
    "config.kdl" #"""
      site "Test"
      paths {
        content "content"
        dist "public"
        templates "templates"
      }
      """#
    "templates/page.typ" #"""
      #let page(page, body) = html.elem("main", body)
      """#
    "content/sneaky.md" #"""
      ;;;
      title "Sneaky"
      template "page.typ"
      ;;;

      <!-- a --><div>SECRET</div><!-- b -->
      """#
  }
  expect {
    fails {
      code "baudelaire::markdown::raw_html"
    }
  }
}

// ..and the other direction, so the scan that fixed the above does not start
// refusing the comments it is supposed to drop. `<!-->` is an empty comment,
// and its terminator overlaps the `<!--` that opened it, which the guard the
// old test was written around rejected outright.
scenario "a run of nothing but comments is still dropped" {
  requires "markdown"
  files {
    "config.kdl" #"""
      site "Test"
      paths {
        content "content"
        dist "public"
        templates "templates"
      }
      """#
    "templates/page.typ" #"""
      #let page(page, body) = html.elem("main", body)
      """#
    "content/notes.md" #"""
      ;;;
      title "Notes"
      template "page.typ"
      ;;;

      <!-- a note to myself -->

      Kept prose.

      <!-->

      Inline <!-- hidden --> text.
      """#
  }
  expect {
    ok
    file "notes/index.html" {
      contains "Kept prose."
      contains "Inline"
      missing "note to myself"
      missing "hidden"
    }
  }
}

// An email autolink's destination is the bare address, and every renderer puts
// the scheme back. Published as authored it was a *relative path* to a page
// nobody has, and nothing downstream questioned it: a bare address names no
// file either, so the link checker had nothing to say. The two spellings of one
// link disagreed on the same page.
scenario "an email autolink keeps its mailto scheme" {
  requires "markdown"
  files {
    "config.kdl" #"""
      site "Test"
      paths {
        content "content"
        dist "public"
        templates "templates"
      }
      """#
    "templates/page.typ" #"""
      #let page(page, body) = html.elem("main", body)
      """#
    "content/contact.md" #"""
      ;;;
      title "Contact"
      template "page.typ"
      ;;;

      Write to <me@example.com>, or to [me](mailto:me@example.com).
      """#
  }
  expect {
    ok
    file "contact/index.html" {
      contains #"href="mailto:me@example.com""#
      // What the bug published, which is a path and not an address.
      missing #"href="me@example.com""#
    }
  }
}

// A task list marker is a Typst symbol with the `#` that enters markup written
// around it, so a marker lowered wrong is a syntax error in generated source
// rather than a wrong element. Cheap to pin, and nothing else covers it.
scenario "a task list renders its markers" {
  requires "markdown"
  files {
    "config.kdl" #"""
      site "Test"
      paths {
        content "content"
        dist "public"
        templates "templates"
      }
      """#
    "templates/page.typ" #"""
      #let page(page, body) = html.elem("main", body)
      """#
    "content/tasks.md" #"""
      ;;;
      title "Tasks"
      template "page.typ"
      ;;;

      - [x] done
      - [ ] not
      """#
  }
  expect {
    ok
    file "tasks/index.html" {
      contains "done"
      contains "not"
      // The marker became a symbol, not the source that asked for one.
      missing "[x]"
    }
  }
}

// A toggled list says one thing per name. Every shape that would quietly mean
// nothing is refused instead, because a setting that looks accepted and does
// nothing is the failure the config layer exists to prevent.
scenario "a contradictory extension list is refused" {
  requires "markdown"
  files {
    "config.kdl" #"""
      site "Test"
      paths { content "content"; dist "public" }
      content { markdown { extensions "tables" "tables" } }
      """#
  }
  expect {
    fails {
      code "baudelaire::config::duplicate_entry"
    }
  }
}

scenario "an extension list written as key=value is refused" {
  requires "markdown"
  files {
    "config.kdl" #"""
      site "Test"
      paths { content "content"; dist "public" }
      content { markdown { extensions tables=#false } }
      """#
  }
  expect {
    fails {
      code "baudelaire::config::unexpected_argument"
    }
  }
}

scenario "an empty extension list is refused" {
  requires "markdown"
  files {
    "config.kdl" #"""
      site "Test"
      paths { content "content"; dist "public" }
      content { markdown { extensions } }
      """#
  }
  expect {
    fails {
      code "baudelaire::config::missing_arg"
    }
  }
}

// A profile's `extensions` is resolved against the built-in defaults, not
// against what the base config left in force: config lists replace wholesale,
// and `-name` is relative to the defaults rather than to the base.
//
// Pinned because the other reading is at least as natural, and nothing else in
// the tree would notice if it changed.
scenario "a profile resolves extensions against the defaults" {
  requires "markdown"
  files {
    "config.kdl" #"""
      site "Test"
      paths {
        content "content"
        dist "public"
        templates "templates"
      }
      content {
        markdown {
          extensions "-tables"
        }
      }
      profiles {
        prod {
          content {
            markdown {
              extensions "smart"
            }
          }
        }
      }
      """#
    "templates/page.typ" #"""
      #let page(page, body) = html.elem("main", body)
      """#
    "content/t.md" #"""
      ;;;
      title "T"
      template "page.typ"
      ;;;

      | a | b |
      | --- | --- |
      | 1 | 2 |
      """#
  }
  // Without the profile, the base holds: tables are off.
  build { expect { ok; file "t/index.html" { missing "<table" } } }
  // With it, the profile's list replaced the base's wholesale, so `-tables` is
  // gone and tables come back along with the rest of the defaults.
  build {
    profile "prod"
    expect { ok; file "t/index.html" { contains "<table" } }
  }
}

// `markdown #false` is the shorthand for `markdown { enabled #false }`, and it
// puts `.md` files back to being files: a site with a README beside its pages
// should not have to publish it.
scenario "a site can turn markdown off and keep its md files" {
  requires "markdown"
  files {
    "config.kdl" #"""
      site "Test"
      paths {
        content "content"
        dist "public"
        templates "templates"
      }
      content {
        markdown #false
      }
      """#
    "templates/page.typ" #"""
      #let page(page, body) = html.elem("main", body)
      """#
    "content/real.typ" #"""
      #let frontmatter = (title: "Real", template: "page.typ",)
      A typst page.
      """#
    "content/README.md" #"""
      # Notes to myself

      Not a page.
      """#
  }
  expect {
    ok
    file "real/index.html" { contains "A typst page." }
    // The `.md` was never a page, so nothing was published for it.
    absent "README/index.html"
    absent "readme/index.html"
  }
}

// ...and the long spelling means the same thing.
scenario "the enabled key is the shorthand written out" {
  requires "markdown"
  files {
    "config.kdl" #"""
      site "Test"
      paths {
        content "content"
        dist "public"
        templates "templates"
      }
      content {
        markdown {
          enabled #false
        }
      }
      """#
    "templates/page.typ" #"""
      #let page(page, body) = html.elem("main", body)
      """#
    "content/a.typ" #"""
      #let frontmatter = (title: "A", template: "page.typ",)
      Kept.
      """#
    "content/skipped.md" #"""
      ;;;
      title "Skipped"
      ;;;

      Body.
      """#
  }
  expect {
    ok
    file "a/index.html" { contains "Kept." }
    absent "skipped/index.html"
  }
}

// The block still turns markdown *on* when it only configures it, so writing
// `markdown { extensions .. }` does not silently disable the thing it configures.
scenario "configuring markdown leaves it enabled" {
  requires "markdown"
  files {
    "config.kdl" #"""
      site "Test"
      paths {
        content "content"
        dist "public"
        templates "templates"
      }
      content {
        markdown {
          extensions "smart"
        }
      }
      """#
    "templates/page.typ" #"""
      #let page(page, body) = html.elem("main", body)
      """#
    "content/on.md" #"""
      ;;;
      title "On"
      template "page.typ"
      ;;;

      Still a page.
      """#
  }
  expect {
    ok
    file "on/index.html" { contains "Still a page." }
  }
}

// A markdown page is reached by its source name, exactly as a typst one is.
//
// The extension test in `LinkMap::classify` was the literal `typ`, so a `.md`
// target was classified as a URL and published as the relative path the author
// wrote. Green build, dead link. Both directions are here because the rewrite
// and the check are the same decision: what is not resolved is not verified.
scenario "a link naming a markdown page resolves to its permalink" {
  requires "markdown"
  files {
    "config.kdl" #"""
      site "Test"
      paths {
        content "content"
        dist "public"
        templates "templates"
      }
      """#
    "templates/page.typ" #"""
      #let page(page, body) = html.elem("main", body)
      """#
    "content/notes.md" #"""
      ;;;
      title "Notes"
      template "page.typ"
      ;;;

      The target.
      """#
    "content/index.md" #"""
      ;;;
      title "Home"
      template "page.typ"
      ;;;

      Read [the notes](notes.md).
      """#
    "content/from-typst.typ" #"""
      #let frontmatter = (title: "Typst", template: "page.typ",)
      #link("notes.md")[the notes]
      """#
  }
  expect {
    ok
    // Rewritten to the permalink, from a markdown page ..
    file "index.html" {
      contains #"href="/notes/""#
      missing "notes.md"
    }
    // .. and from a typst one, since neither knows what the other is written in.
    file "from-typst/index.html" { contains #"href="/notes/""# }
  }
}

scenario "a link naming a markdown page that is not there is reported" {
  requires "markdown"
  files {
    "config.kdl" #"""
      site "Test"
      paths {
        content "content"
        dist "public"
        templates "templates"
      }
      """#
    "templates/page.typ" #"""
      #let page(page, body) = html.elem("main", body)
      """#
    "content/index.md" #"""
      ;;;
      title "Home"
      template "page.typ"
      ;;;

      Read [the notes](notes.md).
      """#
  }
  expect {
    fails { code "baudelaire::links::broken" }
  }
}

// Where markdown is not a source dialect, a `.md` file is a file: a link to one
// is left as authored rather than becoming a broken page reference. Turning
// markdown off must not turn a working file link red.
scenario "a markdown link is a file link where markdown is off" {
  requires "markdown"
  files {
    "config.kdl" #"""
      site "Test"
      paths {
        content "content"
        dist "public"
        templates "templates"
      }
      content { markdown #false }
      """#
    "templates/page.typ" #"""
      #let page(page, body) = html.elem("main", body)
      """#
    "content/index.typ" #"""
      #let frontmatter = (title: "Home", template: "page.typ",)
      #link("readme.md")[the readme]
      """#
  }
  expect {
    ok
    file "index.html" { contains #"href="readme.md""# }
  }
}
