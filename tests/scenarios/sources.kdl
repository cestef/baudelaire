// `paths { sources { } }` and a page's `source`: a markdown page whose body is
// a file the config declared, somewhere the content tree does not reach.
//
// The shape of the feature is the security of it. A page names a *name*, and the
// config is the only thing that maps a name to a path, so content -- the part of
// a site a pull request touches -- can never name a file. Half of these cases
// exist to hold that line rather than to demonstrate the feature.

scenario "a page takes its body from a declared source" {
  requires "markdown"
  files {
    "config.kdl" #"""
      site "Test"
      paths {
        content "content"
        dist "public"
        templates "templates"
        sources {
          changelog "notes/CHANGELOG.md"
        }
      }
      """#
    "templates/page.typ" #"""
      #let page(page, body) = html.elem("main", {
        html.elem("h1", page.frontmatter.title)
        body
      })
      """#
    // Outside `content/`, so nothing discovers it as a page of its own: it is
    // read because one page asked for it by name.
    "notes/CHANGELOG.md" #"""
      Released **today**, with a [link](/other/).

      - one
      - two
      """#
    "content/changelog.md" #"""
      ;;;
      title "Changelog"
      template "page.typ"
      source "changelog"
      ;;;
      """#
    "content/other.typ" #"""
      #let frontmatter = (title: "Other", template: "page.typ",)
      Target.
      """#
  }
  expect {
    ok
    file "changelog/index.html" {
      // The stub's frontmatter still reached the template.
      contains ">Changelog</h1>"
      // The sourced file became the body, lowered like any markdown.
      contains "<strong>today</strong>"
      contains "<li>one</li>"
      // ..including its links, which resolve through the same graph.
      contains #"href="/other/""#
    }
    // The sourced file is an input, never an output: it sits outside `content/`
    // and nothing publishes it.
    absent "notes/CHANGELOG/index.html"
  }
}

// The line the whole design rests on. A page may write a name; a path is not a
// name, so this is an unknown source rather than a file to open. Were it read as
// a path, any page in any pull request could publish any file the build can
// read.
scenario "a page cannot name a path instead of a source" {
  requires "markdown"
  files {
    "config.kdl" #"""
      site "Test"
      paths {
        content "content"
        dist "public"
        sources {
          changelog "notes/CHANGELOG.md"
        }
      }
      """#
    "notes/CHANGELOG.md" #"""
      Released today.
      """#
    "content/leak.md" #"""
      ;;;
      title "Leak"
      source "../../../etc/passwd"
      ;;;
      """#
  }
  expect {
    fails { code "baudelaire::content::unknown_source" }
  }
}

// The same refusal for a name that is merely wrong: a typo is not a fallback to
// reading it as a path either.
scenario "an undeclared source name is refused" {
  requires "markdown"
  files {
    "config.kdl" #"""
      site "Test"
      paths {
        content "content"
        dist "public"
        sources {
          changelog "notes/CHANGELOG.md"
        }
      }
      """#
    "notes/CHANGELOG.md" #"""
      Released today.
      """#
    "content/page.md" #"""
      ;;;
      title "Page"
      source "changlog"
      ;;;
      """#
  }
  expect {
    fails { code "baudelaire::content::unknown_source" }
  }
}

// Two bodies, and no rule for choosing between them that does not silently
// discard prose somebody wrote.
scenario "a sourced page may not also have a body" {
  requires "markdown"
  files {
    "config.kdl" #"""
      site "Test"
      paths {
        content "content"
        dist "public"
        sources {
          changelog "notes/CHANGELOG.md"
        }
      }
      """#
    "notes/CHANGELOG.md" #"""
      Released today.
      """#
    "content/page.md" #"""
      ;;;
      title "Page"
      source "changelog"
      ;;;

      Prose of my own.
      """#
  }
  expect {
    fails { code "baudelaire::content::source_and_body" }
  }
}

// The names are emitted as `#let` bindings in `@baudelaire/sources`, so one
// typst cannot bind breaks that module rather than this config, at the first
// import, inside a generated file nobody has opened.
scenario "a source name typst cannot bind is refused" {
  files {
    "config.kdl" #"""
      site "Test"
      paths {
        content "content"
        dist "public"
        sources {
          "my file" "notes/a.md"
        }
      }
      """#
    "notes/a.md" #"""
      A.
      """#
    "content/page.typ" #"""
      #let frontmatter = (title: "Page",)
      """#
  }
  expect {
    fails { code "baudelaire::config::not_an_identifier" }
  }
}

// One name, two files: a page's `source` took the first and an import took the
// last, so the same name meant different files on the same build.
scenario "a source declared twice is refused" {
  files {
    "config.kdl" #"""
      site "Test"
      paths {
        content "content"
        dist "public"
        sources {
          notes "notes/a.md"
          notes "notes/b.md"
        }
      }
      """#
    "notes/a.md" #"""
      A.
      """#
    "notes/b.md" #"""
      B.
      """#
    "content/page.typ" #"""
      #let frontmatter = (title: "Page",)
      """#
  }
  expect {
    fails { code "baudelaire::config::duplicate_id" }
  }
}

// A typst source is not lowered at all: it is mounted where the compiler can
// open it, so the page's body is one `include` and the file's own spans, its
// dependency on the page, and its imports are typst's to handle.
scenario "a page takes its body from a declared typst source" {
  requires "markdown"
  files {
    "config.kdl" #"""
      site "Test"
      paths {
        content "content"
        dist "public"
        sources {
          notes "notes/notes.typ"
        }
      }
      """#
    "notes/notes.typ" #"""
      = Notes

      Written elsewhere.
      """#
    "content/page.md" #"""
      ;;;
      title "Page"
      source "notes"
      ;;;
      """#
  }
  expect {
    ok
    file "page/index.html" {
      contains "Written elsewhere."
      // Rendered as typst, not as prose about typst: the heading is one.
      contains #"<h2 id="notes">Notes</h2>"#
    }
    // An input, never an output.
    absent "notes/notes/index.html"
  }
}

// The other half of the mount: a typst page reaches a declared file by name,
// which is what `include` cannot do for a file outside the project root.
scenario "a typst page reads a declared source by name" {
  files {
    "config.kdl" #"""
      site "Test"
      paths {
        content "content"
        dist "public"
        sources {
          notes "notes/notes.typ"
          data "notes/data.json"
        }
      }
      """#
    "notes/notes.typ" #"""
      Included by name.
      """#
    "notes/data.json" #"""
      { "count": 7 }
      """#
    "content/page.typ" #"""
      #import "@baudelaire/sources:0.1.0": notes, data
      #let frontmatter = (title: "Page",)

      #include notes

      Count: #json(data).count
      """#
  }
  expect {
    ok
    file "page/index.html" {
      contains "Included by name."
      contains "Count: 7"
    }
  }
}

// The body is lowered by the dialect the declared file names, and a file that
// names none is refused. It used to be lowered as markdown whatever it was, so
// a file of another kind came out as prose with its own syntax in it, on a
// green build.
scenario "a source of a kind nothing reads is refused" {
  requires "markdown"
  files {
    "config.kdl" #"""
      site "Test"
      paths {
        content "content"
        dist "public"
        sources {
          notes "notes/notes.rst"
        }
      }
      """#
    "notes/notes.rst" #"""
      Not prose
      ========
      """#
    "content/page.md" #"""
      ;;;
      title "Page"
      source "notes"
      ;;;
      """#
  }
  expect {
    fails { code "baudelaire::content::source_unreadable" }
  }
}

// A `.typ` page's body is the module its frontmatter was read out of, and typst
// has `include`, which reads a file and is tracked as a dependency of the page.
scenario "a typst page is refused a source" {
  files {
    "config.kdl" #"""
      site "Test"
      paths {
        content "content"
        dist "public"
        sources {
          changelog "notes/CHANGELOG.md"
        }
      }
      """#
    "notes/CHANGELOG.md" #"""
      Released today.
      """#
    "content/page.typ" #"""
      #let frontmatter = (title: "Page", source: "changelog",)
      """#
  }
  expect {
    fails { code "baudelaire::content::source_on_typst" }
  }
}
