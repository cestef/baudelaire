// Generated site files that are opt-in: present only when their block is.

scenario "robots.txt is emitted when its block is present" {
  files {
    "config.kdl" #"""
      site "T"
      url "https://example.com"
      paths {
        content "content"
        dist "public"
      }
      generate {
        sitemap #true
        robots {
            disallow "/private/"
          }
      }
      """#
    "content/posts/a.typ" #"""
      #let frontmatter = (title: "A",)
      body
      """#
  }
  expect {
    ok
    file "robots.txt" {
      contains "User-agent: *"
      contains "Disallow: /private/"
      contains "Sitemap: https://example.com/sitemap.xml"
    }
  }
}

scenario "no robots.txt without the block" {
  files {
    "config.kdl" #"""
      site "T"
      paths {
        content "content"
        dist "public"
      }
      """#
    "content/posts/a.typ" #"""
      #let frontmatter = (title: "A",)
      body
      """#
  }
  expect {
    ok
    absent "robots.txt"
  }
}

scenario "llms.txt indexes pages by collection" {
  files {
    "config.kdl" #"""
      site "T"
      url "https://example.com"
      paths {
        content "content"
        dist "public"
      }
      generate {
        llms {
            summary "A test site."
          }
      }
      """#
    "content/posts/a.typ" #"""
      #let frontmatter = (title: "Alpha", slug: "a",)
      body
      """#
  }
  expect {
    ok
    file "llms.txt" {
      contains "# T"
      contains "> A test site."
      contains "## posts"
      contains "- [Alpha](https://example.com/posts/a/)"
    }
  }
}

// The docs say a `generate { robots }` or `generate { llms }` block turns the
// feature on just by existing. It used to be a hard `missing_children` error, so
// the documented spelling did not parse at all, while `optimize { png }` next
// door did, because it goes through a different code path.
scenario "a bare block turns its feature on" {
  files {
    "config.kdl" #"""
      site "T"
      url "https://example.com"
      generate {
        robots
        llms
      }
      navigation {
        speculation
      }
      """#
    "content/index.typ" #"""
      #let frontmatter = (title: "H",)
      home
      """#
  }
  expect {
    ok
    file "robots.txt" { contains "User-agent: *" }
    file "llms.txt"
    file "index.html" { contains "speculationrules" }
  }
}

// ...and a bare block is still equivalent to an empty one.
scenario "a bare block and an empty block agree" {
  files {
    "config.kdl" #"""
      site "T"
      url "https://example.com"
      generate {
        robots { }
      }
      """#
    "content/index.typ" #"""
      #let frontmatter = (title: "H",)
      home
      """#
  }
  expect {
    ok
    file "robots.txt" { contains "User-agent: *" }
  }
}

// A section that only holds settings has no switch to flip, so a bare node
// configures nothing. Far more likely a forgotten block than an intent, so it
// stays an error rather than becoming a silent no-op.
scenario "a settings-only section still needs its block" {
  files {
    "config.kdl" #"""
      site "T"
      paths
      """#
    "content/index.typ" #"""
      #let frontmatter = (title: "H",)
      home
      """#
  }
  expect {
    fails { code "baudelaire::config::missing_children" }
  }
}

// Every generated file used to be all-or-nothing per site: a thank-you page was
// in the sitemap, a changelog was in the feed, and a page could say nothing
// about either. The site still decides whether an artifact is generated at all.
scenario "a page declines the files a build generates about it" {
  requires "cards"
  files {
    "config.kdl" #"""
      site "T"
      url "https://s.example"
      paths {
        content "content"
        dist "public"
      }
      content {
        collections {
          posts { paginate { size 10 }; feed #true }
        }
        taxonomies {
          tags listing=#true
        }
      }
      generate {
        sitemap #true
        search { formats "json" }
        cards { }
        feed { formats "atom"; terms #true }
      }
      """#
    "templates/card.typ" #"""
      #let card(data) = rect(width: 100%, height: 100%)[#data.title]
      """#
    "content/posts/public.typ" #"""
      #let frontmatter = (
        title: "Public",
        date: "2026-01-02",
        tags: ("rust",),
      )
      body
      """#
    "content/posts/quiet.typ" #"""
      #let frontmatter = (
        title: "Quiet",
        date: "2026-01-03",
        exclude: ("sitemap", "feed", "search", "card"),
        tags: ("rust",),
      )
      body
      """#
  }
  expect {
    ok
    file "sitemap.xml" {
      contains "/posts/public/"
      missing "/posts/quiet/"
    }
    file "posts/atom.xml" {
      contains "Public"
      missing "Quiet"
    }
    // A term's feed is a feed: the opt-out reaches it too, and does not stop at
    // the one feed the site writes for the collection.
    file "tags/rust/atom.xml" {
      contains "Public"
      missing "Quiet"
    }
    // The page has no entry of its own. Its title still appears in the body of
    // the collection index, which lists it: `exclude` names generated files,
    // not what another page says.
    file "search.json" {
      contains #""url":"/posts/public/""#
      missing #""url":"/posts/quiet/""#
    }
    // The card the page declined is not drawn, and no `og:image` names one.
    file "posts/quiet/index.html" { missing "og:image" }
    file "posts/public/index.html" { contains "og:image" }
  }
}

// A name the key does not answer to is the author's mistake, named as one with
// the same did-you-mean an unknown config key gets: `Keys::help` owns that
// shape for every name set in the project.
scenario "an unknown exclusion is refused" {
  files {
    "config.kdl" #"""
      site "T"
      paths {
        content "content"
        dist "public"
      }
      """#
    "content/a.typ" #"""
      #let frontmatter = (title: "A", exclude: ("sitemaps",))
      body
      """#
  }
  expect {
    fails { code "baudelaire::content::frontmatter_name" }
  }
}

// A redirect was always a permanent move. A temporary diversion is a different
// claim, and a site had no way to make it: the status is now the rule's own.
scenario "a redirect names the status it forwards with" {
  files {
    "config.kdl" #"""
      site "T"
      paths {
        content "content"
        dist "public"
      }
      generate { redirects #true }
      redirect {
        "/moved/" "/new/"
        "/temp/" "/elsewhere/" status=302
      }
      """#
    "content/a.typ" #"""
      #let frontmatter = (title: "A",)
      body
      """#
  }
  expect {
    ok
    file "_redirects" {
      contains "/moved/ /new/ 301"
      contains "/temp/ /elsewhere/ 302"
    }
  }
}

// The status only reaches a host through the rule file: an HTML stub is a meta
// refresh, which forwards a browser and says nothing about how the page moved.
// Asking for one without the file is a claim the build cannot carry.
scenario "a status without the rule file is reported as inert" {
  files {
    "config.kdl" #"""
      site "T"
      paths {
        content "content"
        dist "public"
      }
      redirect {
        "/temp/" "/elsewhere/" status=307
      }
      """#
    "content/a.typ" #"""
      #let frontmatter = (title: "A",)
      body
      """#
  }
  expect {
    ok
    warns "baudelaire::config::inert"
    // The stub is still written: the redirect works, it just cannot say 307.
    file "temp/index.html" { contains "/elsewhere/" }
  }
}

// Outside the redirect class is a typo, or a different feature under the same
// file name.
scenario "a status that is not a redirect is refused" {
  files {
    "config.kdl" #"""
      site "T"
      paths {
        content "content"
        dist "public"
      }
      redirect {
        "/a/" "/b/" status=200
      }
      """#
    "content/a.typ" #"""
      #let frontmatter = (title: "A",)
      body
      """#
  }
  expect {
    fails { code "baudelaire::config::out_of_range" }
  }
}
