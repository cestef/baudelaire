// Where a page's footnotes end up.
//
// Typst appends the list to the end of the document. On a templated page that
// is after everything the layout emitted, so the notes land below the site
// footer and outside the element that sets the content width.
// `html { footnotes "article" "main" }` names the elements they belong in, most
// specific first; naming none leaves them where Typst put them.

scenario "footnotes move inside the article by default" {
  files {
    "config.kdl" #"""
      site "Test"
      paths {
        content "content"
        dist "public"
        templates "templates"
      }
      """#
    "templates/page.typ" #"""
      #let page(page, body) = {
        html.elem("main", html.elem("article", body))
        html.elem("footer", "site footer")
      }
      """#
    "content/note.typ" #"""
      #let frontmatter = (title: "Note", template: "page.typ",)
      Text with a note#footnote[The note.] in it.
      """#
  }
  expect {
    ok
    file "note/index.html" {
      // Inside the article: the list closes before the article does, and the
      // footer is still the last thing in the body.
      order #"role="doc-endnotes""# "</article>" "<footer>"
    }
  }
}

scenario "footnotes fall back to main when the layout has no article" {
  files {
    "config.kdl" #"""
      site "Test"
      paths {
        content "content"
        dist "public"
        templates "templates"
      }
      """#
    "templates/page.typ" #"""
      #let page(page, body) = {
        html.elem("main", body)
        html.elem("footer", "site footer")
      }
      """#
    "content/note.typ" #"""
      #let frontmatter = (title: "Note", template: "page.typ",)
      Text with a note#footnote[The note.] in it.
      """#
  }
  expect {
    ok
    file "note/index.html" {
      order #"role="doc-endnotes""# "</main>" "<footer>"
    }
  }
}

scenario "footnotes can be pinned to main even when an article exists" {
  files {
    "config.kdl" #"""
      site "Test"
      paths {
        content "content"
        dist "public"
        templates "templates"
      }
      html { footnotes "main" }
      """#
    "templates/page.typ" #"""
      #let page(page, body) = {
        html.elem("main", {
          html.elem("article", body)
          html.elem("aside", "sidebar")
        })
      }
      """#
    "content/note.typ" #"""
      #let frontmatter = (title: "Note", template: "page.typ",)
      Text with a note#footnote[The note.] in it.
      """#
  }
  expect {
    ok
    file "note/index.html" {
      // After the article closes, still inside main: the notes belong to the
      // page rather than to the article.
      order "</article>" "<aside>" #"role="doc-endnotes""# "</main>"
    }
  }
}

scenario "any element the layout emits can hold the notes" {
  files {
    "config.kdl" #"""
      site "Test"
      paths {
        content "content"
        dist "public"
        templates "templates"
      }
      // Not one of the defaults, and not a name baudelaire knows: the DOM
      // decides what can be an element, and the layout decides what exists.
      html { footnotes "footer" }
      """#
    "templates/page.typ" #"""
      #let page(page, body) = {
        html.elem("article", body)
        html.elem("footer", "site footer")
      }
      """#
    "content/note.typ" #"""
      #let frontmatter = (title: "Note", template: "page.typ",)
      Text with a note#footnote[The note.] in it.
      """#
  }
  expect {
    ok
    file "note/index.html" {
      order "</article>" "site footer" #"role="doc-endnotes""# "</footer>"
    }
  }
}

scenario "naming no element leaves them where typst put them" {
  files {
    "config.kdl" #"""
      site "Test"
      paths {
        content "content"
        dist "public"
        templates "templates"
      }
      html { footnotes }
      """#
    "templates/page.typ" #"""
      #let page(page, body) = {
        html.elem("main", html.elem("article", body))
        html.elem("footer", "site footer")
      }
      """#
    "content/note.typ" #"""
      #let frontmatter = (title: "Note", template: "page.typ",)
      Text with a note#footnote[The note.] in it.
      """#
  }
  expect {
    ok
    file "note/index.html" {
      order "</footer>" #"role="doc-endnotes""#
    }
  }
}

scenario "a layout with no container keeps its footnotes" {
  files {
    "config.kdl" #"""
      site "Test"
      paths {
        content "content"
        dist "public"
        templates "templates"
      }
      """#
    "templates/page.typ" #"""
      #let page(page, body) = {
        html.elem("div", attrs: (class: "wrap"), body)
      }
      """#
    "content/note.typ" #"""
      #let frontmatter = (title: "Note", template: "page.typ",)
      Text with a note#footnote[The note.] in it.
      """#
  }
  expect {
    ok
    file "note/index.html" {
      // Nowhere better to put them, so they are left alone rather than dropped.
      contains #"role="doc-endnotes""#
      contains "The note."
    }
  }
}

scenario "an untemplated page is untouched" {
  files {
    "config.kdl" #"""
      site "Test"
      paths {
        content "content"
        dist "public"
      }
      """#
    "content/note.typ" #"""
      #let frontmatter = (title: "Note",)
      Text with a note#footnote[The note.] in it.
      """#
  }
  expect {
    ok
    file "note/index.html" {
      contains #"role="doc-endnotes""#
      contains "The note."
    }
  }
}

scenario "a name no element can carry is refused where it is written" {
  files {
    "config.kdl" #"""
      site "Test"
      paths {
        content "content"
        dist "public"
      }
      html { footnotes "not a tag" }
      """#
    "content/note.typ" #"""
      #let frontmatter = (title: "Note",)
      Body.
      """#
  }
  expect {
    fails {
      code "baudelaire::config::unknown_value"
    }
  }
}
