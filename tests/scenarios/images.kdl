// Externalizing typst-embedded images out of the DOM into files, and the
// responsive variants the pipeline derives from an asset.

scenario "extract is the default: a typst image becomes a file reference" {
  files {
    "config.kdl" #"""
      site "T"
      paths {
        content "content"
        dist "public"
      }
      """#
    "content/pic.png" png="2x2"
    "content/index.typ" #"""
      #image("pic.png")
      """#
  }
  expect {
    ok
    file "index.html" {
      contains #"src="/assets/pic.png""#
      missing "data:image"
    }
    file "assets/pic.png"
  }
}

scenario "extract off restores typst's native base64 inlining" {
  files {
    "config.kdl" #"""
      site "T"
      paths {
        content "content"
        dist "public"
      }
      assets {
        images { extract #false }
      }
      """#
    "content/pic.png" png="2x2"
    "content/index.typ" #"""
      #image("pic.png")
      """#
  }
  expect {
    ok
    file "index.html" { contains "data:image" }
    absent "assets/pic.png"
  }
}

// The next four are two pairs, and they are only meaningful as pairs. With
// `extract` off the `style` is typst's own output; with it on the `style` is
// reproduced by `world/image_rule.rs` against typst's private `ToCss`, which
// carries no compatibility promise. Each pair asserts the *same* literal, so a
// typst bump that changes the encoding turns one of them red instead of
// silently rendering a page two ways.
scenario "externalizing preserves typst's image sizing as inline css" {
  files {
    "config.kdl" #"""
      site "T"
      paths {
        content "content"
        dist "public"
      }
      assets {
        images { extract #true }
      }
      """#
    "content/pic.png" png="2x2"
    "content/index.typ" #"""
      #image("pic.png", width: 50%)
      """#
  }
  expect {
    ok
    file "index.html" { contains #"style="display: block; width: 50%""# }
  }
}

scenario "typst's own sizing css reads the same with extract off" {
  files {
    "config.kdl" #"""
      site "T"
      paths {
        content "content"
        dist "public"
      }
      assets {
        images { extract #false }
      }
      """#
    "content/pic.png" png="2x2"
    "content/index.typ" #"""
      #image("pic.png", width: 50%)
      """#
  }
  expect {
    ok
    file "index.html" { contains #"style="display: block; width: 50%""# }
  }
}

scenario "a mixed image width externalizes as the calc typst writes" {
  files {
    "config.kdl" #"""
      site "T"
      paths {
        content "content"
        dist "public"
      }
      assets {
        images { extract #true }
      }
      """#
    "content/pic.png" png="2x2"
    "content/index.typ" #"""
      #image("pic.png", width: 50% - 10pt)
      """#
  }
  expect {
    ok
    file "index.html" { contains #"style="display: block; width: calc(50% - 10pt)""# }
  }
}

scenario "a mixed image width reads the same with extract off" {
  files {
    "config.kdl" #"""
      site "T"
      paths {
        content "content"
        dist "public"
      }
      assets {
        images { extract #false }
      }
      """#
    "content/pic.png" png="2x2"
    "content/index.typ" #"""
      #image("pic.png", width: 50% - 10pt)
      """#
  }
  expect {
    ok
    file "index.html" { contains #"style="display: block; width: calc(50% - 10pt)""# }
  }
}

scenario "an image built from bytes has no file, so it stays inline" {
  files {
    "config.kdl" #"""
      site "T"
      paths {
        content "content"
        dist "public"
      }
      assets {
        images { extract #true }
      }
      """#
    "content/pic.png" png="2x2"
    "content/index.typ" #"""
      #image(read("pic.png", encoding: none))
      """#
  }
  expect {
    ok
    file "index.html" { contains "data:image" }
    absent "assets/pic.png"
  }
}

scenario "a responsive width smaller than the source becomes a srcset candidate" {
  // Variants are re-encoded by the image handler, which the `images` feature
  // owns; the slim flavour copies verbatim and emits no srcset.
  requires "images"
  files {
    "config.kdl" #"""
      site "T"
      paths {
        content "content"
        dist "public"
      }
      assets {
        images {
            responsive { widths 30 }
          }
      }
      """#
    // A 60px-wide asset referenced by URL, which path externalization does not
    // cover: the pipeline generates a 30px variant and a srcset.
    "assets/big.png" png="60x40"
    "content/index.typ" #"""
      #html.elem("img", attrs: (src: "/assets/big.png"))
      """#
  }
  expect {
    ok
    file "index.html" {
      contains "srcset="
      contains "/assets/big-30.png 30w"
      // No sizes attribute unless the config sets one (100vw is the default).
      missing "sizes="
    }
    file "assets/big-30.png"
  }
}

// An extracted image keeps the directories it was authored under, and the
// `srcset` has to name them exactly once. Built by gluing the whole name onto
// the primary URL's directory -- which already held it -- every downscale of a
// picture in a content subdirectory was published as
// `/assets/gallery/gallery/cover-30.png` and 404'd; only the `src` fallback
// worked, so nothing looked broken. Every other scenario here puts its image at
// `content/pic.png`, where the two spellings coincide, which is why it survived.
scenario "an extracted image in a subdirectory names that directory once" {
  requires "images"
  files {
    "config.kdl" #"""
      site "T"
      paths {
        content "content"
        dist "public"
      }
      assets {
        images {
            responsive { widths 30 }
          }
      }
      """#
    "content/gallery/cover.png" png="60x40"
    "content/gallery/page.typ" #"""
      #image("cover.png")
      """#
  }
  expect {
    ok
    file "gallery/page/index.html" {
      contains #"src="/assets/gallery/cover.png""#
      contains "/assets/gallery/cover-30.png 30w"
      // The directory doubled is the whole bug, and it is invisible in the
      // `src`: only the candidates carried it twice.
      missing "/assets/gallery/gallery/"
    }
    // ...and the candidate names the file the copy pass actually wrote.
    file "assets/gallery/cover-30.png"
  }
}

scenario "a responsive width at or above the source would upscale, so it is dropped" {
  files {
    "config.kdl" #"""
      site "T"
      paths {
        content "content"
        dist "public"
      }
      assets {
        images {
            responsive { widths 100 }
          }
      }
      """#
    "assets/small.png" png="40x40"
    "content/index.typ" #"""
      #html.elem("img", attrs: (src: "/assets/small.png"))
      """#
  }
  expect {
    ok
    // With no smaller widths left, no srcset is produced at all.
    file "index.html" { missing "srcset=" }
    absent "assets/small-100.png"
  }
}
