// Drafts are excluded unless asked for, whether marked in frontmatter or by the
// file-stem suffix.

scenario "a draft is skipped and its siblings still build" {
  files {
    "config.kdl" #"""
      site "Test"
      paths {
        content "content"
        dist "public"
      }
      """#
    "content/posts/draft.typ" #"""
      #let frontmatter = (title: "D", draft: true,)
      draft body text
      """#
    "content/posts/real.typ" #"""
      #let frontmatter = (title: "R",)
      real body text
      """#
  }
  expect {
    ok
    absent "posts/draft/index.html"
    file "posts/real/index.html"
  }
}

scenario "draft build turns drafts on" {
  files {
    "config.kdl" #"""
      site "Test"
      paths {
        content "content"
        dist "public"
      }
      content {
        drafts #true
      }
      """#
    "content/posts/draft.typ" #"""
      #let frontmatter = (title: "D", draft: true,)
      draft body text
      """#
  }
  expect {
    ok
    file "posts/draft/index.html" { contains "draft body text" }
  }
}

scenario "the draft suffix implies draft, so the page is skipped" {
  files {
    "config.kdl" #"""
      site "Test"
      paths {
        content "content"
        dist "public"
      }
      """#
    "content/posts/wip.draft.typ" #"""
      #let frontmatter = (title: "W",)
      work in progress
      """#
  }
  expect {
    ok
    absent "posts/wip/index.html"
    absent "posts/wip.draft/index.html"
  }
}

scenario "the draft suffix is stripped from the slug when drafts build" {
  files {
    "config.kdl" #"""
      site "Test"
      paths {
        content "content"
        dist "public"
      }
      content {
        drafts #true
      }
      """#
    "content/posts/wip.draft.typ" #"""
      #let frontmatter = (title: "W",)
      work in progress
      """#
  }
  expect {
    ok
    file "posts/wip/index.html" { contains "work in progress" }
    absent "posts/wip.draft/index.html"
  }
}

// A page discovery found and the build left out is something an author has to
// be told about. Three pages in and one page out was a silent `built 2 pages`,
// with the strings `draft` and `expired` nowhere in the output at any
// verbosity, so the only signal was a 404 in production; for `expiry`, which no
// flag brings back, that was the only signal there could ever be. Advice rather
// than a warning: leaving a draft out is what a draft is for, and it must not
// count against `--strict`.
scenario "a page left out of the build says so" {
  files {
    "config.kdl" #"""
      site "H"
      url "https://x.test"
      """#
    "content/live.typ" #"""
      #let frontmatter = (title: "Live")
      out
      """#
    "content/d.typ" #"""
      #let frontmatter = (title: "D", draft: true)
      d
      """#
    "content/e.typ" #"""
      #let frontmatter = (title: "E", expiry: "2020-01-01")
      e
      """#
  }
  expect {
    ok
    advises "baudelaire::content::held"
    absent "d/index.html"
    absent "e/index.html"
    file "live/index.html"
  }
}
