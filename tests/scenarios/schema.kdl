// A collection's frontmatter schema. Declaring a field requires it, and the
// build fails at the page rather than rendering a template's empty hole.

scenario "a satisfied schema builds" {
  files {
    "config.kdl" #"""
      site "Test"
      paths { content "content"; dist "public" }
      content {
        collections {
          blog {
            schema {
              title "str"
              hero "str" optional=#true
              tags "list"
            }
          }
        }
        taxonomies { tags }
      }
      """#
    "content/blog/post.typ" #"""
      #let frontmatter = (title: "P", tags: ("rust",),)
      body
      """#
  }
  expect {
    ok
    file "blog/post/index.html" { contains "body" }
  }
}

scenario "a required field the page never declared fails the build" {
  files {
    "config.kdl" #"""
      site "Test"
      paths { content "content"; dist "public" }
      content {
        collections {
          blog { schema { hero "str" } }
        }
      }
      """#
    "content/blog/post.typ" #"""
      #let frontmatter = (title: "P",)
      body
      """#
  }
  expect {
    fails { code "baudelaire::schema::missing" }
  }
}

scenario "a page declaring no frontmatter at all fails a schema that requires a field" {
  files {
    "config.kdl" #"""
      site "Test"
      paths { content "content"; dist "public" }
      content {
        collections {
          blog { schema { title } }
        }
      }
      """#
    "content/blog/post.typ" #"""
      body with no frontmatter
      """#
  }
  expect {
    fails { code "baudelaire::schema::missing" }
  }
}

scenario "a wrong-typed field fails the build" {
  files {
    "config.kdl" #"""
      site "Test"
      paths { content "content"; dist "public" }
      content {
        collections {
          blog { schema { hero "str" } }
        }
      }
      """#
    "content/blog/post.typ" #"""
      #let frontmatter = (title: "P", hero: 3,)
      body
      """#
  }
  expect {
    fails { code "baudelaire::schema::mismatch" }
  }
}

scenario "a list with a non-string element is not a list of strings" {
  files {
    "config.kdl" #"""
      site "Test"
      paths { content "content"; dist "public" }
      content {
        collections {
          blog { schema { authors "list" } }
        }
      }
      """#
    "content/blog/post.typ" #"""
      #let frontmatter = (title: "P", authors: ("a", 2),)
      body
      """#
  }
  expect {
    fails { code "baudelaire::schema::mismatch" }
  }
}

scenario "an optional field may be absent, and is still typed when present" {
  files {
    "config.kdl" #"""
      site "Test"
      paths { content "content"; dist "public" }
      content {
        collections {
          blog { schema { hero "str" optional=#true } }
        }
      }
      """#
    "content/blog/absent.typ" #"""
      #let frontmatter = (title: "A",)
      absent body
      """#
  }
  expect {
    ok
    file "blog/absent/index.html" { contains "absent body" }
  }
}

scenario "an optional field with the wrong type still fails" {
  files {
    "config.kdl" #"""
      site "Test"
      paths { content "content"; dist "public" }
      content {
        collections {
          blog { schema { hero "str" optional=#true } }
        }
      }
      """#
    "content/blog/post.typ" #"""
      #let frontmatter = (title: "P", hero: false,)
      body
      """#
  }
  expect {
    fails { code "baudelaire::schema::mismatch" }
  }
}

scenario "a bare field name requires presence and nothing else" {
  files {
    "config.kdl" #"""
      site "Test"
      paths { content "content"; dist "public" }
      content {
        collections {
          blog { schema { hero } }
        }
      }
      """#
    "content/blog/post.typ" #"""
      #let frontmatter = (title: "P", hero: 3,)
      body
      """#
  }
  expect {
    ok
    file "blog/post/index.html"
  }
}

scenario "a built-in date field is required by the schema and typed by the built-in" {
  files {
    "config.kdl" #"""
      site "Test"
      paths { content "content"; dist "public" }
      content {
        collections {
          blog { schema { date "date" } }
        }
      }
      """#
    "content/blog/post.typ" #"""
      #let frontmatter = (title: "P",)
      body
      """#
  }
  expect {
    fails { code "baudelaire::schema::missing" }
  }
}

scenario "a schema type contradicting a built-in key fails at the config line" {
  files {
    "config.kdl" #"""
      site "Test"
      paths { content "content"; dist "public" }
      content {
        collections {
          blog { schema { title "int" } }
        }
      }
      """#
    "content/blog/post.typ" #"""
      #let frontmatter = (title: "P",)
      body
      """#
  }
  expect {
    fails { code "baudelaire::config::field_conflict" }
  }
}

scenario "an unknown schema type is a config error with the valid ones listed" {
  files {
    "config.kdl" #"""
      site "Test"
      paths { content "content"; dist "public" }
      content {
        collections {
          blog { schema { hero "strr" } }
        }
      }
      """#
    "content/blog/post.typ" #"""
      #let frontmatter = (title: "P",)
      body
      """#
  }
  expect {
    fails { code "baudelaire::config::unknown_value" }
  }
}

scenario "a list names what it holds" {
  files {
    "config.kdl" #"""
      site "Test"
      paths { content "content"; dist "public" }
      content {
        collections {
          blog { schema { widths "list<int>" } }
        }
      }
      """#
    "content/blog/post.typ" #"""
      #let frontmatter = (title: "P", widths: (480, 960),)
      body
      """#
    "content/blog/wrong.typ" #"""
      #let frontmatter = (title: "W", widths: (480, "960"),)
      body
      """#
  }
  expect {
    fails { code "baudelaire::schema::mismatch" }
  }
}

scenario "a nested dict is checked field by field" {
  files {
    "config.kdl" #"""
      site "Test"
      paths { content "content"; dist "public" }
      content {
        collections {
          blog {
            schema {
              editor "dict" {
                name "str"
                email "str" optional=#true
              }
            }
          }
        }
      }
      """#
    "content/blog/post.typ" #"""
      #let frontmatter = (title: "P", editor: (name: "A"),)
      body
      """#
  }
  expect {
    ok
    file "blog/post/index.html" { contains "body" }
  }
}

scenario "a field the nested dict is missing fails the build" {
  files {
    "config.kdl" #"""
      site "Test"
      paths { content "content"; dist "public" }
      content {
        collections {
          blog {
            schema {
              editor "dict" { name "str" }
            }
          }
        }
      }
      """#
    "content/blog/post.typ" #"""
      #let frontmatter = (title: "P", editor: (email: "a@example.com"),)
      body
      """#
  }
  expect {
    fails { code "baudelaire::schema::missing" }
  }
}

scenario "a list of dicts holds every element to the same fields" {
  files {
    "config.kdl" #"""
      site "Test"
      paths { content "content"; dist "public" }
      content {
        collections {
          blog {
            schema {
              authors "list<dict>" { name "str" }
            }
          }
        }
      }
      """#
    "content/blog/post.typ" #"""
      #let frontmatter = (title: "P", authors: ((name: "A"), (name: 2)),)
      body
      """#
  }
  expect {
    fails { code "baudelaire::schema::mismatch" }
  }
}

scenario "a type expression that never closes fails at the config line" {
  files {
    "config.kdl" #"""
      site "Test"
      paths { content "content"; dist "public" }
      content {
        collections {
          blog { schema { widths "list<int" } }
        }
      }
      """#
    "content/blog/post.typ" #"""
      #let frontmatter = (title: "P",)
      body
      """#
  }
  expect {
    fails { code "baudelaire::config::type_expr" }
  }
}

scenario "a block on a type that holds no dictionary fails at the config line" {
  files {
    "config.kdl" #"""
      site "Test"
      paths { content "content"; dist "public" }
      content {
        collections {
          blog { schema { widths "list<int>" { name "str" } } }
        }
      }
      """#
    "content/blog/post.typ" #"""
      #let frontmatter = (title: "P",)
      body
      """#
  }
  expect {
    fails { code "baudelaire::config::field_not_dict" }
  }
}

scenario "a schema constrains only its own collection" {
  files {
    "config.kdl" #"""
      site "Test"
      paths { content "content"; dist "public" }
      content {
        collections {
          blog { schema { hero "str" } }
        }
      }
      """#
    "content/notes/note.typ" #"""
      #let frontmatter = (title: "N",)
      note body
      """#
  }
  expect {
    ok
    file "notes/note/index.html" { contains "note body" }
  }
}

// The five keys the build reads for meta, feeds and listings are declared, so a
// schema can require one and a wrong-typed value fails where it was written.
scenario "a schema requires a declared meta key" {
  files {
    "config.kdl" #"""
      site "Test"
      paths { content "content"; dist "public" }
      content {
        collections {
          blog { schema { description "str" } }
        }
      }
      """#
    "content/blog/post.typ" #"""
      #let frontmatter = (title: "P",)
      body
      """#
  }
  expect {
    fails { code "baudelaire::schema::missing" }
  }
}

// A key the collection declares is a key the site named, so it is never read as
// a near-miss of one baudelaire named.
scenario "a schema-declared key is not a typo of a built-in" {
  files {
    "config.kdl" #"""
      site "Test"
      paths { content "content"; dist "public" }
      content {
        collections {
          blog { schema { alte "str" } }
        }
      }
      """#
    "content/blog/post.typ" #"""
      #let frontmatter = (title: "P", alte: "x",)
      body
      """#
  }
  expect {
    ok
    file "blog/post/index.html" { contains "body" }
  }
}

// `date` is the one type with two spellings: the reader takes an ISO string as
// well as a typst datetime, and every markdown dialect hands one over as a
// string. The check accepted only the datetime, so a well-formed `.md` page
// failed a schema its own dialect could not satisfy.
scenario "a date field takes the iso string every dialect writes" {
  requires "markdown"
  files {
    "config.kdl" #"""
      site "Test"
      paths { content "content"; dist "public" }
      content {
        collections {
          blog { schema { date "date" } }
        }
      }
      """#
    "content/blog/typst.typ" #"""
      #let frontmatter = (title: "T", date: "2024-01-01",)
      body
      """#
    "content/blog/yaml.md" #"""
      ---
      title: Y
      date: 2024-01-02
      ---

      body
      """#
    "content/blog/native.typ" #"""
      #let frontmatter = (title: "N", date: datetime(year: 2024, month: 1, day: 3),)
      body
      """#
  }
  expect {
    ok
    file "blog/typst/index.html"
    file "blog/yaml/index.html"
    file "blog/native/index.html"
  }
}

// ..and a string that is not a date is still refused, so the type still means
// something.
scenario "a date field refuses a string that is not one" {
  files {
    "config.kdl" #"""
      site "Test"
      paths { content "content"; dist "public" }
      content {
        collections {
          blog { schema { date "date" } }
        }
      }
      """#
    "content/blog/post.typ" #"""
      #let frontmatter = (title: "P", date: "last tuesday",)
      body
      """#
  }
  expect {
    fails { code "baudelaire::schema::mismatch" }
  }
}

// A choice is part of the type language, so it composes: `list<one-of<..>>`
// holds a list of them. A value of the right type that the choice does not
// allow is refused as a value, not reported as the wrong kind of thing.
scenario "a choice allows what it names and nothing else" {
  files {
    "config.kdl" #"""
      site "Test"
      paths { content "content"; dist "public" }
      content {
        collections {
          blog {
            schema {
              status "one-of<draft|review|published>"
            }
          }
        }
      }
      """#
    "content/blog/post.typ" #"""
      #let frontmatter = (title: "P", status: "review",)
      body
      """#
  }
  expect {
    ok
    file "blog/post/index.html" { contains "body" }
  }
}

scenario "a value a choice does not name fails the build" {
  files {
    "config.kdl" #"""
      site "Test"
      paths { content "content"; dist "public" }
      content {
        collections {
          blog { schema { status "one-of<draft|published>" } }
        }
      }
      """#
    "content/blog/post.typ" #"""
      #let frontmatter = (title: "P", status: "reviewed",)
      body
      """#
  }
  expect {
    fails { code "baudelaire::schema::refused" }
  }
}

scenario "a bound holds a number to its value and a list to its size" {
  files {
    "config.kdl" #"""
      site "Test"
      paths { content "content"; dist "public" }
      content {
        collections {
          blog {
            schema {
              weight "int" min=1 max=10
              tags "list" max=2
              title "str" min=2
            }
          }
        }
        taxonomies { tags }
      }
      """#
    "content/blog/ok.typ" #"""
      #let frontmatter = (title: "Post", weight: 3, tags: ("a", "b"),)
      body
      """#
  }
  build { expect { ok; file "blog/ok/index.html" { contains "body" } } }
  build {
    files {
      "content/blog/ok.typ" #"""
        #let frontmatter = (title: "Post", weight: 30, tags: ("a",),)
        body
        """#
    }
    expect { fails { code "baudelaire::schema::refused" } }
  }
  build {
    files {
      "content/blog/ok.typ" #"""
        #let frontmatter = (title: "Post", weight: 3, tags: ("a", "b", "c"),)
        body
        """#
    }
    expect { fails { code "baudelaire::schema::refused" } }
  }
}

// A bound on a type with nothing to count is refused where it is written, not
// left to never fire at the page.
scenario "a bound on a type that cannot carry one is a config error" {
  files {
    "config.kdl" #"""
      site "Test"
      paths { content "content"; dist "public" }
      content {
        collections {
          blog { schema { draft "bool" min=1 } }
        }
      }
      """#
    "content/blog/post.typ" #"""
      #let frontmatter = (title: "P",)
      body
      """#
  }
  expect {
    fails { code "baudelaire::config::field_not_bounded" }
  }
}

scenario "a floor above its own ceiling is a config error" {
  files {
    "config.kdl" #"""
      site "Test"
      paths { content "content"; dist "public" }
      content {
        collections {
          blog { schema { weight "int" min=10 max=1 } }
        }
      }
      """#
    "content/blog/post.typ" #"""
      #let frontmatter = (title: "P",)
      body
      """#
  }
  expect {
    fails { code "baudelaire::config::field_bounds_cross" }
  }
}

// A default stands in for what the page did not write, and reaches the template
// as if it had. It also lets the field be absent, which is what a default is.
scenario "a default fills in a field the page left out" {
  files {
    "config.kdl" #"""
      site "Test"
      paths { content "content"; dist "public"; templates "templates" }
      content {
        collections {
          blog {
            schema {
              layout "one-of<wide|narrow>" default="narrow"
              weight "int" default=5
            }
          }
        }
      }
      """#
    "templates/page.typ" #"""
      #let page(page, body) = {
        let fm = page.frontmatter
        html.elem("main", fm.layout + "/" + str(fm.weight))
      }
      """#
    "content/blog/plain.typ" #"""
      #let frontmatter = (title: "P", template: "page.typ",)
      body
      """#
    "content/blog/wide.typ" #"""
      #let frontmatter = (title: "W", template: "page.typ", layout: "wide", weight: 1,)
      body
      """#
  }
  expect {
    ok
    file "blog/plain/index.html" { contains "narrow/5" }
    file "blog/wide/index.html" { contains "wide/1" }
  }
}

scenario "a default that the declared type would refuse is a config error" {
  files {
    "config.kdl" #"""
      site "Test"
      paths { content "content"; dist "public" }
      content {
        collections {
          blog { schema { layout "one-of<wide|narrow>" default="huge" } }
        }
      }
      """#
    "content/blog/post.typ" #"""
      #let frontmatter = (title: "P",)
      body
      """#
  }
  expect {
    fails { code "baudelaire::config::field_default" }
  }
}

// The bounds and the pattern are the field's too, and a default is a value the
// page could have written: one the field would refuse from a page has to be
// refused where it is declared, since no page's own check ever sees it.
scenario "a default that the declared bounds would refuse is a config error" {
  files {
    "config.kdl" #"""
      site "Test"
      paths { content "content"; dist "public" }
      content {
        collections {
          blog { schema { blurb "str" min=5 default="ab" } }
        }
      }
      """#
    "content/blog/post.typ" #"""
      #let frontmatter = (title: "P",)
      body
      """#
  }
  expect {
    fails { code "baudelaire::config::field_default" }
  }
}

scenario "a default that the declared pattern would refuse is a config error" {
  files {
    "config.kdl" #"""
      site "Test"
      paths { content "content"; dist "public" }
      content {
        collections {
          blog { schema { code "str" pattern="^[A-Z]{2}$" default="oops" } }
        }
      }
      """#
    "content/blog/post.typ" #"""
      #let frontmatter = (title: "P",)
      body
      """#
  }
  expect {
    fails { code "baudelaire::config::field_default" }
  }
}

// A pattern holds every string a value carries: the string itself, or each
// element of a list of them, so the fault names the element that broke.
scenario "a pattern holds a string and every element of a list of them" {
  files {
    "config.kdl" #"""
      site "Test"
      paths { content "content"; dist "public" }
      content {
        collections {
          blog {
            schema {
              code "str" pattern="^[A-Z]{2}-[0-9]+$"
              tags "list" pattern="^[a-z][a-z-]*$"
            }
          }
        }
        taxonomies { tags }
      }
      """#
    "content/blog/ok.typ" #"""
      #let frontmatter = (title: "P", code: "AB-12", tags: ("rust", "static-sites"),)
      body
      """#
  }
  build { expect { ok; file "blog/ok/index.html" { contains "body" } } }
  build {
    files {
      "content/blog/ok.typ" #"""
        #let frontmatter = (title: "P", code: "ab-12", tags: ("rust",),)
        body
        """#
    }
    expect { fails { code "baudelaire::schema::refused" } }
  }
  build {
    files {
      "content/blog/ok.typ" #"""
        #let frontmatter = (title: "P", code: "AB-12", tags: ("rust", "Static"),)
        body
        """#
    }
    expect { fails { code "baudelaire::schema::refused" } }
  }
}

// Unanchored, as a regular expression is: a pattern with no `^`/`$` matches
// anywhere in the value.
scenario "a pattern matches anywhere until it is anchored" {
  files {
    "config.kdl" #"""
      site "Test"
      paths { content "content"; dist "public" }
      content {
        collections {
          blog { schema { code "str" pattern="[0-9]+" } }
        }
      }
      """#
    "content/blog/post.typ" #"""
      #let frontmatter = (title: "P", code: "ab-12-cd",)
      body
      """#
  }
  expect {
    ok
    file "blog/post/index.html" { contains "body" }
  }
}

scenario "a pattern on a type that carries no string is a config error" {
  files {
    "config.kdl" #"""
      site "Test"
      paths { content "content"; dist "public" }
      content {
        collections {
          blog { schema { weight "int" pattern="^[0-9]+$" } }
        }
      }
      """#
    "content/blog/post.typ" #"""
      #let frontmatter = (title: "P",)
      body
      """#
  }
  expect {
    fails { code "baudelaire::config::field_not_matched" }
  }
}

scenario "a pattern that is not a regular expression is a config error" {
  files {
    "config.kdl" #"""
      site "Test"
      paths { content "content"; dist "public" }
      content {
        collections {
          blog { schema { code "str" pattern="[a-" } }
        }
      }
      """#
    "content/blog/post.typ" #"""
      #let frontmatter = (title: "P",)
      body
      """#
  }
  expect {
    fails { code "baudelaire::config::field_pattern" }
  }
}
