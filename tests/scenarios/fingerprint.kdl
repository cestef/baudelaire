// Content-hashed asset names, and the references rewritten to follow them.
//
// The whole point is a name the *build* chose, so every case here captures it
// off the file that references it and asserts against that binding, rather
// than hard-coding a hash that changes with the bytes.

defaults {
  files {
    "config.kdl" #"""
      site "T"
      paths { content "content"; dist "public"; assets "assets" }
      assets { fingerprint #true }
      """#
  }
}

scenario "a fingerprinted asset is renamed and its page reference rewritten" {
  requires "css"
  files {
    "assets/style.css" #"""
      body{color:red}
      """#
    "content/posts/a.typ" #"""
      #let frontmatter = (title: "A",)
      #html.elem("link", attrs: (rel: "stylesheet", href: "/assets/style.css"))
      """#
  }
  expect {
    ok
    file "posts/a/index.html" {
      capture "css" #"/assets/(style\.[0-9a-f]+\.css)"#
      // The original name must be gone from the markup, not merely joined by
      // the hashed one.
      missing "href=\"/assets/style.css\""
    }
    file "assets/{css}"
    absent "assets/style.css"
  }
}

scenario "a url() inside a stylesheet is fingerprinted too" {
  requires "css"
  files {
    "assets/style.css" #"""
      body{background:url(bg.png)}
      """#
    "assets/bg.png" png="8x8"
    "content/a.typ" #"""
      #let frontmatter = (title: "A",)
      body
      """#
  }
  expect {
    ok
    // Nothing on a page names the stylesheet, so the pattern is the entry
    // point: exactly one hashed `style.*.css`, and its `url()` names the
    // image's hashed name rather than the original.
    file "assets/style.*.css" {
      capture "bg" #"/assets/(bg\.[0-9a-f]+\.png)"#
      missing "(bg.png)"
    }
    file "assets/{bg}"
    absent "assets/bg.png"
  }
}

// A stylesheet importing another stylesheet is the case `url()` above does not
// cover: both files belong to the *same* handler, so the imported sheet's hashed
// name has to exist in the asset map by the time its importer renders. It did
// not, and every `@import` fell back to the name as written while the file it
// named had already been renamed out from under it -- a site-wide unstyled page
// out of a green build. `Stylesheet::order` sorts the dependency first; what was
// missing was the pipeline recording each file before rendering the next.
scenario "an @import between stylesheets is fingerprinted too" {
  requires "css"
  files {
    "assets/style.css" #"""
      @import "base.css";
      body{color:var(--fg)}
      """#
    "assets/base.css" #"""
      :root{--fg:red}
      """#
    "content/a.typ" #"""
      #let frontmatter = (title: "A",)
      body
      """#
  }
  expect {
    ok
    file "assets/style.*.css" {
      capture "base" #"/assets/(base\.[0-9a-f]+\.css)"#
      // The name as authored must be gone, not merely accompanied.
      missing "\"base.css\""
    }
    file "assets/{base}"
    absent "assets/base.css"
  }
}

// The chain is followed however deep it goes: the middle sheet has to be
// rewritten *and* hashed before the sheet importing it renders, so a two-step
// chain is what distinguishes recording each file from recording them in one
// pass at the end.
scenario "a chain of @imports resolves all the way down" {
  requires "css"
  files {
    "assets/style.css" #"""
      @import "mid.css";
      """#
    "assets/mid.css" #"""
      @import "leaf.css";
      """#
    "assets/leaf.css" #"""
      :root{--fg:red}
      """#
    "content/a.typ" #"""
      #let frontmatter = (title: "A",)
      body
      """#
  }
  expect {
    ok
    file "assets/style.*.css" {
      capture "mid" #"/assets/(mid\.[0-9a-f]+\.css)"#
    }
    file "assets/{mid}" {
      capture "leaf" #"/assets/(leaf\.[0-9a-f]+\.css)"#
    }
    file "assets/{leaf}"
    absent "assets/mid.css"
    absent "assets/leaf.css"
  }
}

// `page.assets` names a file sitting beside a page bundle, and that file is
// published under the digest `#image()` gave it: the dict spelled the authored
// name, so every template-written link 404'd under fingerprinting.
scenario "a page's own asset url carries the digest its file was written under" {
  requires "images"
  files {
    "content/posts/hello/index.typ" #"""
      #let frontmatter = (title: "Hello", template: "post.typ",)
      #image("cover.png")
      """#
    "content/posts/hello/cover.png" png="8x8"
    "templates/post.typ" #"""
      #import "@baudelaire/html:0.1.0": h
      #let post(page, body) = h("main", h("img", src: page.assets.at("cover.png")), body)
      """#
  }
  expect {
    ok
    file "posts/hello/index.html" {
      capture "cover" #"src=\"/assets/posts/hello/(cover\.[0-9a-f]+\.png)\""#
      missing "src=\"/assets/posts/hello/cover.png\""
    }
    file "assets/posts/hello/{cover}"
  }
}
