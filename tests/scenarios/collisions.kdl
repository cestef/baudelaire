// Two outputs cannot share a URL, and a slug has to survive being one.

scenario "two pages resolving to one url are rejected" {
  files {
    "config.kdl" #"""
      site "T"
      paths {
        content "content"
        dist "public"
      }
      """#
    "content/posts/a.typ" #"""
      #let frontmatter = (title: "A", slug: "same",)
      a
      """#
    "content/posts/b.typ" #"""
      #let frontmatter = (title: "B", slug: "same",)
      b
      """#
  }
  expect {
    fails { code "baudelaire::content::collision" }
  }
}

scenario "a slug with no url-safe characters is rejected" {
  files {
    "config.kdl" #"""
      site "T"
      paths {
        content "content"
        dist "public"
      }
      """#
    "content/posts/p.typ" #"""
      #let frontmatter = (title: "P", slug: "🎉",)
      p
      """#
  }
  expect {
    fails { code "baudelaire::content::empty_slug" }
  }
}

// A `path` or a `redirect` names the file a page writes, so a `..` in one is a
// write outside `dist` rather than a URL.
scenario "a frontmatter path climbing out of dist is rejected" {
  files {
    "config.kdl" #"""
      site "T"
      paths {
        content "content"
        dist "public"
      }
      """#
    "content/posts/p.typ" #"""
      #let frontmatter = (title: "P", path: "/../../escaped.html",)
      p
      """#
  }
  expect {
    fails { code "baudelaire::content::frontmatter_traversal" }
  }
}

scenario "a frontmatter redirect climbing out of dist is rejected" {
  files {
    "config.kdl" #"""
      site "T"
      paths {
        content "content"
        dist "public"
      }
      """#
    "content/posts/p.typ" #"""
      #let frontmatter = (title: "P", redirect: ("/../escaped.html",),)
      p
      """#
  }
  expect {
    fails { code "baudelaire::content::frontmatter_traversal" }
  }
}

// A page whose `path` names a file a processor writes used to be produced and
// then silently replaced by that processor, which runs after the pages.
scenario "a page claiming a generated file is rejected" {
  files {
    "config.kdl" #"""
      site "T"
      url "https://example.com"
      paths {
        content "content"
        dist "public"
      }
      generate {
        sitemap #true
      }
      """#
    "content/index.typ" #"""
      #let frontmatter = (title: "Home",)
      home
      """#
    "content/map.typ" #"""
      #let frontmatter = (title: "Map", path: "/sitemap.xml",)
      mine
      """#
  }
  expect {
    fails { code "baudelaire::content::collision" }
  }
}

// ...and the same file is fine once nothing generates it.
scenario "a page may claim a generated name the site does not generate" {
  files {
    "config.kdl" #"""
      site "T"
      url "https://example.com"
      paths {
        content "content"
        dist "public"
      }
      generate {
        sitemap #false
      }
      """#
    "content/index.typ" #"""
      #let frontmatter = (title: "Home",)
      home
      """#
    "content/map.typ" #"""
      #let frontmatter = (title: "Map", path: "/sitemap.xml",)
      mine
      """#
  }
  expect {
    ok
    file "sitemap.xml" { contains "mine" }
  }
}
