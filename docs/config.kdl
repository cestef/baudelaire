site "Baudelaire"
url "https://baudelaire.cstef.dev"
author "cstef"
lang "en"

// Where things live on disk. `assets` here is the source directory; the
// top-level `assets` block below is the pipeline that processes it.
paths {
  content "content"
  dist "public"
  assets "assets"
  templates "templates"
  static "static"
}

// What is a page and how pages group. Collections and taxonomies read from
// `paths { content }`, so they belong next to it.
content {
  collections {
    guide { sort "order"; template "page.typ" }
    features { sort "order"; template "page.typ"; paginate { template "list.typ" } }
    blog { sort "date"; reverse #true; template "page.typ"; paginate { size 5; template "list.typ" } }
  }

  taxonomies {
    tags listing=#true template="list.typ"
  }
}

html {
  pretty #true

  // Names each sentinel colour in `highlight/baudelaire.tmTheme`, so the
  // markup carries `class="sx-keyword"` and the palette lives in style.css,
  // where a light/dark toggle can reach it.
  highlight {
    comment "#e5d001"
    string  "#e5d002"
    number  "#e5d003"
    keyword "#e5d004"
    node    "#e5d005"
    prop    "#e5d006"
    type    "#e5d007"
    punct   "#e5d008"
  }
}

// Permalink shape and link checking are one subject. `style "clean"` gives
// directory-per-page URLs (`/guide/` not `/guide.html`); use "flat" for `.html`
// files instead.
links {
  style "clean"
}

// Asset pipeline: minify CSS (lightningcss), bundle + minify JS (rolldown), and
// content-hash filenames for far-future caching.
assets {
  minify #true
  bundle #true
  fingerprint #true
}

// Files the build emits beside the pages themselves.
generate {
  sitemap #true

  // Client-side search: a flat document index. The palette UI is the generated
  // client, imported into assets/main.js as the `baudelaire:search` virtual
  // module and bundled by rolldown. The `body` field powers result snippets.
  search {
    formats "json"
    fields "title" "body" "tags"
  }

  robots {
    disallow "/drafts/"
  }

  llms {
    summary "Baudelaire is a Typst-native static site generator: write pages in Typst, get incremental builds, clean URLs, taxonomies, pagination, feeds, search, and an asset pipeline."
  }

  feed {
    formats "rss" "atom"
    limit 20
  }
}

// Sweep orphaned outputs (a deleted page, a renamed permalink, a dropped
// taxonomy term) out of the output directory on every build.
prune #true

// The icons `theme.typ` inlines with `svg()` live outside `assets/`, so they are
// never published as standalone files. The dev server watches content,
// templates, assets and static; anything else a build reads has to say so here
// or an edit to it will not reload.
serve {
  include "icons/**/*.svg"
}

// Build-time constants handed to client JavaScript through the
// `baudelaire:config` virtual module. The config page renders this very block
// live from that module, dogfooding the define-style injection.
client {
  repo "https://codeberg.org/cstef/baudelaire"
  edits #true
}

// `baudelaire build --profile dev` skips the asset pipeline (faster rebuilds)
// and includes draft pages.
profiles {
  dev {
    content {
      draft {
        build #true
      }
    }
    assets {
      minify #false
      bundle #false
      fingerprint #false
    }
  }
}
