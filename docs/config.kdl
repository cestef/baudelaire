site "Baudelaire"
url "https://baudelaire.cstef.dev"
author "cstef"
lang "en"

paths {
  content "content"
  dist "public"
  assets "assets"
  templates "templates"
  static "static"
}

// The icons `theme.typ` inlines with `svg()` live outside `assets/`, so they are
// never published as standalone files. The dev server watches content,
// templates, assets and static; anything else a build reads has to say so here
// or an edit to it will not reload.
serve {
  include "icons/**/*.svg"
}

// Build-time constants handed to client JavaScript through the
// `baudelaire:config` virtual module. The config page renders this very block
// live from that module, dogfooding the define-style injection.
client {
  repo "https://codeberg.org/cstef/baudelaire"
  edits #true
}

collections {
  guide sort="order" template="page.typ"
  features sort="order" template="page.typ" list="list.typ"
  blog sort="date" reverse=#true template="page.typ" paginate=5 list="list.typ"
}

taxonomies {
  tags index=#true template="list.typ"
}

output {
  // Directory-per-page permalinks (`/guide/` not `/guide.html`). Use "flat"
  // for `.html` files instead.
  urls "clean"

  // Sweep orphaned files (a deleted page, a renamed permalink, a dropped
  // taxonomy term) out of the output directory on every build.
  clean #true

  html {
    pretty #true
  }

  // Asset pipeline: minify CSS (lightningcss), bundle + minify JS (rolldown),
  // and content-hash filenames for far-future caching.
  assets {
    minify #true
    bundle #true
    fingerprint #true
  }

  // Client-side search: a flat document index. The palette UI is the generated
  // client, imported into assets/main.js as the `baudelaire:search` virtual
  // module and bundled by rolldown. The `body` field powers result snippets.
  search {
    formats "json"
    fields "title" "body" "tags"
  }

  sitemap #true

  robots {
    disallow "/drafts/"
  }

  llms {
    summary "Baudelaire is a Typst-native static site generator: write pages in Typst, get incremental builds, clean URLs, taxonomies, pagination, feeds, search, and an asset pipeline."
  }

  feed {
    formats "rss" "atom"
    limit 20
  }
}

// `baudelaire build --profile dev` skips the asset pipeline (faster rebuilds)
// and includes draft pages.
profiles {
  dev {
    draft {
      build #true
    }
    output {
      assets {
        minify #false
        bundle #false
        fingerprint #false
      }
    }
  }
}
